@page "/employee/add"
@page "/employee/edit/{Id:int}"
@using System.ComponentModel.DataAnnotations
@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Web.Services
@inject SearchService service
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<EmployeeDetail> logger

@attribute [Authorize(Roles = "Personnel View, Personnel Edit, Inventory, Range Statistics, Range Scores, Training, Documents, SSN")]

<PageTitle>@(IsEdit ? (canEditAny ? "Edit Employee" : "View Employee") : "Add New Employee")</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">
        @if (IsEdit)
        {
            @if (canEditAny)
            {
                @(!string.IsNullOrWhiteSpace(employee.FirstName) || !string.IsNullOrWhiteSpace(employee.LastName) ? $"Edit Employee: {employee.FirstName} {employee.LastName}".Trim() : "Edit Employee")
            }
            else
            {
                @(!string.IsNullOrWhiteSpace(employee.FirstName) || !string.IsNullOrWhiteSpace(employee.LastName) ? $"View Employee: {employee.FirstName} {employee.LastName}".Trim() : "View Employee")
            }
        }
        else
        {
            @("Add New Employee")
        }
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Cancel" Disabled="@isSaving">
        Back to List
    </MudButton>
</MudStack>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close" CloseIconClicked="() => errorMessage = null">
        @errorMessage
    </MudAlert>
}

@if (isLoading)
{
    <MudPaper Class="pa-6 d-flex justify-center align-center" Style="min-height: 200px;">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Class="ml-4">Loading employee data...</MudText>
    </MudPaper>
}
else
{
<style>
    .folder-styled-tabs .mud-tabs-tabbar {
        background-color: var(--mud-palette-background-gray) !important;
        border-bottom: 2px solid var(--mud-palette-primary) !important;
        padding: 6px 8px 0 8px !important;
        gap: 6px !important;
    }
    .folder-styled-tabs .mud-tab {
        border: 1px solid #cbd5e1 !important;
        border-bottom: none !important;
        border-top-left-radius: 8px !important;
        border-top-right-radius: 8px !important;
        background-color: #f1f5f9 !important;
        color: #334155 !important;
        font-weight: 600 !important;
        padding: 10px 22px !important;
        margin-right: 4px !important;
        transition: all 0.2s ease-in-out !important;
        min-width: 0 !important;
    }
    .folder-styled-tabs .mud-tab .mud-icon-root {
        color: #64748b !important;
        margin-right: 6px !important;
        transition: margin 0.2s ease-in-out !important;
    }
    .folder-styled-tabs .mud-tab:hover:not(.mud-tab-active) {
        background-color: #e2e8f0 !important;
        color: var(--mud-palette-primary) !important;
    }
    .folder-styled-tabs .mud-tab:hover:not(.mud-tab-active) .mud-icon-root {
        color: var(--mud-palette-primary) !important;
    }
    .folder-styled-tabs .mud-tab.mud-tab-active {
        background-color: var(--mud-palette-primary) !important;
        color: #ffffff !important;
        border: 2px solid var(--mud-palette-primary) !important;
        border-bottom: 2px solid var(--mud-palette-primary) !important;
        margin-bottom: -2px !important;
        box-shadow: 0 -2px 6px rgba(0,0,0,0.12) !important;
        font-weight: 700 !important;
    }
    .folder-styled-tabs .mud-tab.mud-tab-active .mud-icon-root {
        color: #ffffff !important;
    }
    .folder-styled-tabs .mud-tabs-panels {
        border: 2px solid var(--mud-palette-primary) !important;
        border-top: none !important;
        border-bottom-left-radius: 8px !important;
        border-bottom-right-radius: 8px !important;
        background-color: var(--mud-palette-surface) !important;
        padding: 8px !important;
    }

    /* Left-hand menu displayed (drawer open): collapse inactive tab words to show icons only */
    .drawer-open .folder-styled-tabs .mud-tab:not(.mud-tab-active),
    #nav-drawer.mud-drawer--open ~ #main-content .folder-styled-tabs .mud-tab:not(.mud-tab-active) {
        font-size: 0 !important;
        min-width: 0 !important;
        padding: 10px 14px !important;
    }
    .drawer-open .folder-styled-tabs .mud-tab:not(.mud-tab-active) .mud-icon-root,
    #nav-drawer.mud-drawer--open ~ #main-content .folder-styled-tabs .mud-tab:not(.mud-tab-active) .mud-icon-root {
        font-size: 1.25rem !important;
        margin-right: 0 !important;
    }

    /* Left-hand menu displayed: show inactive tab words when user hovers over the tab icon */
    .drawer-open .folder-styled-tabs .mud-tab:not(.mud-tab-active):hover,
    #nav-drawer.mud-drawer--open ~ #main-content .folder-styled-tabs .mud-tab:not(.mud-tab-active):hover {
        font-size: 0.875rem !important;
        padding: 10px 22px !important;
    }
    .drawer-open .folder-styled-tabs .mud-tab:not(.mud-tab-active):hover .mud-icon-root,
    #nav-drawer.mud-drawer--open ~ #main-content .folder-styled-tabs .mud-tab:not(.mud-tab-active):hover .mud-icon-root {
        margin-right: 6px !important;
    }

    /* Left-hand menu displayed: active tab always shows both icon and words */
    .drawer-open .folder-styled-tabs .mud-tab.mud-tab-active,
    #nav-drawer.mud-drawer--open ~ #main-content .folder-styled-tabs .mud-tab.mud-tab-active {
        font-size: 0.875rem !important;
        padding: 10px 22px !important;
    }
    .drawer-open .folder-styled-tabs .mud-tab.mud-tab-active .mud-icon-root,
    #nav-drawer.mud-drawer--open ~ #main-content .folder-styled-tabs .mud-tab.mud-tab-active .mud-icon-root {
        margin-right: 6px !important;
    }
</style>

    <EditForm Model="@employee" OnValidSubmit="HandleSave">
        <DataAnnotationsValidator />

        <MudTabs ActivePanelIndex="@activeTabIndex" ActivePanelIndexChanged="OnTabChangedAsync" Elevation="0" ApplyEffectsToContainer="true" MinimumTabWidth="0" Class="folder-styled-tabs mb-4">
            @if (canAccessDetails)
            {
                <MudTabPanel Text="Employee Details" Icon="@Icons.Material.Filled.Person">
                <MudStack Spacing="4" Class="mt-4">
                    <!-- Personal Information -->
                    <MudPaper Class="pa-6" Elevation="3">
                        <MudGrid>
                            <MudItem xs="12" sm="8" md="9">
                                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">Personal Information</MudText>
                                <MudGrid>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="employee.FirstName" For="@(() => employee.FirstName)" Label="First Name" Variant="Variant.Outlined" Required="true" RequiredError="First Name is required" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="employee.MiddleInitial" For="@(() => employee.MiddleInitial)" Label="Middle Initial" Variant="Variant.Outlined" MaxLength="10" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="employee.LastName" For="@(() => employee.LastName)" Label="Last Name" Variant="Variant.Outlined" Required="true" RequiredError="Last Name is required" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                                    </MudItem>
                                    <AuthorizeView Roles="SSN" Context="authContext">
                                        <Authorized>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="employee.SSN" For="@(() => employee.SSN)" Label="SSN" Variant="Variant.Outlined" Placeholder="XXX-XX-XXXX" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                                            </MudItem>
                                        </Authorized>
                                    </AuthorizeView>
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker @bind-Date="employee.DOB" For="@(() => employee.DOB)" Label="Date of Birth" Variant="Variant.Outlined" Clearable="canEditEmployee" Editable="canEditEmployee" DateFormat="MM/dd/yyyy" Disabled="!canEditEmployee" ReadOnly="!canEditEmployee" ErrorText="Invalid date format" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" sm="4" md="3" Class="d-flex justify-center align-start">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    @if (employee.EmployeeImage != null && employee.EmployeeImage.Length > 0)
                                    {
                                        <img src="data:image/png;base64,@Convert.ToBase64String(employee.EmployeeImage)" alt="Employee Image" style="max-height: 200px; max-width: 200px; object-fit: contain; border-radius: 8px; border: 1px solid #ccc;" />
                                    }
                                    else
                                    {
                                        <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center border-dashed border-2 pa-4" Style="width: 200px; height: 200px; border-color: var(--mud-palette-lines-default); border-radius: 8px; background-color: var(--mud-palette-background-gray);">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Default" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">No image uploaded</MudText>
                                        </MudPaper>
                                    }
                                    @if (canEditEmployee)
                                    {
                                        <MudStack Spacing="1" Justify="Justify.Center">
                                            <InputFile id="employeeImageInput" OnChange="HandleImageUpload" accept="image/*" style="display:none;" />
                                             <MudTooltip Text="Upload Photo">
                                                <MudIconButton HtmlTag="label" for="employeeImageInput" Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium" aria-label="Upload photo" />
                                            </MudTooltip>
                                            @if (employee.EmployeeImage != null && employee.EmployeeImage.Length > 0)
                                            {
                                                <MudTooltip Text="Remove Image">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Medium" OnClick="RemoveImage" aria-label="Remove photo" />
                                                </MudTooltip>
                                            }
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- Employment Details -->
                    <MudPaper Class="pa-6" Elevation="3">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">Employment Details</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="6" md="4">
                                <MudTextField @bind-Value="employee.BadgeNumber" For="@(() => employee.BadgeNumber)" Label="Badge Number" Variant="Variant.Outlined" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudTextField @bind-Value="employee.PTBNumber" For="@(() => employee.PTBNumber)" Label="PTB Number" Variant="Variant.Outlined" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudTextField @bind-Value="employee.CountyEmpNo" For="@(() => employee.CountyEmpNo)" Label="County Emp No" Variant="Variant.Outlined" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudSelect T="int?" @bind-Value="employee.StatusID" For="@(() => employee.StatusID)" Label="Status" Variant="Variant.Outlined" Clearable="canEditEmployee" Disabled="!canEditEmployee" ReadOnly="!canEditEmployee">
                                    <MudSelectItem T="int?" Value="@((int?)null)">-- Select Status --</MudSelectItem>
                                    @if (availableStatuses != null)
                                    {
                                        @foreach (var status in GetFilteredStatuses())
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)status.StatusID)">
                                                @(status.StatusDescription ?? status.StatusCode)
                                            </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudDatePicker @bind-Date="employee.HireDate" For="@(() => employee.HireDate)" Label="Hire Date" Variant="Variant.Outlined" Clearable="canEditEmployee" Editable="canEditEmployee" DateFormat="MM/dd/yyyy" Disabled="!canEditEmployee" ReadOnly="!canEditEmployee" ErrorText="Invalid date format" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudDatePicker @bind-Date="employee.InactiveDate" For="@(() => employee.InactiveDate)" Label="Inactive Date" Variant="Variant.Outlined" Clearable="canEditEmployee" Editable="canEditEmployee" DateFormat="MM/dd/yyyy" Disabled="!canEditEmployee" ReadOnly="!canEditEmployee" ErrorText="Invalid date format" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudCheckBox T="bool" @bind-Value="employee.EmployeeFlag" Label="Sheriff Employee Flag" Color="Color.Primary" Disabled="!canEditEmployee" ReadOnly="!canEditEmployee" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- Contact Information -->
                    <MudPaper Class="pa-6" Elevation="3">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">Contact Information</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="employee.WorkEmail" For="@(() => employee.WorkEmail)" Label="Work Email" Variant="Variant.Outlined" InputType="InputType.Email" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="employee.WorkPhone" For="@(() => employee.WorkPhone)" Label="Work Phone" Variant="Variant.Outlined" InputType="InputType.Telephone" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="employee.HomePhone" For="@(() => employee.HomePhone)" Label="Home Phone" Variant="Variant.Outlined" InputType="InputType.Telephone" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- Home Address -->
                    <MudPaper Class="pa-6" Elevation="3">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">Home Address</MudText>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="employee.HomeAddressLine1" For="@(() => employee.HomeAddressLine1)" Label="Address Line 1" Variant="Variant.Outlined" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                            <MudItem xs="12" sm="5">
                                <MudTextField @bind-Value="employee.HomeCity" For="@(() => employee.HomeCity)" Label="City" Variant="Variant.Outlined" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                            <MudItem xs="12" sm="3">
                                <MudTextField @bind-Value="employee.HomeState" For="@(() => employee.HomeState)" Label="State" Variant="Variant.Outlined" MaxLength="2" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="employee.HomeZipCode" For="@(() => employee.HomeZipCode)" Label="Zip Code" Variant="Variant.Outlined" MaxLength="10" ReadOnly="!canEditEmployee" Disabled="!canEditEmployee" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudStack>
            </MudTabPanel>
            }

            @if (IsEdit)
            {
                @if (canAccessHistory)
                {
                    <MudTabPanel Text="Employee History" Icon="@Icons.Material.Filled.History">
                        @if (visitedTabKeys.Contains(TabKey.History))
                        {
                            <EmployeeHistoryTab EmployeeId="@(Id ?? 0)" IsEdit="@IsEdit" CanEdit="@canEditHistory" AvailablePrograms="@availablePrograms" AvailableRanks="@availableRanks" AvailableUnits="@availableUnits" />
                        }
                    </MudTabPanel>
                }

                @if (canAccessEquipment)
                {
                    <MudTabPanel Text="Equipment" Icon="@Icons.Material.Filled.Inventory">
                        @if (visitedTabKeys.Contains(TabKey.Equipment))
                        {
                            <EmployeeInventoryTab EmployeeId="@(Id ?? 0)" IsEdit="@IsEdit" CanEdit="@canEditEquipment" AvailableInventoryItems="@availableInventoryItems" />
                        }
                    </MudTabPanel>
                }

                @if (canAccessFirearms)
                {
                    <MudTabPanel Text="Firearms" Icon="@Icons.Material.Filled.Security">
                        @if (visitedTabKeys.Contains(TabKey.Firearms))
                        {
                            <EmployeeFirearmsTab EmployeeId="@(Id ?? 0)" IsEdit="@IsEdit" CanEdit="@canEditFirearms" AvailableMakes="@availableMakes" AvailableStatuses="@availableStatuses" />
                        }
                    </MudTabPanel>
                }

                @if (canAccessRangeStats)
                {
                    <MudTabPanel Text="Range Statistics" Icon="@Icons.Material.Filled.SportsScore">
                        @if (visitedTabKeys.Contains(TabKey.RangeStats))
                        {
                            <EmployeeRangeStatisticsTab EmployeeId="@(Id ?? 0)" IsEdit="@IsEdit" CanEdit="@canEditRangeStats" AvailableCourses="@availableRangeCourses" AvailableEvents="@availableRangeEvents" />
                        }
                    </MudTabPanel>
                }

                @if (canAccessTrainings)
                {
                    <MudTabPanel Text="Trainings" Icon="@Icons.Material.Filled.School">
                        @if (visitedTabKeys.Contains(TabKey.Trainings))
                        {
                            <EmployeeTrainingsTab EmployeeId="@(Id ?? 0)" IsEdit="@IsEdit" CanEdit="@canEditTrainings" AvailableTrainingSessions="@availableTrainingSessions" />
                        }
                    </MudTabPanel>
                }

                @if (canAccessDocuments)
                {
                    <MudTabPanel Text="Documents" Icon="@Icons.Material.Filled.InsertDriveFile">
                        @if (visitedTabKeys.Contains(TabKey.Documents))
                        {
                            <EmployeeDocumentsTab EmployeeId="@(Id ?? 0)" IsEdit="@IsEdit" CanEdit="@canEditDocuments" EmployeeName="@($"{employee.FirstName}_{employee.LastName}".Trim('_'))" />
                        }
                    </MudTabPanel>
                }
            }

        </MudTabs>

        <!-- Form Actions -->
        <MudPaper Class="pa-4 d-flex justify-end gap-3" Elevation="3">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel" Disabled="@isSaving">
                @(canEditDetails && CurrentActiveTab == TabKey.Details ? "Cancel" : "Back to Search")
            </MudButton>
            @if (canEditDetails && CurrentActiveTab == TabKey.Details)
            {
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@isSaving">
                    @if (isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Employee</span>
                    }
                </MudButton>
            }
        </MudPaper>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private enum TabKey
    {
        Details,
        History,
        Equipment,
        Firearms,
        RangeStats,
        Trainings,
        Documents
    }

    private int activeTabIndex = 0;
    private readonly List<TabKey> visibleTabs = new();
    private readonly HashSet<TabKey> visitedTabKeys = new();
    private TabKey? CurrentActiveTab => visibleTabs.ElementAtOrDefault(activeTabIndex);

    private bool canAccessDetails = false;
    private bool canAccessHistory = false;
    private bool canAccessEquipment = false;
    private bool canAccessFirearms = false;
    private bool canAccessRangeStats = false;
    private bool canAccessTrainings = false;
    private bool canAccessDocuments = false;

    private bool canEditDetails = false;
    private bool canEditHistory = false;
    private bool canEditEquipment = false;
    private bool canEditFirearms = false;
    private bool canEditRangeStats = false;
    private bool canEditTrainings = false;
    private bool canEditDocuments = false;

    private bool canEditEmployee => canEditDetails;
    private bool canEditAny => canEditDetails || canEditHistory || canEditEquipment || canEditFirearms || canEditRangeStats || canEditTrainings || canEditDocuments;

    private bool IsEdit => Id.HasValue && Id.Value > 0;
    private EmployeeDetailDto employee = new();
    private IEnumerable<StatusesDto>? availableStatuses;
    private IEnumerable<ProgramsDto>? availablePrograms;
    private IEnumerable<RanksDto>? availableRanks;
    private IEnumerable<UnitsDto>? availableUnits;

    private IEnumerable<StatusesDto> GetFilteredStatuses()
    {
        return availableStatuses ?? Enumerable.Empty<StatusesDto>();
    }
    private IEnumerable<InventoryItemsDto>? availableInventoryItems;
    private IEnumerable<MakesDto>? availableMakes;
    private IEnumerable<RangeCourseDTO>? availableRangeCourses;
    private IEnumerable<RangeEventDTO>? availableRangeEvents;
    private IEnumerable<TrainingSessionsDto>? availableTrainingSessions;

    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (authenticationStateTask != null)
        {
            var authState = await authenticationStateTask;
            UpdatePermissions(authState?.User);
        }

        if (Id.HasValue && employee.EmployeeID != Id.Value)
        {
            activeTabIndex = 0;
            visitedTabKeys.Clear();
            if (visibleTabs.Count > 0)
            {
                var firstTab = visibleTabs[0];
                visitedTabKeys.Add(firstTab);
                await LoadTabLookupsAsync(firstTab);
            }
            await LoadDataAsync();
        }
    }

    private void UpdatePermissions(System.Security.Claims.ClaimsPrincipal? user)
    {
        if (user == null) return;

        bool isPersonnelEdit = user.IsInRole("Personnel Edit") || user.IsInRole("Employee Edit");
        bool isPersonnelView = user.IsInRole("Personnel View") || user.IsInRole("Employee View");
        bool isInventory = user.IsInRole("Inventory");
        bool isRangeStats = user.IsInRole("Range Statistics");
        bool isTraining = user.IsInRole("Training");
        bool isDocuments = user.IsInRole("Documents");

        canAccessDetails = isPersonnelEdit || isPersonnelView;
        canEditDetails = isPersonnelEdit;

        canAccessHistory = isPersonnelEdit;
        canEditHistory = isPersonnelEdit;

        canAccessEquipment = isInventory;
        canEditEquipment = isInventory;

        canAccessFirearms = isRangeStats;
        canEditFirearms = isRangeStats;

        canAccessRangeStats = isRangeStats;
        canEditRangeStats = isRangeStats;

        canAccessTrainings = isTraining;
        canEditTrainings = isTraining;

        canAccessDocuments = isDocuments;
        canEditDocuments = isDocuments;

        visibleTabs.Clear();
        if (canAccessDetails)
        {
            visibleTabs.Add(TabKey.Details);
        }
        if (IsEdit)
        {
            if (canAccessHistory) visibleTabs.Add(TabKey.History);
            if (canAccessEquipment) visibleTabs.Add(TabKey.Equipment);
            if (canAccessFirearms) visibleTabs.Add(TabKey.Firearms);
            if (canAccessRangeStats) visibleTabs.Add(TabKey.RangeStats);
            if (canAccessTrainings) visibleTabs.Add(TabKey.Trainings);
            if (canAccessDocuments) visibleTabs.Add(TabKey.Documents);
        }
    }

    private async Task OnTabChangedAsync(int newIndex)
    {
        activeTabIndex = newIndex;
        if (newIndex >= 0 && newIndex < visibleTabs.Count)
        {
            var tabKey = visibleTabs[newIndex];
            visitedTabKeys.Add(tabKey);
            await LoadTabLookupsAsync(tabKey);
        }
    }

    private async Task LoadTabLookupsAsync(TabKey tabKey)
    {
        try
        {
            switch (tabKey)
            {
                case TabKey.Details:
                    if (availableStatuses == null)
                    {
                        availableStatuses = await service.GetAvailableStatusesAsync();
                    }
                    break;
                case TabKey.History:
                    if (availablePrograms == null || availableRanks == null || availableUnits == null)
                    {
                        var programsTask = availablePrograms == null ? service.GetProgramsAsync() : Task.FromResult(availablePrograms);
                        var ranksTask = availableRanks == null ? service.GetRanksAsync() : Task.FromResult(availableRanks);
                        var unitsTask = availableUnits == null ? service.GetUnitsAsync() : Task.FromResult(availableUnits);
                        await Task.WhenAll(programsTask, ranksTask, unitsTask);
                        availablePrograms = await programsTask;
                        availableRanks = await ranksTask;
                        availableUnits = await unitsTask;
                    }
                    break;
                case TabKey.Equipment:
                    if (availableInventoryItems == null)
                    {
                        availableInventoryItems = await service.GetInventoryItemsAsync(onlyActive: true);
                    }
                    break;
                case TabKey.Firearms:
                    var makesTask = availableMakes == null ? service.GetMakesAsync() : Task.FromResult(availableMakes);
                    var statusesTask = availableStatuses == null ? service.GetAvailableStatusesAsync() : Task.FromResult(availableStatuses);
                    await Task.WhenAll(makesTask, statusesTask);
                    availableMakes = await makesTask;
                    availableStatuses = await statusesTask;
                    break;
                case TabKey.RangeStats:
                    if (availableRangeCourses == null || availableRangeEvents == null)
                    {
                        var coursesTask = availableRangeCourses == null ? service.GetRangeCoursesAsync() : Task.FromResult(availableRangeCourses);
                        var eventsTask = availableRangeEvents == null ? service.GetRangeEventsAsync() : Task.FromResult(availableRangeEvents);
                        await Task.WhenAll(coursesTask, eventsTask);
                        availableRangeCourses = await coursesTask;
                        availableRangeEvents = await eventsTask;
                    }
                    break;
                case TabKey.Trainings:
                    if (availableTrainingSessions == null)
                    {
                        availableTrainingSessions = await service.GetTrainingSessionsAsync();
                    }
                    break;
                case TabKey.Documents:
                    break;
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading lookup data for tab {TabKey}.", tabKey);
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (authenticationStateTask != null)
            {
                var authState = await authenticationStateTask;
                var user = authState?.User;
                UpdatePermissions(user);

                logger.LogInformation("EmployeeDetail loaded for User '{UserName}'. canEditEmployee = {CanEdit}",
                    user?.Identity?.Name ?? "Unknown User",
                    canEditEmployee);
            }

            if (!IsEdit && !canEditEmployee)
            {
                Snackbar.Add("You do not have permission to add new employees.", Severity.Warning);
                Navigation.NavigateTo("/");
                return;
            }

            if (visibleTabs.Count > 0 && !visitedTabKeys.Contains(visibleTabs[0]))
            {
                var firstTab = visibleTabs[0];
                visitedTabKeys.Add(firstTab);
                await LoadTabLookupsAsync(firstTab);
            }

            // Fetch statuses and employee details in parallel
            var statusesTask = service.GetAvailableStatusesAsync();
            var employeeTask = IsEdit
                ? service.GetEmployeeByIdAsync(Id!.Value)
                : Task.FromResult<EmployeeDetailDto?>(null);

            await Task.WhenAll(statusesTask, employeeTask);

            availableStatuses = await statusesTask;

            if (IsEdit)
            {
                logger.LogInformation("Loading employee details for ID {EmployeeID}.", Id!.Value);
                var fetched = await employeeTask;


                if (fetched == null)
                {
                    errorMessage = $"Employee with ID {Id.Value} was not found.";
                    Snackbar.Add(errorMessage, Severity.Error);
                }
                else
                {
                    employee = fetched;

                    // Ensure employee has a valid StatusID from availableStatuses
                    if (!employee.StatusID.HasValue || employee.StatusID <= 0 || (availableStatuses != null && availableStatuses.Any() && !availableStatuses.Any(s => s.StatusID == employee.StatusID)))
                    {
                        StatusesDto? matchingStatus = null;
                        if (!string.IsNullOrWhiteSpace(employee.StatusDescription) && availableStatuses != null)
                        {
                            matchingStatus = availableStatuses.FirstOrDefault(s =>
                                string.Equals(s.StatusDescription, employee.StatusDescription, StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(s.StatusCode, employee.StatusDescription, StringComparison.OrdinalIgnoreCase));
                        }

                        matchingStatus ??= availableStatuses?.FirstOrDefault(s =>
                            string.Equals(s.StatusCode, "Active", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(s.StatusDescription, "Active", StringComparison.OrdinalIgnoreCase));

                        matchingStatus ??= availableStatuses?.FirstOrDefault();

                        if (matchingStatus != null)
                        {
                            employee.StatusID = matchingStatus.StatusID;
                            employee.StatusDescription = matchingStatus.StatusDescription ?? matchingStatus.StatusCode;
                        }
                    }
                }
            }
            else
            {
                var activeStatus = availableStatuses?.FirstOrDefault(s =>
                    string.Equals(s.StatusCode, "Active", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(s.StatusDescription, "Active", StringComparison.OrdinalIgnoreCase) ||
                    (s.StatusCode != null && s.StatusCode.StartsWith("Act", StringComparison.OrdinalIgnoreCase)) ||
                    (s.StatusDescription != null && s.StatusDescription.StartsWith("Act", StringComparison.OrdinalIgnoreCase)))
                    ?? availableStatuses?.FirstOrDefault();

                employee = new EmployeeDetailDto
                {
                    EmployeeFlag = true,
                    StatusID = activeStatus?.StatusID
                };
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading data for EmployeeDetail page.");
            errorMessage = $"Failed to load employee details: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        if (!canEditEmployee)
        {
            errorMessage = "You do not have permission to save employee details.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (employee.DOB.HasValue && employee.DOB.Value.Date > DateTime.Today)
        {
            errorMessage = "Date of Birth cannot be in the future.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (employee.HireDate.HasValue && employee.InactiveDate.HasValue && employee.InactiveDate.Value.Date < employee.HireDate.Value.Date)
        {
            errorMessage = "Inactive Date cannot be earlier than Hire Date.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (!employee.StatusID.HasValue || employee.StatusID <= 0)
        {
            if (availableStatuses == null)
            {
                availableStatuses = await service.GetAvailableStatusesAsync();
            }
            var activeStatus = availableStatuses?.FirstOrDefault(s =>
                string.Equals(s.StatusCode, "Active", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(s.StatusDescription, "Active", StringComparison.OrdinalIgnoreCase) ||
                (s.StatusCode != null && s.StatusCode.StartsWith("Act", StringComparison.OrdinalIgnoreCase)) ||
                (s.StatusDescription != null && s.StatusDescription.StartsWith("Act", StringComparison.OrdinalIgnoreCase)))
                ?? availableStatuses?.FirstOrDefault();

            if (activeStatus != null)
            {
                employee.StatusID = activeStatus.StatusID;
            }
        }

        isSaving = true;

        try
        {
            if (IsEdit)
            {
                logger.LogInformation("Updating employee ID {EmployeeID}.", employee.EmployeeID);
                var updated = await service.UpdateEmployeeAsync(employee.EmployeeID, employee);

                if (updated != null)
                {
                    employee = updated;
                    Snackbar.Add("Employee updated successfully!", Severity.Success);
                }
                else
                {
                    errorMessage = "Failed to update employee. Please check input values and try again.";
                    Snackbar.Add(errorMessage, Severity.Error);
                }
            }
            else
            {
                logger.LogInformation("Creating new employee.");
                var created = await service.CreateEmployeeAsync(employee);

                if (created != null)
                {
                    Snackbar.Add("Employee created successfully!", Severity.Success);
                    Navigation.NavigateTo($"/employee/edit/{created.EmployeeID}");
                }
                else
                {
                    errorMessage = "Failed to create employee. Please check input values and try again.";
                    Snackbar.Add(errorMessage, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error occurred while saving employee record.");
            errorMessage = $"Error saving employee: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        if (canAccessDetails)
        {
            Navigation.NavigateTo("/");
        }
        else if (canAccessEquipment)
        {
            Navigation.NavigateTo("/inventoryadmin");
        }
        else if (canAccessRangeStats || canAccessFirearms)
        {
            Navigation.NavigateTo("/rangestatistics");
        }
        else if (canAccessTrainings)
        {
            Navigation.NavigateTo("/multipletrainings");
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        if (!canEditEmployee) return;

        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                employee.EmployeeImage = ms.ToArray();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error uploading employee image.");
            Snackbar.Add($"Error uploading image: {ex.Message}", Severity.Error);
        }
    }

    private void RemoveImage()
    {
        if (!canEditEmployee) return;
        employee.EmployeeImage = null;
    }
}

