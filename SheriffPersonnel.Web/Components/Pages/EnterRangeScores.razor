    private async Task OnEmployeeSelected(ScoreEntryRow row, EmployeeSearchResultDto? employee)
    {
        row.SelectedEmployee = employee;
        row.EmployeeFirearms.Clear();
        row.SelectedMake = null;
        row.SelectedModel = null;
        row.SelectedSerial = null;
        row.SelectedCaliber = null;
        row.SelectedOptic = false;
        row.SelectedFirearmID = null;

        if (employee != null && employee.EmployeeID > 0)
        {
            row.IsLoadingFirearms = true;
            try
            {
                var firearms = await service.GetFirearmsByEmployeeIdAsync(employee.EmployeeID);
                row.EmployeeFirearms = firearms != null ? firearms.ToList() : new List<FirearmsDto>();

                var serials = GetAvailableSerials(row);
                if (serials.Count == 1)
                {
                    await OnSerialSelected(row, serials.First());
                }
                else if (row.EmployeeFirearms.Count == 1)
                {
                    var f = row.EmployeeFirearms.First();
                    row.SelectedMake = f.MakeName;
                    row.SelectedModel = f.ModelNumber;
                    row.SelectedSerial = f.SerialNumber;
                    row.SelectedCaliber = f.Caliber;
                    row.SelectedOptic = f.Optic;
                    row.SelectedFirearmID = f.FirearmID;
                }
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error fetching firearms for employee {EmployeeID}", employee.EmployeeID);
            }
            finally
            {
                row.IsLoadingFirearms = false;
                StateHasChanged();
            }
        }
    }

    private Task<IEnumerable<RangeOfficerDTO>> SearchRangeOfficers(string value, CancellationToken cancellationToken)
    {
        if (availableRangeOfficers == null || !availableRangeOfficers.Any())
        {
            return Task.FromResult(Enumerable.Empty<RangeOfficerDTO>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<RangeOfficerDTO>>(availableRangeOfficers);
        }

        return Task.FromResult(availableRangeOfficers.Where(ro => ro.OfficerName.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnRangeOfficerChanged(RangeOfficerDTO? officer)
    {
        selectedRangeOfficer = officer;
    }

    private Task<IEnumerable<RangeCourseDTO>> SearchCourses(string value, CancellationToken cancellationToken)
    {
        if (availableCourses == null || !availableCourses.Any())
        {
            return Task.FromResult(Enumerable.Empty<RangeCourseDTO>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<RangeCourseDTO>>(availableCourses);
        }

        var term = value.Trim();

        // 1. Look for matching CourseCode first (e.g. typing "P" finds CourseCode == "P", then CourseCode starting with "P")
        var codeMatches = availableCourses
            .Where(c => !string.IsNullOrWhiteSpace(c.CourseCode) &&
                        c.CourseCode.StartsWith(term, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => string.Equals(c.CourseCode, term, StringComparison.OrdinalIgnoreCase))
            .ThenBy(c => c.SortOrder ?? int.MaxValue)
            .ThenBy(c => c.CourseName)
            .ToList();

        if (codeMatches.Any())
        {
            return Task.FromResult<IEnumerable<RangeCourseDTO>>(codeMatches);
        }

        // 2. Next check if any CourseCode contains the search term
        var codeContainsMatches = availableCourses
            .Where(c => !string.IsNullOrWhiteSpace(c.CourseCode) &&
                        c.CourseCode.Contains(term, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.SortOrder ?? int.MaxValue)
            .ThenBy(c => c.CourseName)
            .ToList();

        if (codeContainsMatches.Any())
        {
            return Task.FromResult<IEnumerable<RangeCourseDTO>>(codeContainsMatches);
        }

        // 3. Fallback: Search by CourseName or FormattedCourse (starts with first, then contains)
        var nameStartsWithMatches = availableCourses
            .Where(c => (!string.IsNullOrWhiteSpace(c.CourseName) && c.CourseName.StartsWith(term, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrWhiteSpace(c.FormattedCourse) && c.FormattedCourse.StartsWith(term, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(c => c.SortOrder ?? int.MaxValue)
            .ThenBy(c => c.CourseName)
            .ToList();

        if (nameStartsWithMatches.Any())
        {
            return Task.FromResult<IEnumerable<RangeCourseDTO>>(nameStartsWithMatches);
        }

        var nameContainsMatches = availableCourses
            .Where(c => (!string.IsNullOrWhiteSpace(c.CourseName) && c.CourseName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrWhiteSpace(c.FormattedCourse) && c.FormattedCourse.Contains(term, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(c => c.SortOrder ?? int.MaxValue)
            .ThenBy(c => c.CourseName)
            .ToList();

        return Task.FromResult<IEnumerable<RangeCourseDTO>>(nameContainsMatches);
    }

    private List<string> GetAvailableSerials(ScoreEntryRow row)
    {
        if (row.EmployeeFirearms == null) return new List<string>();
        return row.EmployeeFirearms
            .Select(f => f.SerialNumber)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct()
            .ToList();
    }

    private Task<IEnumerable<string>> SearchRowSerials(ScoreEntryRow row, string value, CancellationToken cancellationToken)
    {
        var serials = GetAvailableSerials(row);

        if (string.IsNullOrWhiteSpace(value))
        {
            var options = new List<string>(serials) { NewFirearmOption };
            return Task.FromResult<IEnumerable<string>>(options);
        }

        var matchingSerials = serials
            .Where(s => s.StartsWith(value, StringComparison.OrdinalIgnoreCase))
            .Concat(serials.Where(s => !s.StartsWith(value, StringComparison.OrdinalIgnoreCase) && s.Contains(value, StringComparison.OrdinalIgnoreCase)))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (matchingSerials.Any())
        {
            matchingSerials.Add(NewFirearmOption);
        }
        else if (NewFirearmOption.Contains(value, StringComparison.OrdinalIgnoreCase))
        {
            matchingSerials.Add(NewFirearmOption);
        }

        return Task.FromResult<IEnumerable<string>>(matchingSerials);
    }

    private async Task OnSerialSelected(ScoreEntryRow row, string? serial)
    {
        if (string.Equals(serial, NewFirearmOption, StringComparison.OrdinalIgnoreCase))
        {
            row.SelectedSerial = null;
            await OpenAddFirearmModal(row);
            return;
        }

        row.SelectedSerial = serial;
        if (string.IsNullOrWhiteSpace(serial))
        {
            row.SelectedMake = null;
            row.SelectedModel = null;
            row.SelectedCaliber = null;
            row.SelectedOptic = false;
            row.SelectedFirearmID = null;
            return;
        }

        var matching = row.EmployeeFirearms
            .Where(f => string.Equals(f.SerialNumber, serial, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (matching.Any())
        {
            var f = matching.First();
            row.SelectedMake = f.MakeName;
            row.SelectedModel = f.ModelNumber;
            row.SelectedCaliber = f.Caliber;
            row.SelectedOptic = f.Optic;
            row.SelectedFirearmID = f.FirearmID;
        }
        else
        {
            row.SelectedMake = null;
            row.SelectedModel = null;
            row.SelectedCaliber = null;
            row.SelectedOptic = false;
            row.SelectedFirearmID = null;
        }
    }

    private async Task OpenAddFirearmModal(ScoreEntryRow row)
    {
        if (row.SelectedEmployee == null || row.SelectedEmployee.EmployeeID <= 0)
        {
            Snackbar.Add("Please select an officer before adding a firearm.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<AddFirearmModal>
        {
            { x => x.EmployeeId, row.SelectedEmployee.EmployeeID },
            { x => x.Firearm, new FirearmsDto { EmployeeID = row.SelectedEmployee.EmployeeID } },
            { x => x.AvailableMakes, availableMakes },
            { x => x.AvailableStatuses, availableStatuses }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddFirearmModal>("Add Firearm", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is FirearmsDto newFirearm)
        {
            row.IsLoadingFirearms = true;
            StateHasChanged();

            try
            {
                var firearms = await service.GetFirearmsByEmployeeIdAsync(row.SelectedEmployee.EmployeeID);
                row.EmployeeFirearms = firearms != null ? firearms.ToList() : new List<FirearmsDto>();

                if (!string.IsNullOrWhiteSpace(newFirearm.SerialNumber))
                {
                    await OnSerialSelected(row, newFirearm.SerialNumber);
                }
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error refreshing firearms for employee {EmployeeID} after adding firearm.", row.SelectedEmployee.EmployeeID);
            }
            finally
            {
                row.IsLoadingFirearms = false;
                StateHasChanged();
            }
        }
    }

    private static bool IsActiveOrRetired(EmployeeSearchResultDto e)
    {
        if (e == null) return false;

        var status = e.Status ?? string.Empty;

        if (status.Contains("Inactive", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("Terminated", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("Resigned", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "INACT", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "TERM", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (status.Contains("Retired", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "RET", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (e.InactiveDate.HasValue && e.InactiveDate.Value.Date <= DateTime.Today)
        {
            return false;
        }

        return true;
    }

    private Task<IEnumerable<EmployeeSearchResultDto>> SearchEmployees(string value, CancellationToken cancellationToken)
    {
        if (allEmployees == null || !allEmployees.Any())
        {
            return Task.FromResult(Enumerable.Empty<EmployeeSearchResultDto>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<EmployeeSearchResultDto>>(allEmployees);
        }

        var term = value.Trim();
        var filtered = allEmployees.Where(e =>
            (!string.IsNullOrEmpty(e.FormattedName) && e.FormattedName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.FirstName) && e.FirstName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.LastName) && e.LastName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.BadgeNumber) && e.BadgeNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
        );

        return Task.FromResult(filtered);
    }

    private void TogglePass(ScoreEntryRow row)
    {
        row.PassFail = (string.Equals(row.PassFail, "Pass", StringComparison.OrdinalIgnoreCase) || string.Equals(row.PassFail, "P", StringComparison.OrdinalIgnoreCase)) ? string.Empty : "Pass";
    }

    private void ToggleFail(ScoreEntryRow row)
    {
        row.PassFail = (string.Equals(row.PassFail, "Fail", StringComparison.OrdinalIgnoreCase) || string.Equals(row.PassFail, "F", StringComparison.OrdinalIgnoreCase)) ? string.Empty : "Fail";
    }

    private void OnResultKeyDown(KeyboardEventArgs e, ScoreEntryRow row)
    {
        if (e.Key.Equals("p", StringComparison.OrdinalIgnoreCase))
        {
            TogglePass(row);
        }
        else if (e.Key.Equals("f", StringComparison.OrdinalIgnoreCase))
        {
            ToggleFail(row);
        }
    }

    private async Task ResetForm()
    {
        rangeDate = DateTime.Today;
        selectedRangeOfficer = null;
        saveSuccessMessage = null;
        errorMessage = null;
        InitializeDefaultRows();
        Snackbar.Add("Form cleared.", Severity.Normal);
        if (eventDatePicker != null)
        {
            await eventDatePicker.FocusAsync();
        }
    }

    private async Task SaveAllRangeScoresAsync()
    {
        errorMessage = null;
        saveSuccessMessage = null;

        if (rangeDate == null)
        {
            errorMessage = "Please enter a valid Range Event Date.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (selectedRangeOfficer == null || selectedRangeOfficer.RangeOfficerID <= 0 || string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName))
        {
            errorMessage = "Please select a Range Officer.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        var unassignedRows = scoreRows.Where(r => (r.SelectedEmployee == null || r.SelectedEmployee.EmployeeID <= 0) &&
            (r.CourseID.HasValue || !string.IsNullOrWhiteSpace(r.SelectedMake) || !string.IsNullOrWhiteSpace(r.SelectedModel) || !string.IsNullOrWhiteSpace(r.SelectedSerial) || !string.IsNullOrWhiteSpace(r.SelectedCaliber))).ToList();
        if (unassignedRows.Any())
        {
            errorMessage = "Please select an Officer for all filled rows, or remove empty officer rows.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        var validRows = scoreRows.Where(r => r.SelectedEmployee != null && r.SelectedEmployee.EmployeeID > 0).ToList();
        if (!validRows.Any())
        {
            errorMessage = "Please select at least one Officer before saving.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        for (int i = 0; i < validRows.Count; i++)
        {
            var row = validRows[i];
            var officerName = string.IsNullOrWhiteSpace(row.SelectedEmployee?.FormattedName)
                ? $"Officer #{i + 1}"
                : row.SelectedEmployee.FormattedName;

            if (!row.CourseID.HasValue || row.CourseID.Value <= 0)
            {
                errorMessage = $"Please select a Course for {officerName}.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(row.SelectedMake))
            {
                errorMessage = $"Please select/enter a Make for {officerName}.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(row.SelectedModel))
            {
                errorMessage = $"Please select/enter a Model for {officerName}.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(row.SelectedSerial))
            {
                errorMessage = $"Please select/enter a Serial Number for {officerName}.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(row.SelectedCaliber))
            {
                errorMessage = $"Please select/enter a Caliber for {officerName}.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            if (string.IsNullOrWhiteSpace(row.PassFail))
            {
                errorMessage = $"Please select Pass or Fail result for {officerName}.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }
        }

        isSaving = true;

        try
        {
            // Step 1: Create Range Event
            var rangeEventDto = new RangeEventDTO
            {
                RangeDate = DateOnly.FromDateTime(rangeDate.Value),
                RangeOfficer = selectedRangeOfficer != null
                    ? new RangeOfficer
                    {
                        RangeOfficerID = selectedRangeOfficer.RangeOfficerID,
                        OfficerName = string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName) ? "Unknown" : selectedRangeOfficer.OfficerName,
                        IsActive = selectedRangeOfficer.IsActive
                    }
                    : null
            };

            var createdEvent = await service.CreateRangeEventAsync(rangeEventDto);
            if (createdEvent == null || createdEvent.RangeEventID <= 0)
            {
                throw new Exception("Failed to create Range Event header record.");
            }

            // Step 2: Create Range Statistics for each officer
            int savedCount = 0;
            foreach (var row in validRows)
            {
                var statDto = new RangeStatisticDTO
                {
                    RangeEventID = createdEvent.RangeEventID,
                    RangeDate = createdEvent.RangeDate,
                    EmployeeID = row.SelectedEmployee!.EmployeeID,
                    FirearmID = row.SelectedFirearmID,
                    CourseID = row.CourseID,
                    RoundsFired = row.RoundsFired,
                    PassFail = string.IsNullOrWhiteSpace(row.PassFail) ? "Pass" : row.PassFail,
                    SelectedSkillIDs = row.SelectedSkillIDs?.ToList() ?? new List<int>()
                };

                var createdStat = await service.CreateRangeStatisticAsync(statDto);
                if (createdStat != null)
                {
                    savedCount++;
                }
            }

            saveSuccessMessage = $"Successfully created Range Event on {createdEvent.RangeDate:MM/dd/yyyy} and saved {savedCount} officer score record(s)!";
            Snackbar.Add(saveSuccessMessage, Severity.Success);

            // Reset scores list for next batch
            selectedRangeOfficer = null;
            InitializeDefaultRows();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving bulk range statistics.");
            errorMessage = $"Error saving range scores: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool IsCourseP(ScoreEntryRow row)
    {
        if (!row.CourseID.HasValue) return false;
        var course = availableCourses.FirstOrDefault(c => c.CourseID == row.CourseID.Value);
        return course != null && string.Equals(course.CourseCode, "P", StringComparison.OrdinalIgnoreCase);
    }

    private void OnCourseSelected(ScoreEntryRow row, RangeCourseDTO? course)
    {
        row.CourseID = course?.CourseID;
        if (!IsCourseP(row))
        {
            row.SelectedSkillIDs.Clear();
        }
        StateHasChanged();
    }

    private async Task OnCourseKeyDown(KeyboardEventArgs e, ScoreEntryRow row)
    {
        if (e.Key == "Tab" && !e.ShiftKey)
        {
            // Yield and delay to allow MudAutocomplete to commit the selection (e.g. "P")
            // and invoke OnCourseSelected before checking if Course is "P".
            await Task.Yield();
            await Task.Delay(50);
            if (IsCourseP(row))
            {
                if (row.SkillsSelectRef != null)
                {
                    await row.SkillsSelectRef.FocusAsync();
                }
                else
                {
                    // Retry once after another brief delay if DOM rendering is still completing
                    await Task.Delay(50);
                    if (row.SkillsSelectRef != null)
                    {
                        await row.SkillsSelectRef.FocusAsync();
                    }
                }
            }
        }
    }

    private string GetSkillsSelectionSummary(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any())
        {
            return "0 Skills";
        }

        var skillNames = new List<string>();
        foreach (var valStr in selectedValues)
        {
            if (int.TryParse(valStr, out int id))
            {
                var skill = availableRangeSkills.FirstOrDefault(s => s.RangeSkillID == id);
                if (skill != null)
                {
                    skillNames.Add(skill.SkillName);
                }
            }
        }

        if (!skillNames.Any()) return $"{selectedValues.Count} Skills";
        if (skillNames.Count == 1) return skillNames[0];
        return $"{skillNames.Count} Skills ({string.Join(", ", skillNames)})";
    }

    private async Task OpenSkillsModal(ScoreEntryRow row)
    {
        var officerName = row.SelectedEmployee != null
            ? (string.IsNullOrWhiteSpace(row.SelectedEmployee.BadgeNumber)
                ? row.SelectedEmployee.FormattedName
                : $"{row.SelectedEmployee.FormattedName} (#{row.SelectedEmployee.BadgeNumber})")
            : "Officer";

        var parameters = new DialogParameters<SelectRangeSkillsModal>
        {
            { x => x.OfficerName, officerName },
            { x => x.AvailableSkills, availableRangeSkills },
            { x => x.SelectedSkillIDs, new HashSet<int>(row.SelectedSkillIDs) }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SelectRangeSkillsModal>("Select Range Skills", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is List<int> selectedSkills)
        {
            row.SelectedSkillIDs = selectedSkills;
            StateHasChanged();
        }
    }
}

