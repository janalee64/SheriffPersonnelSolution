    private async Task LoadReferenceDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var coursesTask = service.GetRangeCoursesAsync();
            var employeesTask = service.GetActiveEmployeesAsync();
            var rangeOfficersTask = codeTableService.GetRangeOfficersAsync();
            var rangeSkillsTask = codeTableService.GetRangeSkillsAsync();

            await Task.WhenAll(coursesTask, employeesTask, rangeOfficersTask, rangeSkillsTask);

            var courses = await coursesTask;
            availableCourses = courses != null ? courses.Where(c => c.IsActive).ToList() : new();

            var employees = await employeesTask;
            allEmployees = employees != null
                ? employees.Where(e => (string.IsNullOrEmpty(e.Status) || string.Equals(e.Status, "Active", StringComparison.OrdinalIgnoreCase) || string.Equals(e.Status, "A", StringComparison.OrdinalIgnoreCase)) && (!e.InactiveDate.HasValue || e.InactiveDate.Value.Date > DateTime.Today)).OrderBy(e => e.LastName).ThenBy(e => e.FirstName).ToList()
                : new();

            var rangeOfficers = await rangeOfficersTask;
            availableRangeOfficers = rangeOfficers != null
                ? rangeOfficers.Where(ro => ro.IsActive).OrderBy(ro => ro.OfficerName).ToList()
                : new();

            var rangeSkills = await rangeSkillsTask;
            availableRangeSkills = rangeSkills != null
                ? rangeSkills.OrderBy(rs => rs.SkillName).ToList()
                : new();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading range reference options.");
            errorMessage = $"Failed to load reference data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void InitializeDefaultRows()
    {
        scoreRows.Clear();
        for (int i = 0; i < 5; i++)
        {
            AddRow();
        }
    }

    private void AddRow()
    {
        scoreRows.Add(new ScoreEntryRow
        {
            PassFail = "Pass"
        });
    }

    private void AddFiveRows()
    {
        for (int i = 0; i < 5; i++)
        {
            AddRow();
        }
    }

    private void RemoveRow(ScoreEntryRow row)
    {
        scoreRows.Remove(row);
        if (!scoreRows.Any())
        {
            AddRow();
        }
    }

    private void ClearEmptyRows()
    {
        scoreRows.RemoveAll(r => r.SelectedEmployee == null || r.SelectedEmployee.EmployeeID <= 0);
        if (!scoreRows.Any())
        {
            AddRow();
        }
    }

    private async Task OnEmployeeSelected(ScoreEntryRow row, EmployeeSearchResultDto? employee)
    {
        row.SelectedEmployee = employee;
        row.EmployeeFirearms.Clear();
        row.SelectedMake = null;
        row.SelectedModel = null;
        row.SelectedSerial = null;
        row.SelectedCaliber = null;
        row.SelectedFirearmID = null;

        if (employee != null && employee.EmployeeID > 0)
        {
            row.IsLoadingFirearms = true;
            try
            {
                var firearms = await service.GetFirearmsByEmployeeIdAsync(employee.EmployeeID);
                row.EmployeeFirearms = firearms != null ? firearms.ToList() : new List<FirearmsDto>();

                var distinctMakes = GetAvailableMakes(row);
                if (distinctMakes.Count == 1)
                {
                    OnMakeSelected(row, distinctMakes.First());
                }
                else if (row.EmployeeFirearms.Count == 1)
                {
                    var f = row.EmployeeFirearms.First();
                    row.SelectedMake = f.MakeName;
                    row.SelectedModel = f.ModelNumber;
                    row.SelectedSerial = f.SerialNumber;
                    row.SelectedCaliber = f.Caliber;
                    row.SelectedFirearmID = f.FirearmID;
                }
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error fetching firearms for employee {EmployeeID}", employee.EmployeeID);
            }
            finally
            {
                row.IsLoadingFirearms = false;
                StateHasChanged();
            }
        }
    }

    private Task<IEnumerable<RangeOfficerDTO>> SearchRangeOfficers(string value, CancellationToken cancellationToken)
