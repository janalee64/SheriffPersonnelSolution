@code {
    private MudDatePicker? eventDatePicker;
    private DateTime? rangeDate = DateTime.Today;
    private string eventType = string.Empty;
    private string? location = string.Empty;

    private MudBlazor.IReversibleConverter<DateTime?, string> eventDateConverter = new TwoDigitYearDateConverter();

    public class TwoDigitYearDateConverter : MudBlazor.IReversibleConverter<DateTime?, string>
    {
        public Func<DateTime?, string> SetFunc { get; set; } = date => date?.ToString("MM/dd/yyyy") ?? string.Empty;
        public Func<string, DateTime?> GetFunc { get; set; } = text => ParseTwoDigitYearDate(text);

        public string Convert(DateTime? value) => value?.ToString("MM/dd/yyyy") ?? string.Empty;
        public DateTime? ConvertBack(string value) => ParseTwoDigitYearDate(value);
        public DateTime? Get(string value) => ParseTwoDigitYearDate(value);
        public string Set(DateTime? value) => Convert(value);

        private static DateTime? ParseTwoDigitYearDate(string? text)
        {
            if (string.IsNullOrWhiteSpace(text)) return null;

            text = text.Trim();

            string[] formats = new[]
            {
                "MM/dd/yyyy", "M/d/yyyy", "MM-dd-yyyy", "M-d-yyyy",
                "MM/dd/yy",   "M/d/yy",   "MM-dd-yy",   "M-d-yy",
                "MMddyyyy",   "MMddyy",   "yyyy-MM-dd"
            };

            if (DateTime.TryParseExact(text, formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime parsedDate))
            {
                var parts = text.Split(new[] { '/', '-' });
                if (parts.Length == 3 && parts[2].Length == 2 && int.TryParse(parts[2], out int yy))
                {
                    int fullYear = (yy <= 79) ? 2000 + yy : 1900 + yy;
                    return new DateTime(fullYear, parsedDate.Month, parsedDate.Day);
                }
                if (parsedDate.Year < 100)
                {
                    int fullYear = (parsedDate.Year <= 79) ? 2000 + parsedDate.Year : 1900 + parsedDate.Year;
                    return new DateTime(fullYear, parsedDate.Month, parsedDate.Day);
                }
                return parsedDate;
            }

            if (DateTime.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime dt))
            {
                var parts = text.Split(new[] { '/', '-' });
                if (parts.Length == 3 && parts[2].Length == 2 && int.TryParse(parts[2], out int yy))
                {
                    int fullYear = (yy <= 79) ? 2000 + yy : 1900 + yy;
                    return new DateTime(fullYear, dt.Month, dt.Day);
                }
                if (dt.Year < 100)
                {
                    int fullYear = (dt.Year <= 79) ? 2000 + dt.Year : 1900 + dt.Year;
                    return new DateTime(fullYear, dt.Month, dt.Day);
                }
                return dt;
            }

            return null;
        }
    }

