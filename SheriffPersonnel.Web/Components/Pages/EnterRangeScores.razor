    private void OnMakeSelected(ScoreEntryRow row, string? make)
    {
        row.SelectedMake = make;
        if (string.IsNullOrEmpty(make))
        {
            row.SelectedModel = null;
            row.SelectedSerial = null;
            row.SelectedCaliber = null;
            row.SelectedFirearmID = null;
            return;
        }

        var matching = row.EmployeeFirearms
            .Where(f => string.Equals(f.MakeName, make, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (matching.Count == 1)
        {
            var f = matching.First();
            row.SelectedModel = f.ModelNumber;
            row.SelectedSerial = f.SerialNumber;
            row.SelectedCaliber = f.Caliber;
            row.SelectedFirearmID = f.FirearmID;
        }
        else if (matching.Count > 1)
        {
            var models = matching.Select(f => f.ModelNumber).Where(m => !string.IsNullOrWhiteSpace(m)).Distinct().ToList();
            row.SelectedModel = models.Count == 1 ? models.First() : (!string.IsNullOrEmpty(row.SelectedModel) && models.Contains(row.SelectedModel) ? row.SelectedModel : null);

            var serials = matching.Select(f => f.SerialNumber).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToList();
            row.SelectedSerial = serials.Count == 1 ? serials.First() : (!string.IsNullOrEmpty(row.SelectedSerial) && serials.Contains(row.SelectedSerial) ? row.SelectedSerial : null);

            var calibers = matching.Select(f => f.Caliber).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().ToList();
            row.SelectedCaliber = calibers.Count == 1 ? calibers.First() : (!string.IsNullOrEmpty(row.SelectedCaliber) && calibers.Contains(row.SelectedCaliber) ? row.SelectedCaliber : null);

            UpdateSelectedFirearmId(row);
        }
    }

    private void OnModelSelected(ScoreEntryRow row, string? model)
    {
        row.SelectedModel = model;
        AutoPopulateFromMatch(row);
    }

    private void OnSerialSelected(ScoreEntryRow row, string? serial)
    {
        row.SelectedSerial = serial;
        AutoPopulateFromMatch(row);
    }

    private void OnCaliberSelected(ScoreEntryRow row, string? caliber)
    {
        row.SelectedCaliber = caliber;
        AutoPopulateFromMatch(row);
    }

    private void AutoPopulateFromMatch(ScoreEntryRow row)
    {
        var matching = row.EmployeeFirearms.AsEnumerable();
        if (!string.IsNullOrEmpty(row.SelectedMake))
            matching = matching.Where(f => string.Equals(f.MakeName, row.SelectedMake, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(row.SelectedModel))
            matching = matching.Where(f => string.Equals(f.ModelNumber, row.SelectedModel, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(row.SelectedSerial))
            matching = matching.Where(f => string.Equals(f.SerialNumber, row.SelectedSerial, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(row.SelectedCaliber))
            matching = matching.Where(f => string.Equals(f.Caliber, row.SelectedCaliber, StringComparison.OrdinalIgnoreCase));

        var list = matching.ToList();
        if (list.Count == 1)
        {
            var f = list.First();
            if (string.IsNullOrEmpty(row.SelectedMake)) row.SelectedMake = f.MakeName;
            if (string.IsNullOrEmpty(row.SelectedModel)) row.SelectedModel = f.ModelNumber;
            if (string.IsNullOrEmpty(row.SelectedSerial)) row.SelectedSerial = f.SerialNumber;
            if (string.IsNullOrEmpty(row.SelectedCaliber)) row.SelectedCaliber = f.Caliber;
            row.SelectedFirearmID = f.FirearmID;
        }
        else
        {
            UpdateSelectedFirearmId(row);
        }
    }

    private void UpdateSelectedFirearmId(ScoreEntryRow row)
    {
        var matching = row.EmployeeFirearms.AsEnumerable();
        if (!string.IsNullOrEmpty(row.SelectedMake))
            matching = matching.Where(f => string.Equals(f.MakeName, row.SelectedMake, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(row.SelectedModel))
            matching = matching.Where(f => string.Equals(f.ModelNumber, row.SelectedModel, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(row.SelectedSerial))
            matching = matching.Where(f => string.Equals(f.SerialNumber, row.SelectedSerial, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(row.SelectedCaliber))
            matching = matching.Where(f => string.Equals(f.Caliber, row.SelectedCaliber, StringComparison.OrdinalIgnoreCase));

        var list = matching.ToList();
        if (list.Count == 1)
        {
            row.SelectedFirearmID = list.First().FirearmID;
        }
        else
        {
            row.SelectedFirearmID = null;
        }
    }

    private Task<IEnumerable<EmployeeSearchResultDto>> SearchEmployees(string value, CancellationToken cancellationToken)
    {
        if (allEmployees == null || !allEmployees.Any())
        {
            return Task.FromResult(Enumerable.Empty<EmployeeSearchResultDto>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<EmployeeSearchResultDto>>(allEmployees);
        }

        var term = value.Trim();
        var filtered = allEmployees.Where(e =>
            (!string.IsNullOrEmpty(e.FormattedName) && e.FormattedName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.FirstName) && e.FirstName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.LastName) && e.LastName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.BadgeNumber) && e.BadgeNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
        );

        return Task.FromResult(filtered);
    }

    private void TogglePass(ScoreEntryRow row)
    {
        row.PassFail = (string.Equals(row.PassFail, "Pass", StringComparison.OrdinalIgnoreCase) || string.Equals(row.PassFail, "P", StringComparison.OrdinalIgnoreCase)) ? string.Empty : "Pass";
    }

    private void ToggleFail(ScoreEntryRow row)
    {
        row.PassFail = (string.Equals(row.PassFail, "Fail", StringComparison.OrdinalIgnoreCase) || string.Equals(row.PassFail, "F", StringComparison.OrdinalIgnoreCase)) ? string.Empty : "Fail";
    }

    private void OnResultKeyDown(KeyboardEventArgs e, ScoreEntryRow row)
    {
        if (e.Key.Equals("p", StringComparison.OrdinalIgnoreCase))
        {
            TogglePass(row);
        }
        else if (e.Key.Equals("f", StringComparison.OrdinalIgnoreCase))
        {
            ToggleFail(row);
        }
    }

    private async Task ResetForm()
    {
        rangeDate = DateTime.Today;
        eventType = string.Empty;
        location = string.Empty;
        selectedRangeOfficer = null;
        saveSuccessMessage = null;
        errorMessage = null;
        InitializeDefaultRows();
        Snackbar.Add("Form cleared.", Severity.Normal);
        if (eventDatePicker != null)
        {
            await eventDatePicker.FocusAsync();
        }
    }

    private async Task SaveAllRangeScoresAsync()
    {
        errorMessage = null;
        saveSuccessMessage = null;

        if (rangeDate == null)
        {
            errorMessage = "Please enter a valid Range Event Date.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(eventType))
        {
            errorMessage = "Please enter an Event / Session Type (e.g. Handgun Qualification).";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        var validRows = scoreRows.Where(r => r.SelectedEmployee != null && r.SelectedEmployee.EmployeeID > 0).ToList();
        if (!validRows.Any())
        {
            errorMessage = "Please select at least one Officer before saving.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        isSaving = true;

        try
        {
            // Step 1: Create Range Event
            var rangeEventDto = new RangeEventDTO
            {
                RangeDate = DateOnly.FromDateTime(rangeDate.Value),
                EventType = eventType.Trim(),
                Location = string.IsNullOrWhiteSpace(location) ? null : location.Trim(),
                RangeOfficer = selectedRangeOfficer != null
                    ? new RangeOfficer
                    {
                        RangeOfficerID = selectedRangeOfficer.RangeOfficerID,
                        OfficerName = string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName) ? "Unknown" : selectedRangeOfficer.OfficerName,
                        IsActive = selectedRangeOfficer.IsActive
                    }
                    : null
            };

            var createdEvent = await service.CreateRangeEventAsync(rangeEventDto);
            if (createdEvent == null || createdEvent.RangeEventID <= 0)
            {
                throw new Exception("Failed to create Range Event header record.");
            }

            // Step 2: Create Range Statistics for each officer
            int savedCount = 0;
            foreach (var row in validRows)
            {
                var statDto = new RangeStatisticDTO
                {
                    RangeEventID = createdEvent.RangeEventID,
                    RangeDate = createdEvent.RangeDate,
                    EmployeeID = row.SelectedEmployee!.EmployeeID,
                    FirearmID = row.SelectedFirearmID,
                    CourseID = row.CourseID,
                    RoundsFired = row.RoundsFired,
                    PassFail = string.IsNullOrWhiteSpace(row.PassFail) ? "Pass" : row.PassFail,
                    SelectedSkillIDs = row.SelectedSkillIDs?.ToList() ?? new List<int>()
                };

                var createdStat = await service.CreateRangeStatisticAsync(statDto);
                if (createdStat != null)
                {
                    savedCount++;
                }
            }

            saveSuccessMessage = $"Successfully created Range Event '{createdEvent.EventType}' on {createdEvent.RangeDate:MM/dd/yyyy} and saved {savedCount} officer score record(s)!";
            Snackbar.Add(saveSuccessMessage, Severity.Success);

            // Reset scores list for next batch
            eventType = string.Empty;
            selectedRangeOfficer = null;
            InitializeDefaultRows();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving bulk range statistics.");
            errorMessage = $"Error saving range scores: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool IsCourseP(ScoreEntryRow row)
    {
        if (!row.CourseID.HasValue) return false;
        var course = availableCourses.FirstOrDefault(c => c.CourseID == row.CourseID.Value);
        return course != null && string.Equals(course.CourseCode, "P", StringComparison.OrdinalIgnoreCase);
    }

    private void OnCourseSelected(ScoreEntryRow row, RangeCourseDTO? course)
    {
        row.CourseID = course?.CourseID;
        if (!IsCourseP(row))
        {
            row.SelectedSkillIDs.Clear();
        }
        StateHasChanged();
    }

    private async Task OnCourseKeyDown(KeyboardEventArgs e, ScoreEntryRow row)
    {
        if (e.Key == "Tab" && !e.ShiftKey)
        {
            // Yield and delay to allow MudAutocomplete to commit the selection (e.g. "P")
            // and invoke OnCourseSelected before checking if Course is "P".
            await Task.Yield();
            await Task.Delay(50);
            if (IsCourseP(row))
            {
                if (row.SkillsSelectRef != null)
                {
                    await row.SkillsSelectRef.FocusAsync();
                }
                else
                {
                    // Retry once after another brief delay if DOM rendering is still completing
                    await Task.Delay(50);
                    if (row.SkillsSelectRef != null)
                    {
                        await row.SkillsSelectRef.FocusAsync();
                    }
                }
            }
        }
    }

    private string GetSkillsSelectionSummary(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any())
        {
            return "0 Skills";
        }

        var skillNames = new List<string>();
        foreach (var valStr in selectedValues)
        {
            if (int.TryParse(valStr, out int id))
            {
                var skill = availableRangeSkills.FirstOrDefault(s => s.RangeSkillID == id);
                if (skill != null)
                {
                    skillNames.Add(skill.SkillName);
                }
            }
        }

        if (!skillNames.Any()) return $"{selectedValues.Count} Skills";
        if (skillNames.Count == 1) return skillNames[0];
        return $"{skillNames.Count} Skills ({string.Join(", ", skillNames)})";
    }

    private async Task OpenSkillsModal(ScoreEntryRow row)
    {
        var officerName = row.SelectedEmployee != null
            ? (string.IsNullOrWhiteSpace(row.SelectedEmployee.BadgeNumber)
                ? row.SelectedEmployee.FormattedName
                : $"{row.SelectedEmployee.FormattedName} (#{row.SelectedEmployee.BadgeNumber})")
            : "Officer";

        var parameters = new DialogParameters<SelectRangeSkillsModal>
        {
            { x => x.OfficerName, officerName },
            { x => x.AvailableSkills, availableRangeSkills },
            { x => x.SelectedSkillIDs, new HashSet<int>(row.SelectedSkillIDs) }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SelectRangeSkillsModal>("Select Range Skills", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is List<int> selectedSkills)
        {
            row.SelectedSkillIDs = selectedSkills;
            StateHasChanged();
        }
    }
}
