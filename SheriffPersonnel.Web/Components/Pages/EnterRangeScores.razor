@page "/enterrangescores"
@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Shared.Models
@using SheriffPersonnel.Web.Services
@attribute [Authorize]

@inject SearchService service
@inject CodeTableService codeTableService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ILogger<EnterRangeScores> logger

<PageTitle>Enter Range Scores</PageTitle>

<style>
    .btn-pass:focus,
    .btn-pass:focus-visible {
        outline: 3px solid #2e7d32 !important;
        outline-offset: 2px !important;
        box-shadow: 0 0 0 4px rgba(46, 125, 50, 0.4) !important;
        background-color: rgba(46, 125, 50, 0.15) !important;
        border-color: #2e7d32 !important;
        z-index: 2 !important;
    }

    .btn-pass.mud-button-filled:focus,
    .btn-pass.mud-button-filled:focus-visible {
        background-color: #1b5e20 !important;
        color: #ffffff !important;
        outline: 3px solid #81c784 !important;
        outline-offset: 2px !important;
        box-shadow: 0 0 0 4px rgba(46, 125, 50, 0.6) !important;
    }

    .btn-fail:focus,
    .btn-fail:focus-visible {
        outline: 3px solid #d32f2f !important;
        outline-offset: 2px !important;
        box-shadow: 0 0 0 4px rgba(211, 47, 47, 0.4) !important;
        background-color: rgba(211, 47, 47, 0.15) !important;
        border-color: #d32f2f !important;
        z-index: 2 !important;
    }

    .btn-fail.mud-button-filled:focus,
    .btn-fail.mud-button-filled:focus-visible {
        background-color: #b71c1c !important;
        color: #ffffff !important;
        outline: 3px solid #e57373 !important;
        outline-offset: 2px !important;
        box-shadow: 0 0 0 4px rgba(211, 47, 47, 0.6) !important;
    }

    /* Fix MudSelect popover dropdown width & checkbox spacing */
    .skills-popover-menu.mud-popover,
    .mud-popover:has(.skills-popover-menu) {
        min-width: 260px !important;
        max-width: 320px !important;
        width: auto !important;
    }
    .skills-popover-menu .mud-list-item,
    .mud-popover .mud-list-item {
        padding: 2px 8px !important;
        min-height: 28px !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox,
    .skills-popover-menu .mud-list-item .mud-checkbox.mud-input-content-placement-end,
    .mud-popover .mud-list-item .mud-checkbox,
    .mud-popover .mud-list-item .mud-checkbox.mud-input-content-placement-end {
        gap: 6px !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-button-root,
    .mud-popover .mud-list-item .mud-checkbox .mud-button-root {
        padding: 0 !important;
        margin: 0 !important;
        width: 20px !important;
        height: 20px !important;
        min-width: 20px !important;
        min-height: 20px !important;
        flex-shrink: 0 !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-icon-root,
    .mud-popover .mud-list-item .mud-checkbox .mud-icon-root {
        font-size: 1.15rem !important;
        width: 1.15rem !important;
        height: 1.15rem !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-checkbox-text,
    .skills-popover-menu .mud-list-item .mud-checkbox > .mud-typography,
    .skills-popover-menu .mud-list-item .mud-checkbox.mud-input-content-placement-end > .mud-typography,
    .mud-popover .mud-list-item .mud-checkbox .mud-checkbox-text,
    .mud-popover .mud-list-item .mud-checkbox > .mud-typography,
    .mud-popover .mud-list-item .mud-checkbox.mud-input-content-placement-end > .mud-typography {
        padding-left: 0 !important;
        margin-left: 0 !important;
        font-size: 0.8125rem !important;
        line-height: 1.25 !important;
        white-space: normal !important;
        word-break: break-word !important;
        flex-grow: 1 !important;
        text-align: left !important;
    }
</style>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4" Class="mb-1">Enter Range Scores</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Record a new Range Event and bulk-enter scores for participating officers.
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetForm" Disabled="@isSaving" tabindex="-1">
        Clear & Reset
    </MudButton>
</MudStack>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close" CloseIconClicked="() => errorMessage = null">
        @errorMessage
    </MudAlert>
}

@if (saveSuccessMessage != null)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close" CloseIconClicked="() => saveSuccessMessage = null">
        @saveSuccessMessage
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick='() => Navigation.NavigateTo("rangestatistics")' Class="ml-2">
            View Range Statistics Page
        </MudButton>
    </MudAlert>
}

<!-- Top Area: Range Event Details -->
<MudPaper Class="pa-5 mb-4" Elevation="3" Style="border-top: 4px solid var(--mud-palette-primary);">
    <MudText Typo="Typo.h6" Class="mb-3 d-flex align-center" Style="gap: 8px;">
        <MudIcon Icon="@Icons.Material.Filled.EventNote" Color="Color.Primary" />
        1. Range Event Information
    </MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
        Enter details for this range session. These details will apply to all officer scores below.
    </MudText>

    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @ref="eventDatePicker"
                           @bind-Date="rangeDate"
                           Converter="@eventDateConverter"
                           Label="Event Date *"
                           Variant="Variant.Outlined"
                           DateFormat="MM/dd/yyyy"
                           Required="true"
                           Editable="true"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="eventType"
                          Label="Event / Session Type *"
                          Placeholder="e.g. Annual Qualification, Night Shoot"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Event type is required" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="location"
                          Label="Location / Range Name"
                          Placeholder="e.g. County Range, Outdoor Bay 1"
                          Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudAutocomplete T="RangeOfficerDTO"
                             Value="selectedRangeOfficer"
                             ValueChanged="OnRangeOfficerChanged"
                             SearchFunc="SearchRangeOfficers"
                             ToStringFunc="@(ro => ro == null ? string.Empty : ro.OfficerName)"
                             Label="Range Officer"
                             Placeholder="Type or select Range Officer"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="true"
                             CoerceValue="false"
                             SelectValueOnTab="true"
                             MinCharacters="0" />
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Scores Entry Rows Area -->
<MudPaper Class="pa-5 mb-4" Elevation="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap">
        <div>
            <MudText Typo="Typo.h6" Class="d-flex align-center" Style="gap: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Primary" />
                2. Officer Scores (@scoreRows.Count)
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Select officers and record their qualification scores.
            </MudText>
        </div>

        <MudStack Row="true" Spacing="2" Class="mt-2 mt-sm-0">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddRow" tabindex="-1">
                + Add Officer
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddFiveRows" tabindex="-1">
                + Add 5 Rows
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.CleaningServices" OnClick="ClearEmptyRows" Disabled="@(!scoreRows.Any(r => r.SelectedEmployee == null))" tabindex="-1">
                Remove Empty
            </MudButton>
        </MudStack>
    </MudStack>

    @if (isLoading)
    {
        <MudPaper Class="pa-6 d-flex justify-center align-center" Style="min-height: 150px;" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
            <MudText Class="ml-3">Loading courses and reference data...</MudText>
        </MudPaper>
    }
    else
    {
        <div class="d-none d-md-block overflow-x-auto">
            <!-- Desktop Grid View -->
            <MudTable Items="scoreRows" Hover="true" Striped="true" Elevation="0" Dense="true" Class="range-scores-table">
                <HeaderContent>
                    <MudTh Style="width: 45px; text-align: center;">#</MudTh>
                    <MudTh Style="min-width: 280px;">Officer / Employee *</MudTh>
                    <MudTh Style="min-width: 110px;">Unit</MudTh>
                    <MudTh Style="min-width: 140px;">Course</MudTh>
                    <MudTh Style="min-width: 180px;">Range Skills</MudTh>
                    <MudTh Style="min-width: 150px;">Make</MudTh>
                    <MudTh Style="min-width: 160px;">Model</MudTh>
                    <MudTh Style="min-width: 170px;">Serial Number</MudTh>
                    <MudTh Style="min-width: 130px;">Caliber</MudTh>
                    <MudTh Style="min-width: 160px; text-align: center;">Result (Pass/Fail)</MudTh>
                    <MudTh Style="width: 60px; text-align: center;">Action</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="#" Style="text-align: center;">@(scoreRows.IndexOf(row) + 1)</MudTd>
                    <MudTd DataLabel="Officer">
                        <MudAutocomplete T="EmployeeSearchResultDto"
                                         Value="row.SelectedEmployee"
                                         ValueChanged="@(e => OnEmployeeSelected(row, e))"
                                         SearchFunc="SearchEmployees"
                                         ToStringFunc="@(e => e == null ? string.Empty : (string.IsNullOrWhiteSpace(e.BadgeNumber) ? e.FormattedName : $"{e.FormattedName} (#{e.BadgeNumber})"))"
                                         Placeholder="Type name or badge #"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         ShowProgressIndicator="true"
                                         Style="min-width: 260px;" />
                    </MudTd>
                    <MudTd DataLabel="Unit">
                        <MudText Typo="Typo.body2" Style="font-weight: 500;">
                            @(row.SelectedEmployee?.Unit ?? string.Empty)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Course">
                        <MudAutocomplete T="RangeCourseDTO"
                                         Value="@(availableCourses.FirstOrDefault(c => c.CourseID == row.CourseID))"
                                         ValueChanged="@(c => OnCourseSelected(row, c))"
                                         SearchFunc="SearchCourses"
                                         ToStringFunc="@(c => c == null ? string.Empty : (!string.IsNullOrWhiteSpace(c.CourseCode) ? c.CourseCode : c.CourseName))"
                                         Placeholder="-- Select Course --"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         @onkeydown="@(e => OnCourseKeyDown(e, row))"
                                         Style="min-width: 130px;" />
                    </MudTd>
                    <MudTd DataLabel="Range Skills">
                        @if (IsCourseP(row))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="min-width: 170px;">
                                <MudSelect T="int"
                                           @ref="row.SkillsSelectRef"
                                           MultiSelection="true"
                                           SelectAll="true"
                                           SelectAllText="Select All"
                                           PopoverClass="skills-popover-menu"
                                           Placeholder="Select Skills"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           SelectedValues="@row.SelectedSkillIDs"
                                           SelectedValuesChanged="@(vals => row.SelectedSkillIDs = vals.ToList())"
                                           MultiSelectionTextFunc="@(selectedList => GetSkillsSelectionSummary(selectedList))"
                                           Style="flex-grow: 1;">
                                    @foreach (var skill in availableRangeSkills)
                                    {
                                        <MudSelectItem T="int" Value="@skill.RangeSkillID">@skill.SkillName</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenSkillsModal(row))"
                                               tabindex="-1" />
                            </MudStack>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary" Typo="Typo.caption" Class="d-flex align-center justify-center">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Make">
                        <MudAutocomplete T="string"
                                         Value="row.SelectedMake"
                                         ValueChanged="@(m => OnMakeSelected(row, m))"
                                         SearchFunc="@((val, ct) => SearchRowMakes(row, val, ct))"
                                         Placeholder="Select Make"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         Disabled="@(row.SelectedEmployee == null || row.IsLoadingFirearms)"
                                         Style="min-width: 135px;" />
                    </MudTd>
                    <MudTd DataLabel="Model">
                        <MudAutocomplete T="string"
                                         Value="row.SelectedModel"
                                         ValueChanged="@(m => OnModelSelected(row, m))"
                                         SearchFunc="@((val, ct) => SearchRowModels(row, val, ct))"
                                         Placeholder="Select Model"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         Disabled="@(row.SelectedEmployee == null || row.IsLoadingFirearms)"
                                         Style="min-width: 145px;" />
                    </MudTd>
                    <MudTd DataLabel="Serial Number">
                        <MudAutocomplete T="string"
                                         Value="row.SelectedSerial"
                                         ValueChanged="@(s => OnSerialSelected(row, s))"
                                         SearchFunc="@((val, ct) => SearchRowSerials(row, val, ct))"
                                         Placeholder="Select Serial #"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         Disabled="@(row.SelectedEmployee == null || row.IsLoadingFirearms)"
                                         Style="min-width: 155px;" />
                    </MudTd>
                    <MudTd DataLabel="Caliber">
                        <MudAutocomplete T="string"
                                         Value="row.SelectedCaliber"
                                         ValueChanged="@(c => OnCaliberSelected(row, c))"
                                         SearchFunc="@((val, ct) => SearchRowCalibers(row, val, ct))"
                                         Placeholder="Select Caliber"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         Disabled="@(row.SelectedEmployee == null || row.IsLoadingFirearms)"
                                         Style="min-width: 115px;" />
                    </MudTd>
                    <MudTd DataLabel="Result" Style="text-align: center;">
                        <MudButtonGroup Size="Size.Small" Style="min-width: 140px;" @onkeydown="(e) => OnResultKeyDown(e, row)">
                            <MudButton Variant="@(row.PassFail == "Pass" || row.PassFail == "P" ? Variant.Filled : Variant.Outlined)"
                                       Color="@(row.PassFail == "Pass" || row.PassFail == "P" ? Color.Success : Color.Default)"
                                       StartIcon="@(row.PassFail == "Pass" || row.PassFail == "P" ? Icons.Material.Filled.Check : null)"
                                       OnClick="() => TogglePass(row)"
                                       Class="btn-pass">
                                Pass
                            </MudButton>
                            <MudButton Variant="@(row.PassFail == "Fail" || row.PassFail == "F" ? Variant.Filled : Variant.Outlined)"
                                       Color="@(row.PassFail == "Fail" || row.PassFail == "F" ? Color.Error : Color.Default)"
                                       StartIcon="@(row.PassFail == "Fail" || row.PassFail == "F" ? Icons.Material.Filled.Close : null)"
                                       OnClick="() => ToggleFail(row)"
                                       Class="btn-fail">
                                Fail
                            </MudButton>
                        </MudButtonGroup>
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: center;">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveRow(row)" tabindex="-1" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>

        <!-- Mobile Card View (Cell Phone Optimization) -->
        <div class="d-block d-md-none">
            @for (int i = 0; i < scoreRows.Count; i++)
            {
                var index = i;
                var row = scoreRows[index];
                <MudPaper Class="pa-4 mb-3" Elevation="2" Style="border-left: 4px solid var(--mud-palette-primary);">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Officer #@(index + 1)</MudChip>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveRow(row)" tabindex="-1" />
                    </MudStack>

                    <MudStack Spacing="3">
                        <MudAutocomplete T="EmployeeSearchResultDto"
                                         Value="row.SelectedEmployee"
                                         ValueChanged="@(e => OnEmployeeSelected(row, e))"
                                         SearchFunc="SearchEmployees"
                                         ToStringFunc="@(e => e == null ? string.Empty : (string.IsNullOrWhiteSpace(e.BadgeNumber) ? e.FormattedName : $"{e.FormattedName} (#{e.BadgeNumber})"))"
                                         Label="Officer Name / Badge #"
                                         Placeholder="Tap to search officer"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         @onkeydown="@(e => OnCourseKeyDown(e, row))" />

                        @if (row.SelectedEmployee != null && !string.IsNullOrEmpty(row.SelectedEmployee.Unit))
                        {
                            <MudTextField Value="@row.SelectedEmployee.Unit" Label="Unit" Variant="Variant.Outlined" ReadOnly="true" Margin="Margin.Dense" />
                        }

                        <MudAutocomplete T="RangeCourseDTO"
                                         Value="@(availableCourses.FirstOrDefault(c => c.CourseID == row.CourseID))"
                                         ValueChanged="@(c => OnCourseSelected(row, c))"
                                         SearchFunc="SearchCourses"
                                         ToStringFunc="@(c => c == null ? string.Empty : (!string.IsNullOrWhiteSpace(c.CourseCode) ? c.CourseCode : c.CourseName))"
                                         Label="Course of Fire"
                                         Placeholder="-- Select Course --"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         @onkeydown="@(e => OnCourseKeyDown(e, row))" />

                        @if (IsCourseP(row))
                        {
                            <MudPaper Class="pa-3 my-2" Elevation="0" Style="background-color: var(--mud-palette-background-grey); border-radius: 6px;">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap" Style="gap: 8px;">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" /> Range Skills (P-Course)
                                    </MudText>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="@(() => OpenSkillsModal(row))">
                                        Skills Modal (@row.SelectedSkillIDs.Count)
                                    </MudButton>
                                </MudStack>
                                <MudSelect T="int"
                                           MultiSelection="true"
                                           SelectAll="true"
                                           SelectAllText="Select All"
                                           PopoverClass="skills-popover-menu"
                                           Label="Range Skills"
                                           Placeholder="Tap to select skills"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           SelectedValues="@row.SelectedSkillIDs"
                                           SelectedValuesChanged="@(vals => row.SelectedSkillIDs = vals.ToList())"
                                           MultiSelectionTextFunc="@(selectedList => GetSkillsSelectionSummary(selectedList))">
                                    @foreach (var skill in availableRangeSkills)
                                    {
                                        <MudSelectItem T="int" Value="@skill.RangeSkillID">@skill.SkillName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudPaper>
                        }

                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudAutocomplete T="string"
                                                 Value="row.SelectedMake"
                                                 ValueChanged="@(m => OnMakeSelected(row, m))"
                                                 SearchFunc="@((val, ct) => SearchRowMakes(row, val, ct))"
                                                 Label="Make"
                                                 Variant="Variant.Outlined"
                                                 Dense="true"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="true"
                                                 CoerceValue="false"
                                                 SelectValueOnTab="true"
                                                 MinCharacters="0"
                                                 Disabled="@(row.SelectedEmployee == null || row.IsLoadingFirearms)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudAutocomplete T="string"
                                                 Value="row.SelectedModel"
                                                 ValueChanged="@(m => OnModelSelected(row, m))"
                                                 SearchFunc="@((val, ct) => SearchRowModels(row, val, ct))"
                                                 Label="Model"
                                                 Variant="Variant.Outlined"
                                                 Dense="true"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="true"
                                                 CoerceValue="false"
                                                 SelectValueOnTab="true"
                                                 MinCharacters="0"
                                                 Disabled="@(row.SelectedEmployee == null || row.IsLoadingFirearms)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudAutocomplete T="string"
                                                 Value="row.SelectedSerial"
                                                 ValueChanged="@(s => OnSerialSelected(row, s))"
                                                 SearchFunc="@((val, ct) => SearchRowSerials(row, val, ct))"
                                                 Label="Serial #"
                                                 Variant="Variant.Outlined"
                                                 Dense="true"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="true"
                                                 CoerceValue="false"
                                                 SelectValueOnTab="true"
                                                 MinCharacters="0"
                                                 Disabled="@(row.SelectedEmployee == null || row.IsLoadingFirearms)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudAutocomplete T="string"
                                                 Value="row.SelectedCaliber"
                                                 ValueChanged="@(c => OnCaliberSelected(row, c))"
                                                 SearchFunc="@((val, ct) => SearchRowCalibers(row, val, ct))"
                                                 Label="Caliber"
                                                 Variant="Variant.Outlined"
                                                 Dense="true"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="true"
                                                 CoerceValue="false"
                                                 SelectValueOnTab="true"
