    private async Task LoadReferenceDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var coursesTask = service.GetRangeCoursesAsync();
            var employeesTask = service.SearchEmployeesAsync(new EmployeeSearchRequestDto());
            var rangeOfficersTask = codeTableService.GetRangeOfficersAsync();
            var rangeSkillsTask = codeTableService.GetRangeSkillsAsync();
            var makesTask = codeTableService.GetMakesAsync();
            var statusesTask = codeTableService.GetStatusesAsync();

            await Task.WhenAll(coursesTask, employeesTask, rangeOfficersTask, rangeSkillsTask, makesTask, statusesTask);

            var courses = await coursesTask;
            availableCourses = courses != null
                ? courses.Where(c => c.IsActive).OrderBy(c => c.SortOrder ?? int.MaxValue).ThenBy(c => c.CourseName).ToList()
                : new();

            var employees = await employeesTask;
            allEmployees = employees != null
                ? employees.Where(IsActiveOrRetired).OrderBy(e => e.LastName).ThenBy(e => e.FirstName).ToList()
                : new();

            var rangeOfficers = await rangeOfficersTask;
            availableRangeOfficers = rangeOfficers != null
                ? rangeOfficers.Where(ro => ro.IsActive).OrderBy(ro => ro.OfficerName).ToList()
                : new();

            var rangeSkills = await rangeSkillsTask;
            availableRangeSkills = rangeSkills != null
                ? rangeSkills.OrderBy(rs => rs.SkillName).ToList()
                : new();

            var makes = await makesTask;
            availableMakes = makes != null
                ? makes.OrderBy(m => m.MakeName).ToList()
                : new();

            var statuses = await statusesTask;
            availableStatuses = statuses != null
                ? statuses.OrderBy(s => s.StatusDescription ?? s.StatusCode).ToList()
                : new();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading range reference options.");
            errorMessage = $"Failed to load reference data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

