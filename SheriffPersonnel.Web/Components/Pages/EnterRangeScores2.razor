@page "/enterrangescores2"
@using System.Security.Claims
@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Shared.Models
@using SheriffPersonnel.Web.Services
@attribute [Authorize(Roles = "Range Scores")]

@inject SearchService service
@inject CodeTableService codeTableService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ILogger<EnterRangeScores2> logger

<PageTitle>Enter Range Scores 2</PageTitle>

<style>
    /* Fix MudSelect popover dropdown width & checkbox spacing */
    .skills-popover-menu.mud-popover,
    .mud-popover:has(.skills-popover-menu) {
        min-width: 260px !important;
        max-width: 340px !important;
        width: auto !important;
    }
    .skills-popover-menu .mud-list-item,
    .mud-popover .mud-list-item {
        padding: 4px 8px !important;
        min-height: 32px !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox,
    .skills-popover-menu .mud-list-item .mud-checkbox.mud-input-content-placement-end,
    .mud-popover .mud-list-item .mud-checkbox,
    .mud-popover .mud-list-item .mud-checkbox.mud-input-content-placement-end {
        gap: 6px !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-button-root,
    .mud-popover .mud-list-item .mud-checkbox .mud-button-root {
        padding: 0 !important;
        margin: 0 !important;
        width: 22px !important;
        height: 22px !important;
        min-width: 22px !important;
        min-height: 22px !important;
        flex-shrink: 0 !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-icon-root,
    .mud-popover .mud-list-item .mud-checkbox .mud-icon-root {
        font-size: 1.25rem !important;
        width: 1.25rem !important;
        height: 1.25rem !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-checkbox-text,
    .skills-popover-menu .mud-list-item .mud-checkbox > .mud-typography,
    .skills-popover-menu .mud-list-item .mud-checkbox.mud-input-content-placement-end > .mud-typography,
    .mud-popover .mud-list-item .mud-checkbox .mud-checkbox-text,
    .mud-popover .mud-list-item .mud-checkbox > .mud-typography,
    .mud-popover .mud-list-item .mud-checkbox.mud-input-content-placement-end > .mud-typography {
        padding-left: 0 !important;
        margin-left: 0 !important;
        font-size: 0.875rem !important;
        line-height: 1.25 !important;
        white-space: normal !important;
        word-break: break-word !important;
        flex-grow: 1 !important;
        text-align: left !important;
    }

    .mobile-score-card {
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
    }
</style>

<div class="mobile-score-card">
    <div class="mb-4">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-1">Enter Range Scores 2</MudText>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close" CloseIconClicked="() => errorMessage = null">
            @errorMessage
        </MudAlert>
    }

    <!-- Top Area: Range Event Details -->
    <MudPaper Class="pa-4 pa-sm-5 mb-4" Elevation="3" Style="border-top: 4px solid var(--mud-palette-primary);">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6" Class="d-flex align-center" Style="gap: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.EventNote" Color="Color.Primary" />
                1. Range Event Information
            </MudText>
            @if (currentRangeEventId.HasValue)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CheckCircle">
                    Event #@currentRangeEventId.Value Active
                </MudChip>
            }
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
            These details apply to each officer score saved below.
        </MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudDatePicker @ref="eventDatePicker"
                               @bind-Date="rangeDate"
                               Converter="@eventDateConverter"
                               Label="Event Date *"
                               Variant="Variant.Outlined"
                               DateFormat="MM/dd/yyyy"
                               Required="true"
                               Editable="true"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="RangeOfficerDTO"
                                 Value="selectedRangeOfficer"
                                 ValueChanged="OnRangeOfficerChanged"
                                 SearchFunc="SearchRangeOfficers"
                                 ToStringFunc="@(ro => ro == null ? string.Empty : ro.OfficerName)"
                                 Label="Range Officer *"
                                 Placeholder="Type or select Range Officer"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 CoerceValue="false"
                                 SelectValueOnTab="true"
                                 MinCharacters="0"
                                 Required="true"
                                 RequiredError="Range Officer is required" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Officer Scores Entry Form: One Officer at a Time -->
    <MudPaper Class="pa-4 pa-sm-5 mb-4" Elevation="3" Style="border-top: 4px solid var(--mud-palette-primary);">
        <div class="mb-3">
            <MudText Typo="Typo.h6" Class="d-flex align-center" Style="gap: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                2. Officer Scores
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Enter details for one officer, then tap Save Score.
            </MudText>
        </div>

        @if (isLoading)
        {
            <MudPaper Class="pa-6 d-flex justify-center align-center" Style="min-height: 150px;" Elevation="0">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Class="ml-3">Loading reference data...</MudText>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="3">
                <!-- Officer Autocomplete & Add Officer Button -->
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudAutocomplete T="EmployeeSearchResultDto"
                                         @ref="officerAutocomplete"
                                         Value="currentOfficer.SelectedEmployee"
                                         ValueChanged="OnEmployeeSelected"
                                         SearchFunc="SearchEmployees"
                                         ToStringFunc="@(e => FormatOfficerDisplay(e))"
                                         Label="Officer *"
                                         Placeholder="Tap to search name or unit"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         ShowProgressIndicator="true"
                                         Disabled="@isAddingEmployeeInline"
                                         Style="flex-grow: 1;" />
                        <MudTooltip Text="@(isAddingEmployeeInline ? "Cancel Add Officer" : "Add New Officer")">
                            <MudIconButton Icon="@(isAddingEmployeeInline ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
                                           Color="@(isAddingEmployeeInline ? Color.Secondary : Color.Primary)"
                                           Size="Size.Medium"
                                           OnClick="ToggleAddEmployeeInline"
                                           Class="mt-1"
                                           aria-label="@(isAddingEmployeeInline ? "Cancel add officer" : "Add officer")" />
                        </MudTooltip>
                    </MudStack>

                    <!-- Inline Add Officer Panel -->
                    <MudCollapse Expanded="isAddingEmployeeInline">
                        <MudPaper Class="pa-3 pa-sm-4 mt-2"
                                  Elevation="0"
                                  Style="background-color: var(--mud-palette-background-grey); border-radius: 8px; border: 1.5px solid var(--mud-palette-primary);">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Color="Color.Primary" Class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" Class="mr-1" />
                                    Add New Officer
                                </MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="CancelAddEmployeeInline"
                                               aria-label="Cancel add officer" />
                            </MudStack>

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="inlineEmployeeLastName"
                                                  Label="Last Name *"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="Last Name is required" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="inlineEmployeeFirstName"
                                                  Label="First Name *"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="First Name is required" />
                                </MudItem>
                            </MudGrid>

                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           Size="Size.Medium"
                                           OnClick="CancelAddEmployeeInline"
                                           Disabled="@isSavingInlineEmployee">
                                    Cancel
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           Size="Size.Medium"
                                           StartIcon="@Icons.Material.Filled.Check"
                                           OnClick="SaveInlineEmployeeAsync"
                                           Disabled="@isSavingInlineEmployee">
                                    @if (isSavingInlineEmployee)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <span>Saving Officer...</span>
                                    }
                                    else
                                    {
                                        <span>Save & Select Officer</span>
                                    }
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudCollapse>
                </div>

                <!-- Course Autocomplete -->
                <div>
                    <MudAutocomplete T="RangeCourseDTO"
                                     Value="@(availableCourses.FirstOrDefault(c => c.CourseID == currentOfficer.CourseID))"
                                     ValueChanged="OnCourseSelected"
                                     SearchFunc="SearchCourses"
                                     ToStringFunc="@(c => c == null ? string.Empty : c.FormattedCourse)"
                                     Label="Course of Fire *"
                                     Placeholder="-- Select Course --"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="false"
                                     SelectValueOnTab="true"
                                     MinCharacters="0" />
                </div>

                <!-- Range Skills (shown when Course is "P") -->
                @if (IsCourseP())
                {
                    <MudPaper Class="pa-3" Elevation="0" Style="background-color: var(--mud-palette-background-grey); border-radius: 8px; border: 1px dashed var(--mud-palette-primary);">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap" Style="gap: 8px;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" />
                                Range Skills (P-Course)
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       OnClick="OpenSkillsModal">
                                Skills Modal (@currentOfficer.SelectedSkillIDs.Count)
                            </MudButton>
                        </MudStack>
                        <MudSelect T="int"
                                   @ref="skillsSelectRef"
                                   MultiSelection="true"
                                   SelectAll="true"
                                   SelectAllText="Select All"
                                   PopoverClass="skills-popover-menu"
                                   Label="Range Skills"
                                   Placeholder="Tap to select skills"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true"
                                   SelectedValues="@currentOfficer.SelectedSkillIDs"
                                   SelectedValuesChanged="@(vals => currentOfficer.SelectedSkillIDs = vals.ToList())"
                                   MultiSelectionTextFunc="@(selectedList => GetSkillsSelectionSummary(selectedList))">
                            @foreach (var skill in availableRangeSkills)
                            {
                                <MudSelectItem T="int" Value="@skill.RangeSkillID">@skill.SkillName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudPaper>
                }

                <!-- Firearm Serial Number & Summary -->
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudAutocomplete T="string"
                                         Value="currentOfficer.SelectedSerial"
                                         ValueChanged="OnSerialSelected"
                                         SearchFunc="SearchRowSerials"
                                         Label="Serial # *"
                                         Placeholder="Select Serial #"
                                         Variant="Variant.Outlined"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         SelectValueOnTab="true"
                                         MinCharacters="0"
                                         Disabled="@(currentOfficer.SelectedEmployee == null || currentOfficer.IsLoadingFirearms || isAddingFirearmInline)"
                                         Style="flex-grow: 1;" />
                        <MudTooltip Text="@(isAddingFirearmInline ? "Cancel Add Firearm" : "Add New Firearm for Officer")">
                            <MudIconButton Icon="@(isAddingFirearmInline ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
                                           Color="@(isAddingFirearmInline ? Color.Secondary : Color.Primary)"
                                           Size="Size.Medium"
                                           OnClick="ToggleAddFirearmInline"
                                           Disabled="@(currentOfficer.SelectedEmployee == null || currentOfficer.IsLoadingFirearms)"
                                           Class="mt-1"
                                           aria-label="@(isAddingFirearmInline ? "Cancel add firearm" : "Add firearm for officer")" />
                        </MudTooltip>
                    </MudStack>

                    @if (!isAddingFirearmInline && !string.IsNullOrWhiteSpace(GetFirearmSummary()))
                    {
                        <div class="mt-1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Firearm:</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@GetFirearmSummary()</MudText>
                        </div>
                    }

                    <!-- Inline Add Firearm Panel -->
                    <MudCollapse Expanded="isAddingFirearmInline">
                        <MudPaper Class="pa-3 pa-sm-4 mt-2"
                                  Elevation="0"
                                  Style="background-color: var(--mud-palette-background-grey); border-radius: 8px; border: 1.5px solid var(--mud-palette-primary);">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Color="Color.Primary" Class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Class="mr-1" />
                                    Add New Firearm for Officer
                                </MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="CancelAddFirearmInline"
                                               aria-label="Cancel add firearm" />
                            </MudStack>

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="MakesDto"
                                                     Value="selectedInlineMake"
                                                     ValueChanged="OnInlineMakeChanged"
                                                     SearchFunc="SearchInlineMakes"
                                                     ToStringFunc="@(m => m == null ? string.Empty : m.MakeName)"
                                                     Label="Make"
                                                     Placeholder="-- Select Make --"
                                                     Variant="Variant.Outlined"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="true"
                                                     CoerceValue="false"
                                                     SelectValueOnTab="true"
                                                     MinCharacters="0" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="inlineFirearm.ModelNumber"
                                                  Label="Model Number *"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="Model number is required" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="inlineFirearm.SerialNumber"
                                                  Label="Serial Number *"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="Serial number is required" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="inlineFirearm.Caliber"
                                                  Label="Caliber *"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="Caliber is required" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="int"
                                               @bind-Value="inlineFirearm.StatusID"
                                               Label="Status *"
                                               Variant="Variant.Outlined"
                                               Required="true"
                                               RequiredError="Status is required">
                                        @foreach (var st in availableStatuses)
                                        {
                                            <MudSelectItem T="int" Value="@st.StatusID">@(st.StatusDescription ?? st.StatusCode)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6" Class="d-flex align-center">
                                    <MudSwitch T="bool"
                                               @bind-Value="inlineFirearm.Optic"
                                               Label="Optic (Red Dot / Scope)"
                                               Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="inlineFirearm.Notes"
                                                  Label="Notes"
                                                  Variant="Variant.Outlined"
                                                  Lines="2" />
                                </MudItem>
                            </MudGrid>

                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           Size="Size.Medium"
                                           OnClick="CancelAddFirearmInline"
                                           Disabled="@isSavingInlineFirearm">
                                    Cancel
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           Size="Size.Medium"
                                           StartIcon="@Icons.Material.Filled.Check"
                                           OnClick="SaveInlineFirearmAsync"
                                           Disabled="@isSavingInlineFirearm">
                                    @if (isSavingInlineFirearm)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <span>Saving Firearm...</span>
                                    }
                                    else
                                    {
                                        <span>Save & Select Firearm</span>
                                    }
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudCollapse>
                </div>

                <!-- Pass / Fail Result Switch -->
                <div>
                    <MudText Typo="Typo.caption" Class="d-block mb-1 font-weight-bold">Result *:</MudText>
                    <div class="d-flex align-center justify-space-between pa-2 px-3" style="border: 1px solid var(--mud-palette-lines-inputs); border-radius: 4px; background-color: var(--mud-palette-background-grey);">
                        <MudText Typo="Typo.body1" Style="font-weight: 500;">
                            Pass / Fail
                        </MudText>
                        <MudSwitch T="bool"
                                   Value="@IsPass"
                                   ValueChanged="OnPassFailSwitchChanged"
                                   Color="Color.Success"
                                   UncheckedColor="Color.Error"
                                   ThumbIcon="@(IsPass ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                   Size="Size.Large"
                                   aria-label="Pass or Fail switch">
                            <MudChip T="string"
                                     Color="@(IsPass ? Color.Success : Color.Error)"
                                     Variant="Variant.Filled"
                                     Size="Size.Small"
                                     Class="font-weight-bold ml-1"
                                     Style="min-width: 60px; text-align: center; justify-content: center;">
                                @(IsPass ? "PASS" : "FAIL")
                            </MudChip>
                        </MudSwitch>
                    </div>
                </div>

                <!-- Save Score Button -->
                <div class="pt-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Large"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveCurrentOfficerScoreAsync"
                               Disabled="@isSavingOfficer"
                               Style="min-height: 52px; font-weight: 700; font-size: 1.05rem;">
                        @if (isSavingOfficer)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Saving Score...</span>
                        }
                        else
                        {
                            <span>Save Score</span>
                        }
                    </MudButton>
                </div>
            </MudStack>
        }
    </MudPaper>

    <!-- Saved Officers List -->
    <MudPaper Class="pa-4 pa-sm-5 mb-6" Elevation="3">
        <div class="mb-3">
            <MudText Typo="Typo.h6" Class="d-flex align-center" Style="gap: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" />
                Saved Officers (@savedOfficers.Count)
            </MudText>
        </div>

        @if (!savedOfficers.Any())
        {
            <MudPaper Class="pa-4 text-center" Elevation="0" Style="background-color: var(--mud-palette-background-grey); border-radius: 8px;">
                <MudText Color="Color.Secondary" Typo="Typo.body2">
                    No officers saved yet for this session. Enter officer details above and tap <strong>Save Score</strong>.
                </MudText>
            </MudPaper>
        }
        else
        {
            <MudList T="SavedOfficerItem" Dense="true" ReadOnly="true" Class="pa-0">
                @foreach (var item in savedOfficers.AsEnumerable().Reverse())
                {
                    <MudListItem T="SavedOfficerItem" Class="px-2 py-2" Style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                        <div class="d-flex justify-space-between align-center w-100 flex-wrap" style="gap: 8px;">
                            <div style="min-width: 0;">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                    @item.OfficerName
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Course: @item.CourseName
                                </MudText>
                            </div>
                            <div>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(item.PassFail == "Pass" || item.PassFail == "P" ? Color.Success : Color.Error)"
                                         Variant="Variant.Filled">
                                    @(item.PassFail == "Pass" || item.PassFail == "P" ? "PASS" : "FAIL")
                                </MudChip>
                            </div>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>
</div>

@code {
    private MudDatePicker? eventDatePicker;
    private MudAutocomplete<EmployeeSearchResultDto>? officerAutocomplete;
    private MudSelect<int>? skillsSelectRef;

    private DateTime? rangeDate = DateTime.Today;
    private MudBlazor.IReversibleConverter<DateTime?, string> eventDateConverter = new TwoDigitYearDateConverter();

    public class TwoDigitYearDateConverter : MudBlazor.IReversibleConverter<DateTime?, string>
    {
        public Func<DateTime?, string> SetFunc { get; set; } = date => date?.ToString("MM/dd/yyyy") ?? string.Empty;
        public Func<string, DateTime?> GetFunc { get; set; } = text => ParseTwoDigitYearDate(text);

        public string Convert(DateTime? value) => value?.ToString("MM/dd/yyyy") ?? string.Empty;
        public DateTime? ConvertBack(string value) => ParseTwoDigitYearDate(value);
        public DateTime? Get(string value) => ParseTwoDigitYearDate(value);
        public string Set(DateTime? value) => Convert(value);

        private static DateTime? ParseTwoDigitYearDate(string? text)
        {
            if (string.IsNullOrWhiteSpace(text)) return null;

            text = text.Trim();

            string[] formats = new[]
            {
                "MM/dd/yyyy", "M/d/yyyy", "MM-dd-yyyy", "M-d-yyyy",
                "MM/dd/yy",   "M/d/yy",   "MM-dd-yy",   "M-d-yy",
                "MMddyyyy",   "MMddyy",   "yyyy-MM-dd"
            };

            if (DateTime.TryParseExact(text, formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime parsedDate))
            {
                var parts = text.Split(new[] { '/', '-' });
                if (parts.Length == 3 && parts[2].Length == 2 && int.TryParse(parts[2], out int yy))
                {
                    int fullYear = (yy <= 79) ? 2000 + yy : 1900 + yy;
                    return new DateTime(fullYear, parsedDate.Month, parsedDate.Day);
                }
                if (parsedDate.Year < 100)
                {
                    int fullYear = (parsedDate.Year <= 79) ? 2000 + parsedDate.Year : 1900 + parsedDate.Year;
                    return new DateTime(fullYear, parsedDate.Month, parsedDate.Day);
                }
                return parsedDate;
            }

            if (DateTime.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime dt))
            {
                var parts = text.Split(new[] { '/', '-' });
                if (parts.Length == 3 && parts[2].Length == 2 && int.TryParse(parts[2], out int yy))
                {
                    int fullYear = (yy <= 79) ? 2000 + yy : 1900 + yy;
                    return new DateTime(fullYear, dt.Month, dt.Day);
                }
                if (dt.Year < 100)
                {
                    int fullYear = (dt.Year <= 79) ? 2000 + dt.Year : 1900 + dt.Year;
                    return new DateTime(fullYear, dt.Month, dt.Day);
                }
                return dt;
            }

            return null;
        }
    }

