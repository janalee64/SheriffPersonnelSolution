    private async Task SaveInlineFirearmAsync()
    {
        if (currentOfficer.SelectedEmployee == null || currentOfficer.SelectedEmployee.EmployeeID <= 0)
        {
            Snackbar.Add("Please select an officer before adding a firearm.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(inlineFirearm.SerialNumber))
        {
            Snackbar.Add("Serial number is required.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(inlineFirearm.ModelNumber))
        {
            Snackbar.Add("Model number is required.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(inlineFirearm.Caliber))
        {
            Snackbar.Add("Caliber is required.", Severity.Error);
            return;
        }

        if (inlineFirearm.StatusID <= 0)
        {
            Snackbar.Add("Status is required.", Severity.Error);
            return;
        }

        inlineFirearm.EmployeeID = currentOfficer.SelectedEmployee.EmployeeID;
        isSavingInlineFirearm = true;

        try
        {
            var created = await service.CreateFirearmAsync(inlineFirearm);
            if (created != null)
            {
                Snackbar.Add("Firearm record added successfully!", Severity.Success);

                var firearms = await service.GetFirearmsByEmployeeIdAsync(currentOfficer.SelectedEmployee.EmployeeID);
                currentOfficer.EmployeeFirearms = firearms != null ? firearms.ToList() : new List<FirearmsDto>();

                if (!string.IsNullOrWhiteSpace(created.SerialNumber))
                {
                    await OnSerialSelected(created.SerialNumber);
                }

                isAddingFirearmInline = false;
                inlineFirearm = new FirearmsDto();
                selectedInlineMake = null;
            }
            else
            {
                Snackbar.Add("Failed to create firearm record.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error creating firearm for employee {EmployeeID}", currentOfficer.SelectedEmployee.EmployeeID);
            Snackbar.Add($"Failed to save firearm: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSavingInlineFirearm = false;
            StateHasChanged();
        }
    }

