    private async Task SaveInlineEmployeeAsync()
    {
        if (string.IsNullOrWhiteSpace(inlineEmployeeLastName))
        {
            Snackbar.Add("Last Name is required.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(inlineEmployeeFirstName))
        {
            Snackbar.Add("First Name is required.", Severity.Error);
            return;
        }

        // Find StatusID for record with StatusCode "P"
        var pendingStatus = availableStatuses.FirstOrDefault(s => string.Equals(s.StatusCode?.Trim(), "P", StringComparison.OrdinalIgnoreCase));
        if (pendingStatus == null)
        {
            // Refresh availableStatuses from database via codeTableService just in case
            try
            {
                var refreshed = await codeTableService.GetStatusesAsync();
                if (refreshed != null)
                {
                    availableStatuses = refreshed.OrderBy(s => s.StatusDescription ?? s.StatusCode).ToList();
                    pendingStatus = availableStatuses.FirstOrDefault(s => string.Equals(s.StatusCode?.Trim(), "P", StringComparison.OrdinalIgnoreCase));
                }
            }
            catch (Exception ex)
            {
                logger.LogWarning(ex, "Failed to refresh statuses when looking for StatusCode 'P'.");
            }
        }

        if (pendingStatus == null)
        {
            Snackbar.Add("Unable to save officer: Status record with code 'P' (Pending) was not found in the Statuses table.", Severity.Error);
            return;
        }

        var newEmployee = new EmployeeDetailDto
        {
            LastName = inlineEmployeeLastName.Trim(),
            FirstName = inlineEmployeeFirstName.Trim(),
            EmployeeFlag = false, // IsSheriffEmployee column = 0 (false)
            StatusID = pendingStatus.StatusID,
            LastUserID = currentLoggedInUserId,
            LastUpdated = DateTime.Now
        };

        isSavingInlineEmployee = true;
        try
        {
            var created = await service.CreateEmployeeAsync(newEmployee);
            if (created != null && created.EmployeeID > 0)
            {
                Snackbar.Add($"Officer '{created.FirstName} {created.LastName}' added successfully!", Severity.Success);

                var searchDto = new EmployeeSearchResultDto
                {
                    EmployeeID = created.EmployeeID,
                    FirstName = created.FirstName ?? string.Empty,
                    LastName = created.LastName ?? string.Empty,
                    Status = created.StatusDescription ?? pendingStatus.StatusDescription ?? "Pending",
                    EmployeeFlag = false
                };

                // Add to allEmployees list and re-sort
                allEmployees.Add(searchDto);
                allEmployees = allEmployees
                    .OrderBy(e => e.LastName)
                    .ThenBy(e => e.FirstName)
                    .ToList();

                // Automatically select the newly created employee
                await OnEmployeeSelected(searchDto);

                isAddingEmployeeInline = false;
                inlineEmployeeLastName = string.Empty;
                inlineEmployeeFirstName = string.Empty;
            }
            else
            {
                Snackbar.Add("Failed to create employee record.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error creating employee on the fly.");
            Snackbar.Add($"Failed to save officer: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSavingInlineEmployee = false;
            StateHasChanged();
        }
    }

    private static bool IsActiveOrRetired(EmployeeSearchResultDto e)
    {
        if (e == null) return false;

        var status = e.Status ?? string.Empty;

        if (status.Contains("Inactive", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("Terminated", StringComparison.OrdinalIgnoreCase) ||
            status.Contains("Resigned", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "INACT", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "TERM", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (status.Contains("Retired", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "RET", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (e.InactiveDate.HasValue && e.InactiveDate.Value.Date <= DateTime.Today)
        {
            return false;
        }

        return true;
    }

    private Task<IEnumerable<EmployeeSearchResultDto>> SearchEmployees(string value, CancellationToken cancellationToken)
    {
        if (allEmployees == null || !allEmployees.Any())
        {
            return Task.FromResult(Enumerable.Empty<EmployeeSearchResultDto>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<EmployeeSearchResultDto>>(allEmployees);
        }

        var term = value.Trim();
        var filtered = allEmployees.Where(e =>
            (!string.IsNullOrEmpty(e.FormattedName) && e.FormattedName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.FirstName) && e.FirstName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.LastName) && e.LastName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.Unit) && e.Unit.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.BadgeNumber) && e.BadgeNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
        );

        return Task.FromResult(filtered);
    }

