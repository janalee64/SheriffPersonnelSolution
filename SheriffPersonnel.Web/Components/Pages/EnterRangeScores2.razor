    private string GetSkillsSelectionSummary(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any())
        {
            return "0 Skills";
        }

        var skillNames = new List<string>();
        foreach (var valStr in selectedValues)
        {
            if (int.TryParse(valStr, out int id))
            {
                var skill = availableRangeSkills.FirstOrDefault(s => s.RangeSkillID == id);
                if (skill != null)
                {
                    skillNames.Add(skill.SkillName);
                }
            }
        }

        if (!skillNames.Any()) return $"{selectedValues.Count} Skills";
        if (skillNames.Count == 1) return skillNames[0];
        return $"{skillNames.Count} Skills ({string.Join(", ", skillNames)})";
    }

    private async Task OpenSkillsModal()
    {
        var officerName = FormatOfficerDisplay(currentOfficer.SelectedEmployee);
        if (string.IsNullOrWhiteSpace(officerName)) officerName = "Officer";

        var parameters = new DialogParameters<SelectRangeSkillsModal>
        {
            { x => x.OfficerName, officerName },
            { x => x.AvailableSkills, availableRangeSkills },
            { x => x.SelectedSkillIDs, new HashSet<int>(currentOfficer.SelectedSkillIDs) }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SelectRangeSkillsModal>("Select Range Skills", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is List<int> selectedSkills)
        {
            currentOfficer.SelectedSkillIDs = selectedSkills;
            StateHasChanged();
        }
    }

    private async Task SaveCurrentOfficerScoreAsync()
    {
        errorMessage = null;

        if (rangeDate == null)
        {
            errorMessage = "Please enter a valid Range Event Date.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (selectedRangeOfficer == null || selectedRangeOfficer.RangeOfficerID <= 0 || string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName))
        {
            errorMessage = "Please select a Range Officer.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (currentOfficer.SelectedEmployee == null || currentOfficer.SelectedEmployee.EmployeeID <= 0)
        {
            errorMessage = "Please select an Officer.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        var officerName = FormatOfficerDisplay(currentOfficer.SelectedEmployee);
        if (string.IsNullOrWhiteSpace(officerName)) officerName = "Officer";

        if (!currentOfficer.CourseID.HasValue || currentOfficer.CourseID.Value <= 0)
        {
            errorMessage = $"Please select a Course of Fire for {officerName}.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(currentOfficer.SelectedMake))
        {
            errorMessage = $"Please select or enter a Firearm Make for {officerName}.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(currentOfficer.SelectedModel))
        {
            errorMessage = $"Please select or enter a Firearm Model for {officerName}.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(currentOfficer.SelectedSerial))
        {
            errorMessage = $"Please select or enter a Firearm Serial Number for {officerName}.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(currentOfficer.SelectedCaliber))
        {
            errorMessage = $"Please select or enter a Firearm Caliber for {officerName}.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(currentOfficer.PassFail))
        {
            errorMessage = $"Please select Pass or Fail result for {officerName}.";
            Snackbar.Add(errorMessage, Severity.Error);
            return;
        }

        isSavingOfficer = true;

        try
        {
            var eventDate = DateOnly.FromDateTime(rangeDate.Value);

            // Check if we need to create or link to a Range Event
            if (!currentRangeEventId.HasValue ||
                currentRangeEventDate != eventDate ||
                currentRangeOfficerId != selectedRangeOfficer.RangeOfficerID)
            {
                var rangeEventDto = new RangeEventDTO
                {
                    RangeDate = eventDate,
                    RangeOfficer = new RangeOfficer
                    {
                        RangeOfficerID = selectedRangeOfficer.RangeOfficerID,
                        OfficerName = string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName) ? "Unknown" : selectedRangeOfficer.OfficerName,
                        IsActive = selectedRangeOfficer.IsActive
                    }
                };

                var createdEvent = await service.CreateRangeEventAsync(rangeEventDto);
                if (createdEvent == null || createdEvent.RangeEventID <= 0)
                {
                    throw new Exception("Failed to create Range Event header record.");
                }

                currentRangeEventId = createdEvent.RangeEventID;
                currentRangeEventDate = eventDate;
                currentRangeOfficerId = selectedRangeOfficer.RangeOfficerID;
            }

            // Create Range Statistic record for this officer
            var statDto = new RangeStatisticDTO
            {
                RangeEventID = currentRangeEventId.Value,
                RangeDate = currentRangeEventDate.Value,
                EmployeeID = currentOfficer.SelectedEmployee.EmployeeID,
                FirearmID = currentOfficer.SelectedFirearmID,
                CourseID = currentOfficer.CourseID,
                RoundsFired = currentOfficer.RoundsFired,
                PassFail = string.IsNullOrWhiteSpace(currentOfficer.PassFail) ? "Pass" : currentOfficer.PassFail,
                SelectedSkillIDs = currentOfficer.SelectedSkillIDs?.ToList() ?? new List<int>()
            };

            var createdStat = await service.CreateRangeStatisticAsync(statDto);
            if (createdStat == null)
            {
                throw new Exception("Failed to save Range Statistic record for officer.");
            }

            // Resolve course display name
            var selectedCourse = availableCourses.FirstOrDefault(c => c.CourseID == currentOfficer.CourseID.Value);
            var courseDisplay = selectedCourse != null ? selectedCourse.FormattedCourse : $"Course #{currentOfficer.CourseID.Value}";

            // Add newly saved officer to simple list below
            savedOfficers.Add(new SavedOfficerItem
            {
                RangeStatisticID = createdStat.RangeID,
                OfficerName = officerName,
                CourseName = courseDisplay,
                PassFail = currentOfficer.PassFail,
                SavedAt = DateTime.Now
            });

            var successMessage = $"Saved: {officerName} — {courseDisplay} ({currentOfficer.PassFail.ToUpper()})";
            Snackbar.Add(successMessage, Severity.Success);

            // Clear entry fields ready for next officer
            currentOfficer = new OfficerScoreEntry
            {
                PassFail = "Pass"
            };
            CancelAddFirearmInline();
            CancelAddEmployeeInline();

            // Focus back on officer autocomplete for fast continuous entry
            if (officerAutocomplete != null)
            {
                await officerAutocomplete.FocusAsync();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving officer range score.");
            errorMessage = $"Error saving officer score: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isSavingOfficer = false;
        }
    }
}
