@page "/admin/users"
@page "/admin/user"
@using System.ComponentModel.DataAnnotations
@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Web.Services
@attribute [Authorize(Roles = "Administrator")]

@inject UserAdminService UserService
@inject SearchService SearchService
@inject IEntraService EntraService
@inject ISnackbar Snackbar
@inject ILogger<UserAdmin> Logger

<PageTitle>User Administration</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">User Administration</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Manage system users, Entra ID mappings, and role assignments.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateDialog">
        Add New User
    </MudButton>
</MudStack>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close" CloseIconClicked="() => errorMessage = null">
        @errorMessage
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="8" md="6">
            <MudTextField @bind-Value="searchString" Placeholder="Search users by name, UPN, Entra ID..." Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="4" md="6" Class="d-flex justify-end">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync" Disabled="@isLoading">
                Refresh
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="3">
    <MudTable Items="FilteredUsers" Hover="true" Striped="true" Loading="@isLoading" Filter="new Func<UserDTO, bool>(FilterUserPredicate)">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<UserDTO, object>(x => x.UserID)">ID</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<UserDTO, object>(x => x.DisplayName)">Display Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<UserDTO, object>(x => x.UserPrincipalName)">User Principal Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<UserDTO, object>(x => x.EntraObjectID ?? string.Empty)">Entra Object ID</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<UserDTO, object>(x => GetEmployee(x.EmployeeID ?? 0)?.FormattedName ?? x.EmployeeID?.ToString() ?? string.Empty)">Employee</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<UserDTO, object>(x => x.IsActive)">Status</MudTableSortLabel></MudTh>
            <MudTh>Assigned Roles</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.UserID</MudTd>
            <MudTd DataLabel="Display Name">
                <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.DisplayName</MudText>
            </MudTd>
            <MudTd DataLabel="User Principal Name">@context.UserPrincipalName</MudTd>
            <MudTd DataLabel="Entra Object ID">
                @if (!string.IsNullOrWhiteSpace(context.EntraObjectID))
                {
                    <MudText Typo="Typo.caption" Style="font-family: monospace;">@context.EntraObjectID</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Not linked</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Employee">
                @if (context.EmployeeID.HasValue)
                {
                    var emp = GetEmployee(context.EmployeeID.Value);
                    if (emp != null)
                    {
                        <MudTooltip Text="@($"Employee ID: #{context.EmployeeID}")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@emp.FormattedName</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">#@context.EmployeeID</MudChip>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">N/A</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Inactive</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Assigned Roles">
                @if (context.Roles != null && context.Roles.Any())
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var role in context.Roles)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">@role.RoleName</MudChip>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">No roles assigned</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudTooltip Text="Edit User">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditDialog(context)" aria-label="@($"Edit user {context.DisplayName}")" />
                </MudTooltip>
                <MudTooltip Text="Delete User">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => ConfirmDelete(context)" aria-label="@($"Delete user {context.DisplayName}")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 text-center">No user accounts found matching your query.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@* Add/Edit Dialog *@
<MudDialog @bind-Visible="isDialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(isEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" Class="mr-2" />
            @(isEditMode ? $"Edit User: {editingUser.DisplayName}" : "Add New User")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(dialogErrorMessage))
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" CloseIconClicked="() => dialogErrorMessage = null">
                @dialogErrorMessage
            </MudAlert>
        }
        <EditForm Model="userFormModel" OnValidSubmit="SaveUserAsync">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="EntraUserDto"
                                     Label="Display Name"
                                     Value="selectedEntraUser"
                                     ValueChanged="OnEntraUserSelected"
                                     SearchFunc="SearchEntraUsers"
                                     ToStringFunc="FormatEntraUserDisplay"
                                     Text="@userFormModel.DisplayName"
                                     TextChanged="OnDisplayNameChanged"
                                     Placeholder="Type to search Entra directory..."
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     ResetValueOnEmptyText="false"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     SelectValueOnTab="true"
                                     MinCharacters="2"
                                     ShowProgressIndicator="true"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                     Required="true"
                                     RequiredError="Display name is required"
                                     HelperText="Search Entra to auto-fill Principal Name and Entra ID">
                        <ItemTemplate Context="entraUser">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2"><b>@entraUser.DisplayName</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @entraUser.UserPrincipalName
                                    @if (!string.IsNullOrWhiteSpace(entraUser.JobTitle))
                                    {
                                        <span> &bull; @entraUser.JobTitle</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entraUser.Department))
                                    {
                                        <span> (@entraUser.Department)</span>
                                    }
                                </MudText>
                            </MudStack>
                        </ItemTemplate>
                        <NoItemsTemplate>
                            <MudText Typo="Typo.caption" Class="pa-2 text-muted">No Entra accounts found matching query</MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="userFormModel.UserPrincipalName" Label="User Principal Name (Email)" Variant="Variant.Outlined" Required="true" RequiredError="User principal name is required" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="userFormModel.EntraObjectID" Label="Entra Object ID" Variant="Variant.Outlined" HelperText="Entra ID GUID identifier" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="EmployeeSearchResultDto"
                                     Label="Employee"
                                     Value="selectedEmployee"
                                     ValueChanged="OnEmployeeChanged"
                                     SearchFunc="SearchEmployees"
                                     ToStringFunc="FormatEmployeeDisplay"
                                     Placeholder="Type name to filter..."
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="false"
                                     SelectValueOnTab="true"
                                     MinCharacters="0"
                                     ShowProgressIndicator="true"
                                     HelperText="Associated active employee record (optional)" />
                </MudItem>

                <MudItem xs="12">
                    <MudCheckBox T="bool" @bind-Value="userFormModel.IsActive" Label="User Account Active" Color="Color.Success" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Assign User Roles</MudText>
                    <MudPaper Class="pa-3" Outlined="true">
                        @if (availableRoles != null && availableRoles.Any())
                        {
                            <MudGrid>
                                @foreach (var role in availableRoles)
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudCheckBox T="bool" Value="@IsRoleSelected(role.RoleID)" ValueChanged="@((bool selected) => ToggleRoleSelection(role.RoleID, selected))" Color="Color.Primary">
                                            <b>@role.RoleName</b>
                                            @if (IsPersonnelViewRole(role))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Error" Class="ml-1 font-weight-bold">(Required)</MudText>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(role.RoleDescription))
                                            {
                                                <MudText Typo="Typo.caption" Class="d-block text-muted">@role.RoleDescription</MudText>
                                            }
                                        </MudCheckBox>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Loading available roles...</MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveUserAsync" Disabled="@isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* Delete Confirmation Dialog *@
<MudDialog @bind-Visible="isDeleteDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">Confirm Delete User</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete user account <b>@userToDelete?.DisplayName</b> (@userToDelete?.UserPrincipalName)?</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">This action will remove the user record and all associated role assignments.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => isDeleteDialogVisible = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteUserAsync" Disabled="@isDeleting">
            @if (isDeleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Deleting...</span>
            }
            else
            {
                <span>Delete</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string PersonnelViewRoleName = "Personnel View";

    private List<UserDTO> users = new();
    private List<RoleDTO> availableRoles = new();
    private List<EmployeeSearchResultDto> activeEmployees = new();
    private EmployeeSearchResultDto? selectedEmployee;
    private EntraUserDto? selectedEntraUser;
    private string searchString = string.Empty;
    private bool isLoading = false;
    private string? errorMessage;
    private string? dialogErrorMessage;

    // Add / Edit Dialog state
    private bool isDialogVisible = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private UserDTO editingUser = new();
    private UserFormModel userFormModel = new();
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    // Delete Dialog state
    private bool isDeleteDialogVisible = false;
    private bool isDeleting = false;
    private UserDTO? userToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var userListTask = UserService.GetUsersAsync();
            var roleListTask = UserService.GetRolesAsync();
            var activeEmployeesTask = SearchService.GetActiveEmployeesAsync();

            await Task.WhenAll(userListTask, roleListTask, activeEmployeesTask);

            users = (await userListTask).ToList();
            availableRoles = (await roleListTask).ToList();
            var empList = await activeEmployeesTask;
            activeEmployees = empList != null
                ? empList.OrderBy(e => e.LastName).ThenBy(e => e.FirstName).ToList()
                : new();

            if (!isEditMode && isDialogVisible)
            {
                var pv = GetPersonnelViewRole();
                if (pv != null && !userFormModel.RoleIDs.Contains(pv.RoleID))
                {
                    userFormModel.RoleIDs.Add(pv.RoleID);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load user administration data.");
            errorMessage = $"Error loading users or roles: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<UserDTO> FilteredUsers => users;

    private EmployeeSearchResultDto? GetEmployee(int employeeId)
    {
        return activeEmployees.FirstOrDefault(e => e.EmployeeID == employeeId);
    }

    private bool FilterUserPredicate(UserDTO user)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var term = searchString.Trim().ToLowerInvariant();
        var emp = user.EmployeeID.HasValue ? GetEmployee(user.EmployeeID.Value) : null;

        return (user.DisplayName?.ToLowerInvariant().Contains(term) ?? false) ||
               (user.UserPrincipalName?.ToLowerInvariant().Contains(term) ?? false) ||
               (user.EntraObjectID?.ToLowerInvariant().Contains(term) ?? false) ||
               (user.EmployeeID.HasValue && user.EmployeeID.Value.ToString().Contains(term)) ||
               (emp != null && (
                   (!string.IsNullOrEmpty(emp.FormattedName) && emp.FormattedName.ToLowerInvariant().Contains(term)) ||
                   (!string.IsNullOrEmpty(emp.FirstName) && emp.FirstName.ToLowerInvariant().Contains(term)) ||
                   (!string.IsNullOrEmpty(emp.LastName) && emp.LastName.ToLowerInvariant().Contains(term)) ||
                   (!string.IsNullOrEmpty(emp.BadgeNumber) && emp.BadgeNumber.ToLowerInvariant().Contains(term))
               )) ||
               (user.Roles != null && user.Roles.Any(r => r.RoleName.ToLowerInvariant().Contains(term)));
    }

    private async Task OpenCreateDialog()
    {
        isEditMode = false;
        dialogErrorMessage = null;
        selectedEmployee = null;
        selectedEntraUser = null;

        if (activeEmployees.Count == 0)
        {
            try
            {
                var empList = await SearchService.GetActiveEmployeesAsync();
                if (empList != null)
                {
                    activeEmployees = empList.OrderBy(e => e.LastName).ThenBy(e => e.FirstName).ToList();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to reload active employees.");
            }
        }

        var defaultRoleIds = new List<int>();
        var personnelViewRole = GetPersonnelViewRole();
        if (personnelViewRole != null)
        {
            defaultRoleIds.Add(personnelViewRole.RoleID);
        }

        userFormModel = new UserFormModel
        {
            IsActive = true,
            RoleIDs = defaultRoleIds,
            EmployeeID = null
        };
        isDialogVisible = true;
    }

    private async Task OpenEditDialog(UserDTO user)
    {
        isEditMode = true;
        dialogErrorMessage = null;
        editingUser = user;

        if (activeEmployees.Count == 0)
        {
            try
            {
                var empList = await SearchService.GetActiveEmployeesAsync();
                if (empList != null)
                {
                    activeEmployees = empList.OrderBy(e => e.LastName).ThenBy(e => e.FirstName).ToList();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to reload active employees.");
            }
        }

        selectedEmployee = user.EmployeeID.HasValue
            ? activeEmployees.FirstOrDefault(e => e.EmployeeID == user.EmployeeID.Value)
            : null;

        if (selectedEmployee == null && user.EmployeeID.HasValue)
        {
            try
            {
                var empDetail = await SearchService.GetEmployeeByIdAsync(user.EmployeeID.Value);
                if (empDetail != null)
                {
                    selectedEmployee = new EmployeeSearchResultDto
                    {
                        EmployeeID = empDetail.EmployeeID,
                        FirstName = empDetail.FirstName ?? string.Empty,
                        LastName = empDetail.LastName ?? string.Empty,
                        BadgeNumber = empDetail.BadgeNumber?.ToString() ?? string.Empty,
                        Status = empDetail.StatusDescription ?? string.Empty
                    };
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load employee details for Employee ID {EmployeeID}", user.EmployeeID.Value);
            }
        }

        userFormModel = new UserFormModel
        {
            UserID = user.UserID,
            DisplayName = user.DisplayName,
            UserPrincipalName = user.UserPrincipalName,
            EntraObjectID = user.EntraObjectID,
            EmployeeID = user.EmployeeID,
            IsActive = user.IsActive,
            RoleIDs = user.RoleIDs != null ? new List<int>(user.RoleIDs) : new List<int>()
        };
        selectedEntraUser = new EntraUserDto
        {
            Id = user.EntraObjectID ?? string.Empty,
            DisplayName = user.DisplayName,
            UserPrincipalName = user.UserPrincipalName
        };
        isDialogVisible = true;
    }

    private void CloseDialog()
    {
        isDialogVisible = false;
        dialogErrorMessage = null;
        selectedEmployee = null;
        selectedEntraUser = null;
    }

    private string FormatEntraUserDisplay(EntraUserDto? u)
    {
        if (u != null && !string.IsNullOrWhiteSpace(u.DisplayName))
        {
            return u.DisplayName;
        }
        return userFormModel?.DisplayName ?? string.Empty;
    }

    private void OnDisplayNameChanged(string val)
    {
        userFormModel.DisplayName = val ?? string.Empty;
        if (selectedEntraUser != null && selectedEntraUser.DisplayName != val)
        {
            selectedEntraUser = null;
        }
    }

    private void OnEntraUserSelected(EntraUserDto? entraUser)
    {
        selectedEntraUser = entraUser;
        if (entraUser != null)
        {
            userFormModel.DisplayName = entraUser.DisplayName ?? string.Empty;
            userFormModel.UserPrincipalName = !string.IsNullOrWhiteSpace(entraUser.UserPrincipalName)
                ? entraUser.UserPrincipalName
                : (entraUser.Mail ?? string.Empty);
            userFormModel.EntraObjectID = entraUser.Id ?? string.Empty;

            if (selectedEmployee == null && activeEmployees.Count > 0)
            {
                var matched = FindMatchingEmployee(entraUser);
                if (matched != null)
                {
                    OnEmployeeChanged(matched);
                }
            }
        }
    }

    private async Task<IEnumerable<EntraUserDto>> SearchEntraUsers(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2)
        {
            return Enumerable.Empty<EntraUserDto>();
        }

        try
        {
            return await EntraService.SearchUsersAsync(value.Trim(), cancellationToken);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to search Entra users for '{Query}'", value);
            return Enumerable.Empty<EntraUserDto>();
        }
    }

    private EmployeeSearchResultDto? FindMatchingEmployee(EntraUserDto entraUser)
    {
        if (string.IsNullOrWhiteSpace(entraUser.DisplayName)) return null;

        var nameParts = entraUser.DisplayName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (nameParts.Length >= 2)
        {
            var first = nameParts[0];
            var last = nameParts[^1];
            return activeEmployees.FirstOrDefault(e =>
                string.Equals(e.FirstName, first, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(e.LastName, last, StringComparison.OrdinalIgnoreCase));
        }

        return null;
    }

    private void OnEmployeeChanged(EmployeeSearchResultDto? emp)
    {
        selectedEmployee = emp;
        userFormModel.EmployeeID = emp?.EmployeeID;
    }

    private string FormatEmployeeDisplay(EmployeeSearchResultDto? emp)
    {
        if (emp == null) return string.Empty;
        return string.IsNullOrWhiteSpace(emp.BadgeNumber)
            ? emp.FormattedName
            : $"{emp.FormattedName} (#{emp.BadgeNumber})";
    }

    private Task<IEnumerable<EmployeeSearchResultDto>> SearchEmployees(string value, CancellationToken cancellationToken)
    {
        if (activeEmployees == null || activeEmployees.Count == 0)
        {
            return Task.FromResult(Enumerable.Empty<EmployeeSearchResultDto>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<EmployeeSearchResultDto>>(activeEmployees);
        }

        var term = value.Trim();
        var filtered = activeEmployees.Where(e =>
            (!string.IsNullOrEmpty(e.FormattedName) && e.FormattedName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.FirstName) && e.FirstName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.LastName) && e.LastName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.BadgeNumber) && e.BadgeNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            ($"{e.FirstName} {e.LastName}".Contains(term, StringComparison.OrdinalIgnoreCase))
        );

        return Task.FromResult(filtered);
    }

    private bool IsRoleSelected(int roleId)
    {
        return userFormModel.RoleIDs.Contains(roleId);
    }

    private void ToggleRoleSelection(int roleId, bool isSelected)
    {
        if (isSelected && !userFormModel.RoleIDs.Contains(roleId))
        {
            userFormModel.RoleIDs.Add(roleId);
            if (IsPersonnelViewRoleId(roleId))
            {
                dialogErrorMessage = null;
            }
        }
        else if (!isSelected && userFormModel.RoleIDs.Contains(roleId))
        {
            userFormModel.RoleIDs.Remove(roleId);
            if (IsPersonnelViewRoleId(roleId))
            {
                dialogErrorMessage = $"The '{PersonnelViewRoleName}' role is required and must be checked.";
            }
        }
    }

    private RoleDTO? GetPersonnelViewRole() =>
        availableRoles.FirstOrDefault(r => string.Equals(r.RoleName?.Trim(), PersonnelViewRoleName, StringComparison.OrdinalIgnoreCase));

    private bool IsPersonnelViewRole(RoleDTO role) =>
        string.Equals(role.RoleName?.Trim(), PersonnelViewRoleName, StringComparison.OrdinalIgnoreCase);

    private bool IsPersonnelViewRoleId(int roleId)
    {
        var pv = GetPersonnelViewRole();
        return pv != null && pv.RoleID == roleId;
    }

    private async Task SaveUserAsync()
    {
        dialogErrorMessage = null;

        if (string.IsNullOrWhiteSpace(userFormModel.DisplayName) || string.IsNullOrWhiteSpace(userFormModel.UserPrincipalName))
        {
            dialogErrorMessage = "Please fill out all required fields.";
            Snackbar.Add("Please fill out all required fields.", Severity.Warning);
            return;
        }

        if (availableRoles.Count == 0)
        {
            try
            {
                availableRoles = (await UserService.GetRolesAsync()).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to reload roles during user save.");
            }
        }

        var personnelViewRole = GetPersonnelViewRole();
        if (personnelViewRole != null && !userFormModel.RoleIDs.Contains(personnelViewRole.RoleID))
        {
            dialogErrorMessage = $"The '{PersonnelViewRoleName}' role is required and must be checked.";
            Snackbar.Add($"The '{PersonnelViewRoleName}' role is required.", Severity.Warning);
            return;
        }

        isSaving = true;

        try
        {
            var dto = new UserCreateUpdateDto
            {
                DisplayName = userFormModel.DisplayName.Trim(),
                UserPrincipalName = userFormModel.UserPrincipalName.Trim(),
                EntraObjectID = string.IsNullOrWhiteSpace(userFormModel.EntraObjectID) ? null : userFormModel.EntraObjectID.Trim(),
                EmployeeID = selectedEmployee != null ? selectedEmployee.EmployeeID : userFormModel.EmployeeID,
                IsActive = userFormModel.IsActive,
                RoleIDs = userFormModel.RoleIDs
            };

            if (isEditMode)
            {
                var updated = await UserService.UpdateUserAsync(userFormModel.UserID, dto);
                if (updated != null)
                {
                    Snackbar.Add($"User '{updated.DisplayName}' updated successfully.", Severity.Success);
                }
            }
            else
            {
                var created = await UserService.CreateUserAsync(dto);
                if (created != null)
                {
                    Snackbar.Add($"User '{created.DisplayName}' created successfully.", Severity.Success);
                }
            }

            isDialogVisible = false;
            selectedEmployee = null;
            selectedEntraUser = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving user.");
            Snackbar.Add($"Failed to save user: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete(UserDTO user)
    {
        userToDelete = user;
        isDeleteDialogVisible = true;
    }

    private async Task DeleteUserAsync()
    {
        if (userToDelete == null) return;

        isDeleting = true;

        try
        {
            var success = await UserService.DeleteUserAsync(userToDelete.UserID);
            if (success)
            {
                Snackbar.Add($"User '{userToDelete.DisplayName}' was deleted.", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add("Failed to delete user.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting user.");
            Snackbar.Add($"Error deleting user: {ex.Message}", Severity.Error);
        }
        finally
        {
            isDeleting = false;
            isDeleteDialogVisible = false;
            userToDelete = null;
        }
    }

    private class UserFormModel
    {
        public int UserID { get; set; }

        [Required(ErrorMessage = "Display name is required")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "User principal name is required")]
        [EmailAddress(ErrorMessage = "Invalid email address format")]
        public string UserPrincipalName { get; set; } = string.Empty;

        public string? EntraObjectID { get; set; }

        public int? EmployeeID { get; set; }

        public bool IsActive { get; set; } = true;

        public List<int> RoleIDs { get; set; } = new List<int>();
    }
}

