@page "/employee/trainings"
@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Web.Services
@inject SearchService service
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ILogger<EmployeeTrainingsTab> logger

@attribute [Authorize(Roles = "Administrator, Personnel View, Personnel Edit, Inventory, Range Statistics, Range Scores, Training, Equipment, SSN")]

<MudStack Spacing="4" Class="mt-4">
    @if (IsEdit && EmployeeId > 0)
    {
        <MudPaper Class="pa-6" Elevation="3">
            @if (isLoading)
            {
                <MudPaper Class="pa-6 d-flex justify-center align-center" Style="min-height: 200px;" Elevation="0">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                    <MudText Class="ml-4">Loading training records...</MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudText Typo="Typo.h6">Employee Training Records</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AccessTime" Size="Size.Medium">
                            Total Hours Completed: <b>@TotalHoursCompleted.ToString("N2")</b>
                        </MudChip>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Print" OnClick="OpenPrintWindow">
                            Print Trainings
                        </MudButton>
                        @if (CanEdit)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddTrainingForm">
                                Add Training Record
                            </MudButton>
                        }
                    </MudStack>
                </MudStack>

                <MudTable Items="trainings" Hover="true" Striped="true" Elevation="0" AllowUnsorted="true">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.SchoolName ?? string.Empty)">School / Provider</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.Location ?? string.Empty)">Location</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.Instructor ?? string.Empty)">Instructor</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.BeginDate ?? DateOnly.MinValue)">Dates</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.HoursCompleted ?? 0m)">Hours Completed</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.ExpireDate ?? DateOnly.MinValue)">Expire Date</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.OrderNumber ?? string.Empty)">Order Number</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.RegistrationCost)">Reg. Cost</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeTrainingsDto, object>(x => x.TravelCost)">Travel Cost</MudTableSortLabel></MudTh>
                        @if (CanEdit)
                        {
                            <MudTh>Actions</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate Context="trainingContext">
                        <MudTd DataLabel="School / Provider">@(string.IsNullOrWhiteSpace(trainingContext.SchoolName) ? "-" : trainingContext.SchoolName)</MudTd>
                        <MudTd DataLabel="Location">@(string.IsNullOrWhiteSpace(trainingContext.Location) ? "-" : trainingContext.Location)</MudTd>
                        <MudTd DataLabel="Instructor">@(string.IsNullOrWhiteSpace(trainingContext.Instructor) ? "-" : trainingContext.Instructor)</MudTd>
                        <MudTd DataLabel="Dates">
                            @if (trainingContext.BeginDate.HasValue || trainingContext.EndDate.HasValue)
                            {
                                @($"{trainingContext.BeginDate:MM/dd/yyyy} - {trainingContext.EndDate:MM/dd/yyyy}")
                            }
                            else
                            {
                                @("-")
                            }
                        </MudTd>
                        <MudTd DataLabel="Hours Completed">@(trainingContext.HoursCompleted.HasValue ? trainingContext.HoursCompleted.Value.ToString("F2") : "-")</MudTd>
                        <MudTd DataLabel="Expire Date">@(trainingContext.ExpireDate.HasValue ? trainingContext.ExpireDate.Value.ToString("MM/dd/yyyy") : "-")</MudTd>
                        <MudTd DataLabel="Order Number">@(string.IsNullOrWhiteSpace(trainingContext.OrderNumber) ? "-" : trainingContext.OrderNumber)</MudTd>
                        <MudTd DataLabel="Reg. Cost">@trainingContext.RegistrationCost.ToString("C2")</MudTd>
                        <MudTd DataLabel="Travel Cost">@trainingContext.TravelCost.ToString("C2")</MudTd>
                        @if (CanEdit)
                        {
                            <MudTd DataLabel="Actions">
                                <MudTooltip Text="Edit Training Record">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditTrainingForm(trainingContext))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete Training Record">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTrainingAsync(trainingContext.EmployeeTrainingID))" />
                                </MudTooltip>
                            </MudTd>
                        }
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center">No training records found for this employee.</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="3">
            <MudText Class="text-center text-muted">Training records can be added after saving the new employee.</MudText>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter] public int EmployeeId { get; set; }
    [Parameter] public bool IsEdit { get; set; } = true;
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public IEnumerable<TrainingSessionsDto>? AvailableTrainingSessions { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private List<EmployeeTrainingsDto> trainings = new();
    private bool isLoading = true;
    private int _lastLoadedEmployeeId;
    private bool _lastLoadedIsEdit;

    private decimal TotalHoursCompleted => trainings?.Sum(t => t.HoursCompleted ?? 0m) ?? 0m;

    protected override async Task OnInitializedAsync()
    {
        if (authenticationStateTask != null)
        {
            var authState = await authenticationStateTask;
            var user = authState?.User;
            bool hasView = user != null && (user.IsInRole("Personnel View") || user.IsInRole("Employee View"));
            bool hasEdit = user != null && (user.IsInRole("Personnel Edit") || user.IsInRole("Employee Edit"));
            var hasEditPermission = user != null && (hasView && hasEdit);
            CanEdit = CanEdit && hasEditPermission;
        }

        if (AvailableTrainingSessions == null)
        {
            AvailableTrainingSessions = await service.GetTrainingSessionsAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (authenticationStateTask != null)
        {
            var authState = await authenticationStateTask;
            var user = authState?.User;
            bool hasView = user != null && (user.IsInRole("Personnel View") || user.IsInRole("Employee View"));
            bool hasEdit = user != null && (user.IsInRole("Personnel Edit") || user.IsInRole("Employee Edit"));
            var hasEditPermission = user != null && (hasView && hasEdit);
            CanEdit = CanEdit && hasEditPermission;
        }

        if (IsEdit && EmployeeId > 0 && (EmployeeId != _lastLoadedEmployeeId || IsEdit != _lastLoadedIsEdit))
        {
            _lastLoadedEmployeeId = EmployeeId;
            _lastLoadedIsEdit = IsEdit;
            await LoadTrainingsAsync();
        }
    }

    private async Task LoadTrainingsAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetEmployeeTrainingsByEmployeeIdAsync(EmployeeId);
            trainings = result
                .OrderByDescending(t => t.BeginDate ?? DateOnly.MinValue)
                .ThenBy(t => t.SchoolName ?? string.Empty)
                .ToList();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading training records for employee {EmployeeID}.", EmployeeId);
            Snackbar.Add($"Failed to load training records: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenPrintWindow()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("open", $"/print/employee-trainings/{EmployeeId}", "_blank");
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to open print window for employee trainings.");
            Snackbar.Add("Could not open print window. Please check browser popup settings.", Severity.Error);
        }
    }

    private async Task OpenAddTrainingForm()
    {
        if (!CanEdit) return;

        var parameters = new DialogParameters<AddEmployeeTrainingModal>
        {
            { x => x.EmployeeId, EmployeeId },
            { x => x.TrainingRecord, new EmployeeTrainingsDto { EmployeeID = EmployeeId } },
            { x => x.AvailableTrainingSessions, AvailableTrainingSessions }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEmployeeTrainingModal>("Add Employee Training", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            AvailableTrainingSessions = await service.GetTrainingSessionsAsync();
            await LoadTrainingsAsync();
        }
    }

    private async Task OpenEditTrainingForm(EmployeeTrainingsDto trainingRecord)
    {
        if (!CanEdit) return;

        var parameters = new DialogParameters<AddEmployeeTrainingModal>
        {
            { x => x.EmployeeId, EmployeeId },
            { x => x.TrainingRecord, new EmployeeTrainingsDto
                {
                    EmployeeTrainingID = trainingRecord.EmployeeTrainingID,
                    EmployeeID = trainingRecord.EmployeeID,
                    TrainingSessionID = trainingRecord.TrainingSessionID,
                    HoursCompleted = trainingRecord.HoursCompleted,
                    ExpireDate = trainingRecord.ExpireDate,
                    OrderNumber = trainingRecord.OrderNumber,
                    RegistrationCost = trainingRecord.RegistrationCost,
                    TravelCost = trainingRecord.TravelCost,
                    LastUserID = trainingRecord.LastUserID,
                    LastUpdated = trainingRecord.LastUpdated,
                    SchoolName = trainingRecord.SchoolName,
                    Location = trainingRecord.Location,
                    Instructor = trainingRecord.Instructor,
                    BeginDate = trainingRecord.BeginDate,
                    EndDate = trainingRecord.EndDate,
                    TrainingSchoolID = trainingRecord.TrainingSchoolID,
                    SessionHours = trainingRecord.SessionHours
                }
            },
            { x => x.AvailableTrainingSessions, AvailableTrainingSessions }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddEmployeeTrainingModal>("Edit Employee Training", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            AvailableTrainingSessions = await service.GetTrainingSessionsAsync();
            await LoadTrainingsAsync();
        }
    }

    private async Task DeleteTrainingAsync(int employeeTrainingId)
    {
        if (!CanEdit) return;

        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            "Are you sure you want to delete this training record?",
            yesText: "Delete", cancelText: "Cancel");

        if (confirm != true) return;

        try
        {
            var success = await service.DeleteEmployeeTrainingAsync(employeeTrainingId);
            if (success)
            {
                Snackbar.Add("Training record deleted successfully!", Severity.Success);
                await LoadTrainingsAsync();
            }
            else
            {
                Snackbar.Add("Failed to delete training record.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error deleting training record.");
            Snackbar.Add($"Error deleting training record: {ex.Message}", Severity.Error);
        }
    }
}
