@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Shared.Models
@using SheriffPersonnel.Web.Services
@inject SearchService service
@inject CodeTableService codeTableService
@inject ISnackbar Snackbar
@inject ILogger<AddRangeStatisticModal> logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(RangeStat.RangeID == 0 ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-2" />
            @(RangeStat.RangeID == 0 ? "Add Range Statistic" : "Edit Range Statistic")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="RangeStat" OnValidSubmit="SaveRangeStatAsync">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="rangeDate"
                                   Label="Range Date *"
                                   Variant="Variant.Outlined"
                                   DateFormat="MM/dd/yyyy"
                                   Required="true"
                                   RequiredError="Range Date is required"
                                   Editable="true"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="RangeOfficerDTO"
                                     Value="selectedRangeOfficer"
                                     ValueChanged="OnRangeOfficerChanged"
                                     SearchFunc="SearchRangeOfficers"
                                     ToStringFunc="@(ro => ro == null ? string.Empty : ro.OfficerName)"
                                     Label="Range Officer *"
                                     Placeholder="Type or select Range Officer"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="false"
                                     SelectValueOnTab="true"
                                     MinCharacters="0"
                                     Required="true"
                                     RequiredError="Range Officer is required" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="RangeStat.CourseID" Label="Range Course *" Variant="Variant.Outlined" Clearable="true" Required="true" RequiredError="Range Course is required">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- Select Course --</MudSelectItem>
                        @foreach (var course in FilteredCourses)
                        {
                            <MudSelectItem T="int?" Value="@course.CourseID">@course.FormattedCourse</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="RangeStat.FirearmID" Label="Firearm *" Variant="Variant.Outlined" Clearable="true" Required="true" RequiredError="Firearm is required">
                        <MudSelectItem T="int?" Value="@((int?)null)">-- Select Firearm --</MudSelectItem>
                        @if (AvailableFirearms != null)
                        {
                            @foreach (var firearm in AvailableFirearms)
                            {
                                var label = $"{firearm.MakeName} {firearm.ModelNumber} (S/N: {firearm.SerialNumber})".Trim();
                                <MudSelectItem T="int?" Value="@firearm.FirearmID">@label</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="RangeStat.PassFail" Label="Pass / Fail Result *" Variant="Variant.Outlined" Clearable="true" Required="true" RequiredError="Pass / Fail Result is required">
                        <MudSelectItem T="string" Value="@((string?)null)">-- Select Result --</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Pass")">Pass</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Fail")">Fail</MudSelectItem>
                        <MudSelectItem T="string" Value="@("N/A")">N/A</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel" Disabled="@isSaving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="SaveRangeStatAsync" Disabled="@isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int EmployeeId { get; set; }

    [Parameter]
    public RangeStatisticDTO RangeStat { get; set; } = new();

    [Parameter]
    public IEnumerable<RangeCourseDTO>? AvailableCourses { get; set; }

    [Parameter]
    public IEnumerable<RangeEventDTO>? AvailableEvents { get; set; }

    [Parameter]
    public IEnumerable<FirearmsDto>? AvailableFirearms { get; set; }

    private DateTime? rangeDate = DateTime.Today;
    private RangeOfficerDTO? selectedRangeOfficer;
    private List<RangeOfficerDTO> availableRangeOfficers = new();
    private bool isSaving = false;

    private IEnumerable<RangeCourseDTO> FilteredCourses =>
        AvailableCourses?
            .Where(c => c.IsActive || c.CourseID == RangeStat.CourseID)
            .OrderBy(c => c.SortOrder ?? int.MaxValue)
            .ThenBy(c => c.CourseName)
        ?? Enumerable.Empty<RangeCourseDTO>();

    protected override async Task OnInitializedAsync()
    {
        NormalizePassFail();
        InitDate();
        if (AvailableCourses == null)
        {
            try
            {
                AvailableCourses = await service.GetRangeCoursesAsync();
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error loading range courses in AddRangeStatisticModal.");
            }
        }
        if ((AvailableFirearms == null || !AvailableFirearms.Any()) && EmployeeId > 0)
        {
            try
            {
                AvailableFirearms = await service.GetFirearmsByEmployeeIdAsync(EmployeeId);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error loading firearms in AddRangeStatisticModal.");
            }
        }
        await LoadRangeOfficersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        NormalizePassFail();
        InitDate();
    }

    private void NormalizePassFail()
    {
        if (string.Equals(RangeStat.PassFail, "P", StringComparison.OrdinalIgnoreCase))
        {
            RangeStat.PassFail = "Pass";
        }
        else if (string.Equals(RangeStat.PassFail, "F", StringComparison.OrdinalIgnoreCase))
        {
            RangeStat.PassFail = "Fail";
        }
    }

    private void InitDate()
    {
        if (RangeStat.RangeDate.HasValue)
        {
            rangeDate = RangeStat.RangeDate.Value.ToDateTime(TimeOnly.MinValue);
        }
        else if (rangeDate == null)
        {
            rangeDate = DateTime.Today;
        }
    }

    private async Task LoadRangeOfficersAsync()
    {
        try
        {
            var officers = await codeTableService.GetRangeOfficersAsync();
            availableRangeOfficers = officers != null
                ? officers.Where(ro => ro.IsActive).OrderBy(ro => ro.OfficerName).ToList()
                : new List<RangeOfficerDTO>();

            if (selectedRangeOfficer == null && RangeStat.RangeEventID > 0)
            {
                if (AvailableEvents != null)
                {
                    var existingEvent = AvailableEvents.FirstOrDefault(x => x.RangeEventID == RangeStat.RangeEventID);
                    if (existingEvent?.RangeOfficer != null)
                    {
                        selectedRangeOfficer = availableRangeOfficers.FirstOrDefault(ro => ro.RangeOfficerID == existingEvent.RangeOfficer.RangeOfficerID)
                            ?? new RangeOfficerDTO
                            {
                                RangeOfficerID = existingEvent.RangeOfficer.RangeOfficerID,
                                OfficerName = existingEvent.RangeOfficer.OfficerName,
                                IsActive = existingEvent.RangeOfficer.IsActive ?? true
                            };
                    }
                }

                if (selectedRangeOfficer == null)
                {
                    var allEvents = await service.GetRangeEventsAsync();
                    var existingEvent = allEvents?.FirstOrDefault(x => x.RangeEventID == RangeStat.RangeEventID);
                    if (existingEvent?.RangeOfficer != null)
                    {
                        selectedRangeOfficer = availableRangeOfficers.FirstOrDefault(ro => ro.RangeOfficerID == existingEvent.RangeOfficer.RangeOfficerID)
                            ?? new RangeOfficerDTO
                            {
                                RangeOfficerID = existingEvent.RangeOfficer.RangeOfficerID,
                                OfficerName = existingEvent.RangeOfficer.OfficerName,
                                IsActive = existingEvent.RangeOfficer.IsActive ?? true
                            };
                    }
                }
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading range officers in AddRangeStatisticModal.");
        }
    }

    private void OnRangeOfficerChanged(RangeOfficerDTO? officer)
    {
        selectedRangeOfficer = officer;
    }

    private Task<IEnumerable<RangeOfficerDTO>> SearchRangeOfficers(string value, CancellationToken token)
    {
        if (availableRangeOfficers == null || !availableRangeOfficers.Any())
        {
            return Task.FromResult(Enumerable.Empty<RangeOfficerDTO>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<RangeOfficerDTO>>(availableRangeOfficers);
        }

        return Task.FromResult(availableRangeOfficers.Where(ro => ro.OfficerName.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task SaveRangeStatAsync()
    {
        if (rangeDate == null)
        {
            Snackbar.Add("Range Date is required.", Severity.Error);
            return;
        }

        if (selectedRangeOfficer == null || selectedRangeOfficer.RangeOfficerID <= 0 || string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName))
        {
            Snackbar.Add("Range Officer is required.", Severity.Error);
            return;
        }

        if (!RangeStat.CourseID.HasValue || RangeStat.CourseID.Value <= 0)
        {
            Snackbar.Add("Range Course is required.", Severity.Error);
            return;
        }

        if (!RangeStat.FirearmID.HasValue || RangeStat.FirearmID.Value <= 0)
        {
            Snackbar.Add("Firearm is required.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(RangeStat.PassFail))
        {
            Snackbar.Add("Pass / Fail Result is required.", Severity.Error);
            return;
        }

        RangeStat.EmployeeID = EmployeeId;
        isSaving = true;

        try
        {
            // 1. Create a new RangeEvent record
            var rangeEventDto = new RangeEventDTO
            {
                RangeDate = DateOnly.FromDateTime(rangeDate.Value),
                RangeOfficer = selectedRangeOfficer != null
                    ? new RangeOfficer
                    {
                        RangeOfficerID = selectedRangeOfficer.RangeOfficerID,
                        OfficerName = string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName) ? "Unknown" : selectedRangeOfficer.OfficerName,
                        IsActive = selectedRangeOfficer.IsActive
                    }
                    : null
            };

            var createdEvent = await service.CreateRangeEventAsync(rangeEventDto);
            if (createdEvent == null || createdEvent.RangeEventID <= 0)
            {
                Snackbar.Add("Failed to create Range Event record.", Severity.Error);
                return;
            }

            RangeStat.RangeEventID = createdEvent.RangeEventID;
            RangeStat.RangeDate = createdEvent.RangeDate;

            if (RangeStat.RangeID == 0)
            {
                var result = await service.CreateRangeStatisticAsync(RangeStat);
                if (result != null)
                {
                    Snackbar.Add("Range statistic added successfully!", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(result));
                }
                else
                {
                    Snackbar.Add("Failed to create range statistic.", Severity.Error);
                }
            }
            else
            {
                var result = await service.UpdateRangeStatisticAsync(RangeStat.RangeID, RangeStat);
                if (result != null)
                {
                    Snackbar.Add("Range statistic updated successfully!", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(result));
                }
                else
                {
                    Snackbar.Add("Failed to update range statistic.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving range statistic.");
            Snackbar.Add($"Failed to save range statistic: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}
