@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Shared.Models
@using SheriffPersonnel.Web.Services
@inject SearchService service
@inject CodeTableService codeTableService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<AddRangeStatisticModal> logger

<style>
    /* Fix MudSelect popover dropdown width & checkbox spacing */
    .skills-popover-menu.mud-popover,
    .mud-popover:has(.skills-popover-menu) {
        min-width: 260px !important;
        max-width: 320px !important;
        width: auto !important;
    }
    .skills-popover-menu .mud-list-item,
    .mud-popover .mud-list-item {
        padding: 2px 8px !important;
        min-height: 28px !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox,
    .skills-popover-menu .mud-list-item .mud-checkbox.mud-input-content-placement-end,
    .mud-popover .mud-list-item .mud-checkbox,
    .mud-popover .mud-list-item .mud-checkbox.mud-input-content-placement-end {
        gap: 6px !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-button-root,
    .mud-popover .mud-list-item .mud-checkbox .mud-button-root {
        padding: 0 !important;
        margin: 0 !important;
        width: 20px !important;
        height: 20px !important;
        min-width: 20px !important;
        min-height: 20px !important;
        flex-shrink: 0 !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-icon-root,
    .mud-popover .mud-list-item .mud-checkbox .mud-icon-root {
        font-size: 1.15rem !important;
        width: 1.15rem !important;
        height: 1.15rem !important;
    }
    .skills-popover-menu .mud-list-item .mud-checkbox .mud-checkbox-text,
    .skills-popover-menu .mud-list-item .mud-checkbox > .mud-typography,
    .skills-popover-menu .mud-list-item .mud-checkbox.mud-input-content-placement-end > .mud-typography,
    .mud-popover .mud-list-item .mud-checkbox .mud-checkbox-text,
    .mud-popover .mud-list-item .mud-checkbox > .mud-typography,
    .mud-popover .mud-list-item .mud-checkbox.mud-input-content-placement-end > .mud-typography {
        padding-left: 0 !important;
        margin-left: 0 !important;
        font-size: 0.8125rem !important;
        line-height: 1.25 !important;
        white-space: normal !important;
        word-break: break-word !important;
        flex-grow: 1 !important;
        text-align: left !important;
    }
</style>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(RangeStat.RangeID == 0 ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-2" />
            @(RangeStat.RangeID == 0 ? "Add Range Record" : "Edit Range Record")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="RangeStat" OnValidSubmit="SaveRangeStatAsync">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="rangeDate"
                                   Label="Range Date *"
                                   Variant="Variant.Outlined"
                                   DateFormat="MM/dd/yyyy"
                                   Required="true"
                                   RequiredError="Range Date is required"
                                   Editable="true"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="RangeOfficerDTO"
                                     Value="selectedRangeOfficer"
                                     ValueChanged="OnRangeOfficerChanged"
                                     SearchFunc="SearchRangeOfficers"
                                     ToStringFunc="@(ro => ro == null ? string.Empty : ro.OfficerName)"
                                     Label="Range Officer *"
                                     Placeholder="Type or select Range Officer"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="false"
                                     SelectValueOnTab="true"
                                     MinCharacters="0"
                                     Required="true"
                                     RequiredError="Range Officer is required" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="RangeCourseDTO"
                                     Value="selectedCourse"
                                     ValueChanged="OnCourseChanged"
                                     SearchFunc="SearchCourses"
                                     ToStringFunc="@(c => c == null ? string.Empty : c.FormattedCourse)"
                                     Label="Range Course *"
                                     Placeholder="Type or select Range Course"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="false"
                                     SelectValueOnTab="true"
                                     MinCharacters="0"
                                     Required="true"
                                     RequiredError="Range Course is required"
                                     @onkeydown="OnCourseKeyDown" />
                </MudItem>
                @if (IsCourseP)
                {
                    <MudItem xs="12" sm="6">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudSelect T="int"
                                       @ref="skillsSelectRef"
                                       MultiSelection="true"
                                       SelectAll="true"
                                       SelectAllText="Select All"
                                       PopoverClass="skills-popover-menu"
                                       Label="Range Skills"
                                       Placeholder="Select Skills"
                                       Variant="Variant.Outlined"
                                       Dense="true"
                                       SelectedValues="@RangeStat.SelectedSkillIDs"
                                       SelectedValuesChanged="OnSkillsSelectionChanged"
                                       MultiSelectionTextFunc="@(selectedList => GetSkillsSelectionSummary(selectedList))"
                                       Style="flex-grow: 1;">
                                @foreach (var skill in availableRangeSkills)
                                {
                                    <MudSelectItem T="int" Value="@skill.RangeSkillID">@skill.SkillName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTooltip Text="Select Skills Dialog">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="OpenSkillsModal"
                                               Class="mt-1"
                                               tabindex="-1"
                                               aria-label="Select skills dialog" />
                            </MudTooltip>
                        </MudStack>
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="FirearmsDto"
                                     Value="selectedFirearm"
                                     ValueChanged="OnFirearmChanged"
                                     SearchFunc="SearchFirearms"
                                     ToStringFunc="FormatFirearm"
                                     Label="Firearm *"
                                     Placeholder="Type or select Firearm"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="false"
                                     SelectValueOnTab="true"
                                     MinCharacters="0"
                                     Required="true"
                                     RequiredError="Firearm is required" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch T="bool"
                               Value="@(IsPass)"
                               ValueChanged="OnPassFailChanged"
                               Label="@($"Result: {(IsPass ? "Pass" : "Fail")}")"
                               Color="Color.Success"
                               UncheckedColor="Color.Error" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel" Disabled="@isSaving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="SaveRangeStatAsync" Disabled="@isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int EmployeeId { get; set; }

    [Parameter]
    public RangeStatisticDTO RangeStat { get; set; } = new();

    [Parameter]
    public IEnumerable<RangeCourseDTO>? AvailableCourses { get; set; }

    [Parameter]
    public IEnumerable<RangeEventDTO>? AvailableEvents { get; set; }

    [Parameter]
    public IEnumerable<FirearmsDto>? AvailableFirearms { get; set; }

    [Parameter]
    public IEnumerable<RangeSkillDTO>? AvailableSkills { get; set; }

    [Parameter]
    public string? EmployeeName { get; set; }

    private DateTime? rangeDate = DateTime.Today;
    private RangeOfficerDTO? selectedRangeOfficer;
    private RangeCourseDTO? selectedCourse;
    private FirearmsDto? selectedFirearm;
    private List<RangeOfficerDTO> availableRangeOfficers = new();
    private List<RangeSkillDTO> availableRangeSkills = new();
    private MudSelect<int>? skillsSelectRef;
    private bool isSaving = false;

    private bool IsCourseP
    {
        get
        {
            if (selectedCourse != null)
            {
                return string.Equals(selectedCourse.CourseCode, "P", StringComparison.OrdinalIgnoreCase);
            }
            if (RangeStat.CourseID.HasValue && AvailableCourses != null)
            {
                var course = AvailableCourses.FirstOrDefault(c => c.CourseID == RangeStat.CourseID.Value);
                return course != null && string.Equals(course.CourseCode, "P", StringComparison.OrdinalIgnoreCase);
            }
            return false;
        }
    }

    private IEnumerable<RangeCourseDTO> FilteredCourses =>
        AvailableCourses?
            .Where(c => c.IsActive || c.CourseID == RangeStat.CourseID)
            .OrderBy(c => c.SortOrder ?? int.MaxValue)
            .ThenBy(c => c.CourseName)
        ?? Enumerable.Empty<RangeCourseDTO>();

    protected override async Task OnInitializedAsync()
    {
        NormalizePassFail();
        InitDate();
        if (AvailableCourses == null)
        {
            try
            {
                AvailableCourses = await service.GetRangeCoursesAsync();
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error loading range courses in AddRangeStatisticModal.");
            }
        }
        InitCourse();
        if ((AvailableFirearms == null || !AvailableFirearms.Any()) && EmployeeId > 0)
        {
            try
            {
                AvailableFirearms = await service.GetFirearmsByEmployeeIdAsync(EmployeeId);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error loading firearms in AddRangeStatisticModal.");
            }
        }
        InitFirearm();
        await LoadRangeOfficersAsync();

        if (AvailableSkills != null && AvailableSkills.Any())
        {
            availableRangeSkills = AvailableSkills.ToList();
        }
        else
        {
            try
            {
                var skills = await codeTableService.GetRangeSkillsAsync();
                availableRangeSkills = skills != null ? skills.ToList() : new();
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error loading range skills in AddRangeStatisticModal.");
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        NormalizePassFail();
        InitDate();
        InitCourse();
        InitFirearm();
        if (AvailableSkills != null && AvailableSkills.Any())
        {
            availableRangeSkills = AvailableSkills.ToList();
        }
        if (RangeStat.SelectedSkillIDs == null)
        {
            RangeStat.SelectedSkillIDs = new List<int>();
        }
    }

    private void InitCourse()
    {
        if (selectedCourse == null && RangeStat.CourseID.HasValue && AvailableCourses != null)
        {
            selectedCourse = AvailableCourses.FirstOrDefault(c => c.CourseID == RangeStat.CourseID.Value);
        }
    }

    private void InitFirearm()
    {
        if (selectedFirearm == null && RangeStat.FirearmID.HasValue && AvailableFirearms != null)
        {
            selectedFirearm = AvailableFirearms.FirstOrDefault(f => f.FirearmID == RangeStat.FirearmID.Value);
        }
    }

    private bool IsPass => !string.Equals(RangeStat.PassFail, "Fail", StringComparison.OrdinalIgnoreCase) && !string.Equals(RangeStat.PassFail, "F", StringComparison.OrdinalIgnoreCase);

    private void OnPassFailChanged(bool value)
    {
        RangeStat.PassFail = value ? "Pass" : "Fail";
    }

    private void NormalizePassFail()
    {
        if (string.Equals(RangeStat.PassFail, "Fail", StringComparison.OrdinalIgnoreCase) || string.Equals(RangeStat.PassFail, "F", StringComparison.OrdinalIgnoreCase))
        {
            RangeStat.PassFail = "Fail";
        }
        else
        {
            RangeStat.PassFail = "Pass";
        }
    }

    private void InitDate()
    {
        if (RangeStat.RangeDate.HasValue)
        {
            rangeDate = RangeStat.RangeDate.Value.ToDateTime(TimeOnly.MinValue);
        }
        else if (rangeDate == null)
        {
            rangeDate = DateTime.Today;
        }
    }

    private async Task LoadRangeOfficersAsync()
    {
        try
        {
            var officers = await codeTableService.GetRangeOfficersAsync();
            availableRangeOfficers = officers != null
                ? officers.Where(ro => ro.IsActive || ro.RangeOfficerID == RangeStat.RangeOfficerID).OrderBy(ro => ro.OfficerName).ToList()
                : new List<RangeOfficerDTO>();

            if (selectedRangeOfficer == null)
            {
                if (RangeStat.RangeOfficerID.HasValue && RangeStat.RangeOfficerID.Value > 0)
                {
                    selectedRangeOfficer = availableRangeOfficers.FirstOrDefault(ro => ro.RangeOfficerID == RangeStat.RangeOfficerID.Value)
                        ?? (!string.IsNullOrWhiteSpace(RangeStat.RangeOfficerName)
                            ? new RangeOfficerDTO { RangeOfficerID = RangeStat.RangeOfficerID.Value, OfficerName = RangeStat.RangeOfficerName }
                            : null);
                }

                if (selectedRangeOfficer == null && RangeStat.RangeEventID > 0)
                {
                    if (AvailableEvents != null)
                    {
                        var existingEvent = AvailableEvents.FirstOrDefault(x => x.RangeEventID == RangeStat.RangeEventID);
                        if (existingEvent?.RangeOfficer != null)
                        {
                            selectedRangeOfficer = availableRangeOfficers.FirstOrDefault(ro => ro.RangeOfficerID == existingEvent.RangeOfficer.RangeOfficerID)
                                ?? new RangeOfficerDTO
                                {
                                    RangeOfficerID = existingEvent.RangeOfficer.RangeOfficerID,
                                    OfficerName = existingEvent.RangeOfficer.OfficerName,
                                    IsActive = existingEvent.RangeOfficer.IsActive ?? true
                                };
                        }
                    }

                    if (selectedRangeOfficer == null)
                    {
                        var allEvents = await service.GetRangeEventsAsync();
                        var existingEvent = allEvents?.FirstOrDefault(x => x.RangeEventID == RangeStat.RangeEventID);
                        if (existingEvent?.RangeOfficer != null)
                        {
                            selectedRangeOfficer = availableRangeOfficers.FirstOrDefault(ro => ro.RangeOfficerID == existingEvent.RangeOfficer.RangeOfficerID)
                                ?? new RangeOfficerDTO
                                {
                                    RangeOfficerID = existingEvent.RangeOfficer.RangeOfficerID,
                                    OfficerName = existingEvent.RangeOfficer.OfficerName,
                                    IsActive = existingEvent.RangeOfficer.IsActive ?? true
                                };
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading range officers in AddRangeStatisticModal.");
        }
    }

    private void OnRangeOfficerChanged(RangeOfficerDTO? officer)
    {
        selectedRangeOfficer = officer;
    }

    private Task<IEnumerable<RangeOfficerDTO>> SearchRangeOfficers(string value, CancellationToken token)
    {
        if (availableRangeOfficers == null || !availableRangeOfficers.Any())
        {
            return Task.FromResult(Enumerable.Empty<RangeOfficerDTO>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<RangeOfficerDTO>>(availableRangeOfficers);
        }

        return Task.FromResult(availableRangeOfficers.Where(ro => ro.OfficerName.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnCourseChanged(RangeCourseDTO? course)
    {
        selectedCourse = course;
        RangeStat.CourseID = course?.CourseID;
        StateHasChanged();
    }

    private async Task OnCourseKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab" && !e.ShiftKey)
        {
            // Yield and delay to allow MudAutocomplete to commit the selection (e.g. "P")
            // and invoke OnCourseChanged before checking if Course is "P".
            await Task.Yield();
            await Task.Delay(50);
            StateHasChanged();
            if (IsCourseP)
            {
                for (int i = 0; i < 5; i++)
                {
                    if (skillsSelectRef != null)
                    {
                        await skillsSelectRef.FocusAsync();
                        break;
                    }
                    await Task.Delay(50);
                }
            }
        }
    }

    private Task<IEnumerable<RangeCourseDTO>> SearchCourses(string value, CancellationToken token)
    {
        var courses = FilteredCourses.ToList();
        if (!courses.Any())
        {
            return Task.FromResult(Enumerable.Empty<RangeCourseDTO>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<RangeCourseDTO>>(courses);
        }

        return Task.FromResult(courses.Where(c =>
            (c.FormattedCourse != null && c.FormattedCourse.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (c.CourseName != null && c.CourseName.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (c.CourseCode != null && c.CourseCode.Contains(value, StringComparison.OrdinalIgnoreCase))));
    }

    private static string FormatFirearm(FirearmsDto? firearm)
    {
        if (firearm == null) return string.Empty;
        return $"{firearm.MakeName} {firearm.ModelNumber} (S/N: {firearm.SerialNumber})".Trim();
    }

    private void OnFirearmChanged(FirearmsDto? firearm)
    {
        selectedFirearm = firearm;
        RangeStat.FirearmID = firearm?.FirearmID;
    }

    private Task<IEnumerable<FirearmsDto>> SearchFirearms(string value, CancellationToken token)
    {
        if (AvailableFirearms == null || !AvailableFirearms.Any())
        {
            return Task.FromResult(Enumerable.Empty<FirearmsDto>());
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(AvailableFirearms);
        }

        return Task.FromResult(AvailableFirearms.Where(f =>
            (f.MakeName != null && f.MakeName.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (f.ModelNumber != null && f.ModelNumber.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (f.SerialNumber != null && f.SerialNumber.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            FormatFirearm(f).Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void OnSkillsSelectionChanged(IEnumerable<int> vals)
    {
        RangeStat.SelectedSkillIDs = vals?.ToList() ?? new List<int>();
    }

    private string GetSkillsSelectionSummary(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any())
        {
            return "0 Skills";
        }

        var skillNames = new List<string>();
        foreach (var valStr in selectedValues)
        {
            if (int.TryParse(valStr, out int id))
            {
                var skill = availableRangeSkills.FirstOrDefault(s => s.RangeSkillID == id);
                if (skill != null)
                {
                    skillNames.Add(skill.SkillName);
                }
            }
        }

        if (!skillNames.Any()) return $"{selectedValues.Count} Skills";
        if (skillNames.Count == 1) return skillNames[0];
        return $"{skillNames.Count} Skills ({string.Join(", ", skillNames)})";
    }

    private async Task OpenSkillsModal()
    {
        var officerName = !string.IsNullOrWhiteSpace(RangeStat.EmployeeName)
            ? RangeStat.EmployeeName
            : (!string.IsNullOrWhiteSpace(EmployeeName) ? EmployeeName : "Employee");

        var parameters = new DialogParameters<SelectRangeSkillsModal>
        {
            { x => x.OfficerName, officerName },
            { x => x.AvailableSkills, availableRangeSkills },
            { x => x.SelectedSkillIDs, new HashSet<int>(RangeStat.SelectedSkillIDs) }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SelectRangeSkillsModal>("Select Range Skills", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is List<int> selectedSkills)
        {
            RangeStat.SelectedSkillIDs = selectedSkills;
            StateHasChanged();
        }
    }

    private async Task SaveRangeStatAsync()
    {
        if (rangeDate == null)
        {
            Snackbar.Add("Range Date is required.", Severity.Error);
            return;
        }

        if (selectedRangeOfficer == null || selectedRangeOfficer.RangeOfficerID <= 0 || string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName))
        {
            Snackbar.Add("Range Officer is required.", Severity.Error);
            return;
        }

        if (selectedCourse != null)
        {
            RangeStat.CourseID = selectedCourse.CourseID;
        }

        if (!RangeStat.CourseID.HasValue || RangeStat.CourseID.Value <= 0)
        {
            Snackbar.Add("Range Course is required.", Severity.Error);
            return;
        }

        if (!IsCourseP)
        {
            RangeStat.SelectedSkillIDs.Clear();
        }

        if (selectedFirearm != null)
        {
            RangeStat.FirearmID = selectedFirearm.FirearmID;
        }

        if (!RangeStat.FirearmID.HasValue || RangeStat.FirearmID.Value <= 0)
        {
            Snackbar.Add("Firearm is required.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(RangeStat.PassFail))
        {
            Snackbar.Add("Pass / Fail Result is required.", Severity.Error);
            return;
        }

        RangeStat.EmployeeID = EmployeeId;
        isSaving = true;

        try
        {
            // 1. Create a new RangeEvent record
            var rangeEventDto = new RangeEventDTO
            {
                RangeDate = DateOnly.FromDateTime(rangeDate.Value),
                RangeOfficer = selectedRangeOfficer != null
                    ? new RangeOfficer
                    {
                        RangeOfficerID = selectedRangeOfficer.RangeOfficerID,
                        OfficerName = string.IsNullOrWhiteSpace(selectedRangeOfficer.OfficerName) ? "Unknown" : selectedRangeOfficer.OfficerName,
                        IsActive = selectedRangeOfficer.IsActive
                    }
                    : null
            };

            var createdEvent = await service.CreateRangeEventAsync(rangeEventDto);
            if (createdEvent == null || createdEvent.RangeEventID <= 0)
            {
                Snackbar.Add("Failed to create Range Event record.", Severity.Error);
                return;
            }

            RangeStat.RangeEventID = createdEvent.RangeEventID;
            RangeStat.RangeDate = createdEvent.RangeDate;
            RangeStat.RangeOfficerID = selectedRangeOfficer?.RangeOfficerID;
            RangeStat.RangeOfficerName = selectedRangeOfficer?.OfficerName;

            if (RangeStat.RangeID == 0)
            {
                var result = await service.CreateRangeStatisticAsync(RangeStat);
                if (result != null)
                {
                    Snackbar.Add("Range statistic added successfully!", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(result));
                }
                else
                {
                    Snackbar.Add("Failed to create range statistic.", Severity.Error);
                }
            }
            else
            {
                var result = await service.UpdateRangeStatisticAsync(RangeStat.RangeID, RangeStat);
                if (result != null)
                {
                    Snackbar.Add("Range statistic updated successfully!", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(result));
                }
                else
                {
                    Snackbar.Add("Failed to update range statistic.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving range statistic.");
            Snackbar.Add($"Failed to save range statistic: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}
