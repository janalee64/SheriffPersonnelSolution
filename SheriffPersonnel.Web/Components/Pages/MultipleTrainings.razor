    private void OnTrainingSessionChanged(TrainingSessionsDto? session)
    {
        selectedTrainingSession = session;
        request.TrainingSessionID = session?.TrainingSessionID ?? 0;
        if (session != null)
        {
            PopulateSessionFields(session);
        }
        else
        {
            ClearSessionFields();
        }
    }

    private void PopulateSessionFields(TrainingSessionsDto session)
    {
        request.TrainingSchoolID = session.TrainingSchoolID;
        request.Location = session.Location;
        request.Instructor = session.Instructor;
        request.BeginDate = session.BeginDate;
        request.EndDate = session.EndDate;
        request.SessionHours = session.SessionHours;

        beginDate = session.BeginDate.HasValue ? session.BeginDate.Value.ToDateTime(TimeOnly.MinValue) : null;
        endDate = session.EndDate.HasValue ? session.EndDate.Value.ToDateTime(TimeOnly.MinValue) : null;

        if (session.TrainingSchoolID.HasValue && availableSchools != null)
        {
            selectedSchool = availableSchools.FirstOrDefault(s => s.TrainingSchoolID == session.TrainingSchoolID.Value);
            if (selectedSchool == null && !string.IsNullOrEmpty(session.SchoolName))
            {
                selectedSchool = new TrainingSchoolsDto { TrainingSchoolID = session.TrainingSchoolID.Value, SchoolName = session.SchoolName };
            }
        }
        else
        {
            selectedSchool = null;
        }
    }

    private void ClearSessionFields()
    {
        request.TrainingSchoolID = null;
        request.Location = null;
        request.Instructor = null;
        request.BeginDate = null;
        request.EndDate = null;
        request.SessionHours = null;
        beginDate = null;
        endDate = null;
        selectedSchool = null;
        isNewSchool = false;
        newSchoolName = string.Empty;
        newSchoolAddress = string.Empty;
    }

    private async Task<TrainingSchoolsDto?> CreateNewSchoolAsync()
    {
        if (string.IsNullOrWhiteSpace(newSchoolName))
        {
            Snackbar.Add("Please enter a School Name for the new training school.", Severity.Warning);
            return null;
        }

        isSavingSchool = true;
        try
        {
            var dto = new TrainingSchoolsDto
            {
                SchoolName = newSchoolName.Trim(),
                Address = string.IsNullOrWhiteSpace(newSchoolAddress) ? null : newSchoolAddress.Trim(),
                IsActive = true
            };

            var created = await service.CreateTrainingSchoolAsync(dto);
            if (created != null && created.TrainingSchoolID > 0)
            {
                var updatedSchoolsList = (availableSchools ?? Enumerable.Empty<TrainingSchoolsDto>()).ToList();
                updatedSchoolsList.Add(created);
                availableSchools = updatedSchoolsList;
                trainingSchools = updatedSchoolsList;

                selectedSchool = created;
                request.TrainingSchoolID = created.TrainingSchoolID;
                isNewSchool = false;
                newSchoolName = string.Empty;
                newSchoolAddress = string.Empty;

                Snackbar.Add($"Training school '{created.SchoolName}' created successfully!", Severity.Success);
                return created;
            }
            else
            {
                Snackbar.Add("Failed to create training school. Please try again.", Severity.Error);
                return null;
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error creating new training school.");
            Snackbar.Add($"Error creating training school: {ex.Message}", Severity.Error);
            return null;
        }
        finally
        {
            isSavingSchool = false;
        }
    }

    private async Task SaveNewSchoolInlineAsync()
    {
        await CreateNewSchoolAsync();
    }

