    private Task<IEnumerable<TrainingSchoolsDto>> SearchTrainingSchools(string value, CancellationToken token)
    {
        var schools = GetFilteredSchools().ToList();

        if (selectedSchool != null && !schools.Any(s => s.TrainingSchoolID == selectedSchool.TrainingSchoolID))
        {
            schools.Insert(0, selectedSchool);
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<TrainingSchoolsDto>>(schools);
        }

        var filtered = schools.Where(s =>
            !string.IsNullOrEmpty(s.SchoolName) && s.SchoolName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult<IEnumerable<TrainingSchoolsDto>>(filtered);
    }

    private string GetSchoolText(TrainingSchoolsDto? school) => school?.SchoolName ?? string.Empty;

    private async Task<IEnumerable<TrainingSessionsDto>> SearchTrainingSessions(string value, CancellationToken token)
    {
        if (availableSessions == null)
        {
            availableSessions = await service.GetTrainingSessionsAsync();
        }

        var sessionsList = availableSessions != null ? availableSessions.ToList() : new List<TrainingSessionsDto>();

        if (selectedTrainingSession != null && !sessionsList.Any(x => x.TrainingSessionID == selectedTrainingSession.TrainingSessionID))
        {
            sessionsList.Insert(0, selectedTrainingSession);
        }

        if (!sessionsList.Any())
        {
            return Enumerable.Empty<TrainingSessionsDto>();
        }

        IEnumerable<TrainingSessionsDto> resultList = sessionsList;

        if (!string.IsNullOrWhiteSpace(value))
        {
            resultList = resultList.Where(x =>
                (!string.IsNullOrEmpty(x.SchoolName) && x.SchoolName.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Location) && x.Location.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Instructor) && x.Instructor.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                (x.BeginDate.HasValue && x.BeginDate.Value.ToString("MM/dd/yyyy").Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                (x.EndDate.HasValue && x.EndDate.Value.ToString("MM/dd/yyyy").Contains(value, StringComparison.OrdinalIgnoreCase))
            );
        }

        return resultList.OrderBy(x => GetTrainingSessionText(x), StringComparer.OrdinalIgnoreCase);
    }

    private string GetTrainingSessionText(TrainingSessionsDto? ts)
    {
        if (ts == null) return string.Empty;
        var name = !string.IsNullOrWhiteSpace(ts.SchoolName) ? ts.SchoolName : (!string.IsNullOrWhiteSpace(ts.Location) ? ts.Location : "Training Session");
        if (ts.BeginDate.HasValue || ts.EndDate.HasValue)
        {
            return $"{name} ({ts.BeginDate:MM/dd/yyyy} - {ts.EndDate:MM/dd/yyyy})".Trim();
        }
        return name;
    }

    private async Task SubmitAssignmentAsync()
    {
        if (selectedEmployeeIds.Count == 0)
        {
            Snackbar.Add("Please select at least one active employee.", Severity.Warning);
            return;
        }

        if (!isNewSession && (selectedTrainingSession == null || selectedTrainingSession.TrainingSessionID <= 0))
        {
            Snackbar.Add("Please select an existing training session or switch to 'Add New Session'.", Severity.Error);
            return;
        }

        if (isNewSession && isNewSchool)
        {
            if (string.IsNullOrWhiteSpace(newSchoolName))
            {
                Snackbar.Add("Please enter a School Name or select an existing training school.", Severity.Warning);
                return;
            }

            var createdSchool = await CreateNewSchoolAsync();
            if (createdSchool == null)
            {
                return;
            }
        }

        isAssigning = true;
        errorMessage = null;
        lastResult = null;

        try
        {
            request.EmployeeIDs = selectedEmployeeIds.ToList();
            request.BeginDate = beginDate.HasValue ? DateOnly.FromDateTime(beginDate.Value) : null;
            request.EndDate = endDate.HasValue ? DateOnly.FromDateTime(endDate.Value) : null;
            request.ExpireDate = expireDate.HasValue ? DateOnly.FromDateTime(expireDate.Value) : null;

            var result = await service.AssignMultipleTrainingsAsync(request);

            if (result != null)
            {
                lastResult = result;

                if (result.TotalConflicts > 0 && result.TotalAssigned > 0)
                {
                    Snackbar.Add($"Assigned training to {result.TotalAssigned} employee(s). {result.TotalConflicts} employee(s) skipped due to scheduling conflicts.", Severity.Warning);
                }
                else if (result.TotalConflicts > 0 && result.TotalAssigned == 0)
                {
                    Snackbar.Add($"Assignment skipped for all selected employees due to scheduling conflicts.", Severity.Error);
                }
                else
                {
                    Snackbar.Add($"Successfully assigned training session to {result.TotalAssigned} employee(s)!", Severity.Success);
                }

                // Refresh available training sessions list
                availableSessions = await service.GetTrainingSessionsAsync();
            }
            else
            {
                Snackbar.Add("Failed to process training assignment request.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error submitting multiple training assignment.");
            errorMessage = $"Error processing training assignment: {ex.Message}";
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isAssigning = false;
        }
    }
