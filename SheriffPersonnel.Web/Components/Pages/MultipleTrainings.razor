    private async Task DeleteSchoolItemAsync()
    {
        isDeletingSchool = true;
        try
        {
            var success = await CodeTableService.DeleteTrainingSchoolAsync(deleteSchoolId);
            if (success)
            {
                Snackbar.Add($"Training school '{deleteSchoolName}' deleted successfully.", Severity.Success);
                await LoadTrainingSchoolsAsync();
            }
            else
            {
                Snackbar.Add($"Unable to delete training school '{deleteSchoolName}'. It may be in use by existing records.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error deleting training school {Id}", deleteSchoolId);
            Snackbar.Add("Cannot delete training school because it is referenced by existing personnel or training records.", Severity.Error);
        }
        finally
        {
            isDeletingSchool = false;
            isDeleteSchoolDialogVisible = false;
        }
    }

    private async Task ToggleTrainingSchoolActiveAsync(TrainingSchoolsDto item, bool newStatus)
    {
        var originalStatus = item.IsActive;
        item.IsActive = newStatus;
        try
        {
            await CodeTableService.UpdateTrainingSchoolAsync(item.TrainingSchoolID, item);
            Snackbar.Add($"Training school '{item.SchoolName}' marked as {(newStatus ? "Active" : "Inactive")}.", Severity.Success);
            await LoadTrainingSchoolsAsync();
