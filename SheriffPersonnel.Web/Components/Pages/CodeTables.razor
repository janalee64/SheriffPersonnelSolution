    private async Task SaveItemAsync()
    {
        isSaving = true;
        try
        {
            switch (activeTable)
            {
                case "Status":
                    if (string.IsNullOrWhiteSpace(editingStatus.StatusCode))
                    {
                        Snackbar.Add("Status Code is required.", Severity.Error);
                        return;
                    }
                    if (string.IsNullOrWhiteSpace(editingStatus.StatusDescription))
                    {
                        Snackbar.Add("Status Description is required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateStatusAsync(editingStatus.StatusID, editingStatus);
                    else
                        await CodeTableService.CreateStatusAsync(editingStatus);
                    statuses = (await CodeTableService.GetStatusesAsync()).ToList();
                    break;

                case "Program":
                    if (string.IsNullOrWhiteSpace(editingProgram.ProgramName))
                    {
                        Snackbar.Add("Program Name is required.", Severity.Error);
                        return;
                    }
                    if (string.IsNullOrWhiteSpace(editingProgram.Description))
                    {
                        Snackbar.Add("Description is required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateProgramAsync(editingProgram.ProgramID, editingProgram);
                    else
                        await CodeTableService.CreateProgramAsync(editingProgram);
                    programs = (await CodeTableService.GetProgramsAsync()).ToList();
                    break;

                case "Unit":
                    if (string.IsNullOrWhiteSpace(editingUnit.UnitName))
                    {
                        Snackbar.Add("Unit Name is required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateUnitAsync(editingUnit.UnitID, editingUnit);
                    else
                        await CodeTableService.CreateUnitAsync(editingUnit);
                    units = (await CodeTableService.GetUnitsAsync()).ToList();
                    break;

                case "Rank":
                    if (string.IsNullOrWhiteSpace(editingRank.RankName))
                    {
                        Snackbar.Add("Rank Name is required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateRankAsync(editingRank.RankID, editingRank);
                    else
                        await CodeTableService.CreateRankAsync(editingRank);
                    ranks = (await CodeTableService.GetRanksAsync()).ToList();
                    break;

                case "Make":
                    if (string.IsNullOrWhiteSpace(editingMake.MakeName))
                    {
                        Snackbar.Add("Make Name is required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateMakeAsync(editingMake.MakeID, editingMake);
                    else
                        await CodeTableService.CreateMakeAsync(editingMake);
                    makes = (await CodeTableService.GetMakesAsync()).ToList();
                    break;

                case "DocumentType":
                    if (string.IsNullOrWhiteSpace(editingDocumentType.DocumentType))
                    {
                        Snackbar.Add("Document Type Name is required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateDocumentTypeAsync(editingDocumentType.DocumentTypeID, editingDocumentType);
                    else
                        await CodeTableService.CreateDocumentTypeAsync(editingDocumentType);
                    documentTypes = (await CodeTableService.GetDocumentTypesAsync()).ToList();
                    break;
            }

            Snackbar.Add($"{activeTableTitle} saved successfully.", Severity.Success);
            isDialogVisible = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving {Table}", activeTableTitle);
            Snackbar.Add($"Failed to save {activeTableTitle.ToLower()}. Please check details and try again.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    // Delete Operations
    private void OpenDeleteDialog(string tableKey, int id, string name)
    {
        deleteTable = tableKey;
        deleteTableTitle = tableKey switch
        {
            "Status" => "Status",
            "Program" => "Program",
            "Unit" => "Unit",
            "Rank" => "Rank",
            "Make" => "Make",
            "DocumentType" => "Document Type",
            _ => tableKey
        };
        deleteItemId = id;
        deleteItemDisplay = name;
        isDeleteDialogVisible = true;
    }

    private async Task DeleteItemAsync()
    {
        isDeleting = true;
        try
        {
            bool success = false;
            switch (deleteTable)
            {
                case "Status":
                    success = await CodeTableService.DeleteStatusAsync(deleteItemId);
                    if (success) statuses = (await CodeTableService.GetStatusesAsync()).ToList();
                    break;
                case "Program":
                    success = await CodeTableService.DeleteProgramAsync(deleteItemId);
                    if (success) programs = (await CodeTableService.GetProgramsAsync()).ToList();
                    break;
                case "Unit":
                    success = await CodeTableService.DeleteUnitAsync(deleteItemId);
                    if (success) units = (await CodeTableService.GetUnitsAsync()).ToList();
                    break;
                case "Rank":
                    success = await CodeTableService.DeleteRankAsync(deleteItemId);
                    if (success) ranks = (await CodeTableService.GetRanksAsync()).ToList();
                    break;
                case "Make":
                    success = await CodeTableService.DeleteMakeAsync(deleteItemId);
                    if (success) makes = (await CodeTableService.GetMakesAsync()).ToList();
                    break;
                case "DocumentType":
                    success = await CodeTableService.DeleteDocumentTypeAsync(deleteItemId);
                    if (success) documentTypes = (await CodeTableService.GetDocumentTypesAsync()).ToList();
                    break;
            }

            if (success)
            {
                Snackbar.Add($"{deleteTableTitle} '{deleteItemDisplay}' deleted successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Unable to delete {deleteTableTitle.ToLower()} '{deleteItemDisplay}'. It may be in use by existing records.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting {Table} {Id}", deleteTableTitle, deleteItemId);
            Snackbar.Add($"Cannot delete {deleteTableTitle.ToLower()} because it is referenced by existing personnel, inventory, range, or training records.", Severity.Error);
        }
        finally
        {
            isDeleting = false;
            isDeleteDialogVisible = false;
        }
    }

    // Inline Status Toggles

    private async Task ToggleProgramActiveAsync(ProgramsDto item, bool newStatus)
    {
        var originalStatus = item.IsActive;
        item.IsActive = newStatus;
        try
        {
            await CodeTableService.UpdateProgramAsync(item.ProgramID, item);
            Snackbar.Add($"Program '{item.ProgramName}' marked as {(newStatus ? "Active" : "Inactive")}.", Severity.Success);
        }
        catch (Exception ex)
        {
            item.IsActive = originalStatus;
            Logger.LogError(ex, "Error toggling program active state for ProgramID {Id}", item.ProgramID);
            Snackbar.Add($"Failed to update status for '{item.ProgramName}'.", Severity.Error);
        }
    }

