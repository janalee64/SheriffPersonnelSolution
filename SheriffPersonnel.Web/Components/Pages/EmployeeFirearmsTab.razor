@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Web.Services
@inject SearchService service
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<EmployeeFirearmsTab> logger

<MudStack Spacing="4" Class="mt-4">
    @if (IsEdit && EmployeeId > 0)
    {
        <MudPaper Class="pa-6" Elevation="3">
            @if (isLoading)
            {
                <MudPaper Class="pa-6 d-flex justify-center align-center" Style="min-height: 200px;" Elevation="0">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                    <MudText Class="ml-4">Loading firearms...</MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudText Typo="Typo.h6">Assigned Firearms</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddFirearmForm">
                        Add Firearm
                    </MudButton>
                </MudStack>

                <MudTable Items="firearms" Hover="true" Striped="true" Elevation="0" AllowUnsorted="true">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.MakeName ?? string.Empty)">Make</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.ModelNumber ?? string.Empty)">Model Number</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.SerialNumber ?? string.Empty)">Serial Number</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.Caliber ?? string.Empty)">Caliber</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.StatusDescription ?? string.Empty)">Status</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.Notes ?? string.Empty)">Notes</MudTableSortLabel></MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="firearmContext">
                        <MudTd DataLabel="Make">@(string.IsNullOrWhiteSpace(firearmContext.MakeName) ? "-" : firearmContext.MakeName)</MudTd>
                        <MudTd DataLabel="Model Number">@(string.IsNullOrWhiteSpace(firearmContext.ModelNumber) ? "-" : firearmContext.ModelNumber)</MudTd>
                        <MudTd DataLabel="Serial Number">@(string.IsNullOrWhiteSpace(firearmContext.SerialNumber) ? "-" : firearmContext.SerialNumber)</MudTd>
                        <MudTd DataLabel="Caliber">@(string.IsNullOrWhiteSpace(firearmContext.Caliber) ? "-" : firearmContext.Caliber)</MudTd>
                        <MudTd DataLabel="Status">@(string.IsNullOrWhiteSpace(firearmContext.StatusDescription) ? "-" : firearmContext.StatusDescription)</MudTd>
                        <MudTd DataLabel="Notes">@(string.IsNullOrWhiteSpace(firearmContext.Notes) ? "-" : firearmContext.Notes)</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudTooltip Text="Edit Firearm">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditFirearmForm(firearmContext))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete Firearm">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteFirearmAsync(firearmContext.FirearmID))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center">No firearms assigned to this employee.</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="3">
            <MudText Class="text-center text-muted">Firearm records can be added after saving the new employee.</MudText>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter] public int EmployeeId { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public IEnumerable<MakesDto>? AvailableMakes { get; set; }
    [Parameter] public IEnumerable<StatusesDto>? AvailableStatuses { get; set; }

    private List<FirearmsDto> firearms = new();
    private bool isLoading = true;
    private int _lastLoadedEmployeeId;
    private bool _lastLoadedIsEdit;

    protected override async Task OnParametersSetAsync()
    {
        if (IsEdit && EmployeeId > 0 && (EmployeeId != _lastLoadedEmployeeId || IsEdit != _lastLoadedIsEdit))
        {
            _lastLoadedEmployeeId = EmployeeId;
            _lastLoadedIsEdit = IsEdit;
            await LoadFirearmsAsync();
        }
    }

    private async Task LoadFirearmsAsync()
    {
        isLoading = true;
        try
        {
            var result = await service.GetFirearmsByEmployeeIdAsync(EmployeeId);
            firearms = result
                .OrderBy(f => f.StatusDescription ?? string.Empty)
                .ThenBy(f => f.MakeName ?? string.Empty)
                .ThenBy(f => f.ModelNumber ?? string.Empty)
                .ToList();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading firearms for employee {EmployeeID}.", EmployeeId);
            Snackbar.Add($"Failed to load firearms: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenAddFirearmForm()
    {
        var parameters = new DialogParameters<AddFirearmModal>
        {
            { x => x.EmployeeId, EmployeeId },
            { x => x.Firearm, new FirearmsDto { EmployeeID = EmployeeId } },
            { x => x.AvailableMakes, AvailableMakes },
            { x => x.AvailableStatuses, AvailableStatuses }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddFirearmModal>("Add Firearm", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadFirearmsAsync();
        }
    }

    private async Task OpenEditFirearmForm(FirearmsDto firearm)
    {
        var parameters = new DialogParameters<AddFirearmModal>
        {
            { x => x.EmployeeId, EmployeeId },
            { x => x.Firearm, new FirearmsDto
                {
                    FirearmID = firearm.FirearmID,
                    SerialNumber = firearm.SerialNumber,
                    ModelNumber = firearm.ModelNumber,
                    Caliber = firearm.Caliber,
                    EmployeeID = firearm.EmployeeID,
                    Notes = firearm.Notes,
                    LastUserID = firearm.LastUserID,
                    LastUpdated = firearm.LastUpdated,
                    StatusID = firearm.StatusID,
                    StatusDescription = firearm.StatusDescription,
                    MakeID = firearm.MakeID,
                    MakeName = firearm.MakeName
                }
            },
            { x => x.AvailableMakes, AvailableMakes },
            { x => x.AvailableStatuses, AvailableStatuses }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddFirearmModal>("Edit Firearm", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadFirearmsAsync();
        }
    }

    private async Task DeleteFirearmAsync(int firearmId)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            "Are you sure you want to delete this firearm record?",
            yesText: "Delete", cancelText: "Cancel");

        if (confirm != true) return;

        try
        {
            var success = await service.DeleteFirearmAsync(firearmId);
            if (success)
            {
                Snackbar.Add("Firearm record deleted successfully!", Severity.Success);
                await LoadFirearmsAsync();
            }
            else
            {
                Snackbar.Add("Failed to delete firearm record.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error deleting firearm record.");
            Snackbar.Add($"Error deleting firearm record: {ex.Message}", Severity.Error);
        }
    }
}

