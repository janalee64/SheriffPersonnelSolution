    private async Task SaveCodeTableItemAsync()
    {
        isSaving = true;
        try
        {
            switch (activeTable)
            {
                case "RangeCourse":
                    if (string.IsNullOrWhiteSpace(editingRangeCourse.CourseCode) || !editingRangeCourse.SortOrder.HasValue || string.IsNullOrWhiteSpace(editingRangeCourse.CourseName))
                    {
                        Snackbar.Add("Course Code, Sort Order, and Course Name are required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateRangeCourseAsync(editingRangeCourse.CourseID, editingRangeCourse);
                    else
                        await CodeTableService.CreateRangeCourseAsync(editingRangeCourse);
                    rangeCourses = (await CodeTableService.GetRangeCoursesAsync()).ToList();
                    break;

                case "RangeOfficer":
                    if (string.IsNullOrWhiteSpace(editingRangeOfficer.OfficerName))
                    {
                        Snackbar.Add("Officer Name is required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateRangeOfficerAsync(editingRangeOfficer.RangeOfficerID, editingRangeOfficer);
                    else
                        await CodeTableService.CreateRangeOfficerAsync(editingRangeOfficer);
                    rangeOfficers = (await CodeTableService.GetRangeOfficersAsync()).ToList();
                    break;

                case "RangeSkill":
                    if (string.IsNullOrWhiteSpace(editingRangeSkill.SkillName))
                    {
                        Snackbar.Add("Skill Name is required.", Severity.Error);
                        return;
                    }
                    if (isEditMode)
                        await CodeTableService.UpdateRangeSkillAsync(editingRangeSkill.RangeSkillID, editingRangeSkill);
                    else
                        await CodeTableService.CreateRangeSkillAsync(editingRangeSkill);
                    rangeSkills = (await CodeTableService.GetRangeSkillsAsync()).ToList();
                    break;
            }

            Snackbar.Add($"{activeTableTitle} saved successfully.", Severity.Success);
            isDialogVisible = false;
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving {Table}", activeTableTitle);
            Snackbar.Add($"Failed to save {activeTableTitle.ToLower()}. Please check details and try again.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDeleteCodeTableDialog(string tableKey, int id, string name)
    {
        deleteTable = tableKey;
        deleteTableTitle = tableKey switch
        {
            "RangeCourse" => "Range Course",
            "RangeOfficer" => "Range Officer",
            "RangeSkill" => "Range Skill",
            _ => tableKey
        };
        deleteItemId = id;
        deleteItemDisplay = name;
        isDeleteDialogVisible = true;
    }

    private async Task DeleteCodeTableItemAsync()
    {
        isDeleting = true;
        try
        {
            bool success = false;
            switch (deleteTable)
            {
                case "RangeCourse":
                    success = await CodeTableService.DeleteRangeCourseAsync(deleteItemId);
                    if (success) rangeCourses = (await CodeTableService.GetRangeCoursesAsync()).ToList();
                    break;
                case "RangeOfficer":
                    success = await CodeTableService.DeleteRangeOfficerAsync(deleteItemId);
                    if (success) rangeOfficers = (await CodeTableService.GetRangeOfficersAsync()).ToList();
                    break;
                case "RangeSkill":
                    success = await CodeTableService.DeleteRangeSkillAsync(deleteItemId);
                    if (success) rangeSkills = (await CodeTableService.GetRangeSkillsAsync()).ToList();
                    break;
            }

            if (success)
            {
                Snackbar.Add($"{deleteTableTitle} '{deleteItemDisplay}' deleted successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Unable to delete {deleteTableTitle.ToLower()} '{deleteItemDisplay}'. It may be in use by existing records.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error deleting {Table} {Id}", deleteTableTitle, deleteItemId);
            Snackbar.Add($"Cannot delete {deleteTableTitle.ToLower()} because it is referenced by existing personnel, inventory, range, or training records.", Severity.Error);
        }
        finally
        {
            isDeleting = false;
            isDeleteDialogVisible = false;
        }
    }

    private async Task ToggleRangeOfficerActiveAsync(RangeOfficerDTO item, bool newStatus)
    {
        var originalStatus = item.IsActive;
        item.IsActive = newStatus;
        try
        {
            await CodeTableService.UpdateRangeOfficerAsync(item.RangeOfficerID, item);
            Snackbar.Add($"Range Officer '{item.OfficerName}' marked as {(newStatus ? "Active" : "Inactive")}.", Severity.Success);
        }
        catch (Exception ex)
        {
            item.IsActive = originalStatus;
            logger.LogError(ex, "Error toggling range officer active state for RangeOfficerID {Id}", item.RangeOfficerID);
            Snackbar.Add($"Failed to update status for '{item.OfficerName}'.", Severity.Error);
        }
    }

    private async Task ToggleRangeCourseActiveAsync(RangeCourseDTO item, bool newStatus)
    {
        var originalStatus = item.IsActive;
        item.IsActive = newStatus;
        try
        {
            await CodeTableService.UpdateRangeCourseAsync(item.CourseID, item);
            Snackbar.Add($"Range Course '{(!string.IsNullOrWhiteSpace(item.CourseCode) ? item.CourseCode : item.CourseName)}' marked as {(newStatus ? "Active" : "Inactive")}.", Severity.Success);
        }
        catch (Exception ex)
        {
            item.IsActive = originalStatus;
            logger.LogError(ex, "Error toggling range course active state for CourseID {Id}", item.CourseID);
            Snackbar.Add($"Failed to update status for '{item.CourseName}'.", Severity.Error);
        }
    }
