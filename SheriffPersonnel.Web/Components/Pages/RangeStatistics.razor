@page "/rangestatistics"
@using System.ComponentModel.DataAnnotations
@using SheriffPersonnel.Shared.DTOs
@using SheriffPersonnel.Web.Services
@inject SearchService service
@inject CodeTableService CodeTableService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ILogger<RangeStatistics> logger

@attribute [Authorize(Roles = "Range Statistics")]

<PageTitle>Range Statistics</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Range Statistics</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Manage range statistics, range courses, range officers, and range skills.</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAllDataAsync" Disabled="@isLoading">
        Refresh Data
    </MudButton>
</MudStack>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close" CloseIconClicked="() => errorMessage = null">
        @errorMessage
    </MudAlert>
}

<style>
    .folder-styled-tabs .mud-tabs-tabbar {
        background-color: var(--mud-palette-background-gray) !important;
        border-bottom: 2px solid var(--mud-palette-primary) !important;
        padding: 6px 8px 0 8px !important;
        gap: 6px !important;
    }
    .folder-styled-tabs .mud-tab {
        border: 1px solid #cbd5e1 !important;
        border-bottom: none !important;
        border-top-left-radius: 8px !important;
        border-top-right-radius: 8px !important;
        background-color: #f1f5f9 !important;
        color: #334155 !important;
        font-weight: 600 !important;
        padding: 10px 22px !important;
        margin-right: 4px !important;
        transition: all 0.2s ease-in-out !important;
    }
    .folder-styled-tabs .mud-tab .mud-icon-root {
        color: #64748b !important;
        margin-right: 6px !important;
    }
    .folder-styled-tabs .mud-tab:hover:not(.mud-tab-active) {
        background-color: #e2e8f0 !important;
        color: var(--mud-palette-primary) !important;
    }
    .folder-styled-tabs .mud-tab:hover:not(.mud-tab-active) .mud-icon-root {
        color: var(--mud-palette-primary) !important;
    }
    .folder-styled-tabs .mud-tab.mud-tab-active {
        background-color: var(--mud-palette-primary) !important;
        color: #ffffff !important;
        border: 2px solid var(--mud-palette-primary) !important;
        border-bottom: 2px solid var(--mud-palette-primary) !important;
        margin-bottom: -2px !important;
        box-shadow: 0 -2px 6px rgba(0,0,0,0.12) !important;
        font-weight: 700 !important;
    }
    .folder-styled-tabs .mud-tab.mud-tab-active .mud-icon-root {
        color: #ffffff !important;
    }
    .folder-styled-tabs .mud-tabs-panels {
        border: 2px solid var(--mud-palette-primary) !important;
        border-top: none !important;
        border-bottom-left-radius: 8px !important;
        border-bottom-right-radius: 8px !important;
        background-color: var(--mud-palette-surface) !important;
        padding: 8px !important;
    }
</style>

<MudTabs Elevation="0" ApplyEffectsToContainer="true" Class="folder-styled-tabs mb-4">
    @* Tab 1: Range Statistics *@
    <MudTabPanel Text="Range Statistics" Icon="@Icons.Material.Filled.BarChart">
        <MudPaper Class="pa-4 mb-4" Elevation="3">
            <MudGrid>
                @* Course *@
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?" @bind-Value="selectedCourseId" Label="Course" Variant="Variant.Outlined" Clearable="true" Dense="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Courses</MudSelectItem>
                        @foreach (var c in rangeCourses)
                        {
                            <MudSelectItem T="int?" Value="@((int?)c.CourseID)">@c.FormattedCourse</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Employee Status *@
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?" @bind-Value="selectedEmployeeStatusId" Label="Employee Status" Variant="Variant.Outlined" Clearable="true" Dense="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Statuses</MudSelectItem>
                        @foreach (var st in availableStatuses)
                        {
                            <MudSelectItem T="int?" Value="@((int?)st.StatusID)">@(st.StatusDescription ?? st.StatusCode)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Program *@
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?" @bind-Value="selectedProgramId" Label="Program" Variant="Variant.Outlined" Clearable="true" Dense="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Programs</MudSelectItem>
                        @foreach (var prog in availablePrograms)
                        {
                            <MudSelectItem T="int?" Value="@((int?)prog.ProgramID)">@prog.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Unit *@
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int"
                               MultiSelection="true"
                               SelectAll="true"
                               SelectAllText="Select All"
                               Label="Unit"
                               Variant="Variant.Outlined"
                               Dense="true"
                               SelectedValues="selectedUnitIds"
                               SelectedValuesChanged="OnUnitSelectionChanged"
                               MultiSelectionTextFunc="@(selectedList => GetUnitSelectionSummary(selectedList))">
                        @foreach (var u in availableUnits)
                        {
                            <MudSelectItem T="int" Value="@u.UnitID">@u.UnitName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Start Date *@
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker @bind-Date="startDate" Label="Start Date" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" Editable="true" DateFormat="MM/dd/yyyy" />
                </MudItem>

                @* End Date *@
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker @bind-Date="endDate" Label="End Date" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" Editable="true" DateFormat="MM/dd/yyyy" />
                </MudItem>

                @* Pass/Fail *@
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" @bind-Value="selectedPassFailFilter" Label="Pass/Fail" Variant="Variant.Outlined" Clearable="true" Dense="true">
                        <MudSelectItem T="string" Value="@((string?)null)">All Results</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Pass")">Pass</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Fail")">Fail</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Missing? *@
                <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                    <MudCheckBox T="bool" Value="isMissingChecked" ValueChanged="OnMissingCheckedChanged" Label="Missing?" Color="Color.Primary" Dense="true" />
                </MudItem>

                @* Search & Reset Filters *@
                <MudItem xs="12" Class="d-flex align-center gap-2 mt-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="PerformRangeStatsSearch">
                        Search
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ResetFilters">
                        Reset Filters
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Print"
                               OnClick="OpenPrintWindow"
                               Disabled="@(!hasRangeStatsSearched || isRangeStatsLoading || !FilteredRangeStats.Any())">
                        Print
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (isRangeStatsLoading)
        {
            <MudPaper Class="pa-6 d-flex justify-center align-center" Style="min-height: 200px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Class="ml-4">Loading range statistics...</MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="3">
                @if (hasRangeStatsSearched && FilteredRangeStats.Any())
                {
                    <div class="d-flex justify-space-between align-center pa-4 pb-0">
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>Results: @FilteredRangeStats.Count() record(s) found</b></MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" Size="Size.Small" OnClick="OpenPrintWindow">
                            Print Results
                        </MudButton>
                    </div>
                }
                <MudTable Items="FilteredRangeStats" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<RangeStatisticDTO, object>(x => x.FormattedCourse)">Course</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RangeStatisticDTO, object>(x => x.EmployeeName ?? string.Empty)">Employee Name</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RangeStatisticDTO, object>(x => x.EmployeeStatus ?? string.Empty)">Employee Status</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RangeStatisticDTO, object>(x => x.Program ?? string.Empty)">Program</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RangeStatisticDTO, object>(x => x.Unit ?? string.Empty)">Unit</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RangeStatisticDTO, object>(x => x.RangeDate ?? DateOnly.MinValue)">Range Date</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RangeStatisticDTO, object>(x => x.PassFail ?? string.Empty)">Pass/Fail</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<RangeStatisticDTO, object>(x => x.SerialNumber ?? string.Empty)">Serial Number</MudTableSortLabel></MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="stat">
                        <MudTd DataLabel="Course">@(string.IsNullOrWhiteSpace(stat.FormattedCourse) ? "-" : stat.FormattedCourse)</MudTd>
                        <MudTd DataLabel="Employee Name">
                            @if (stat.EmployeeID > 0)
                            {
                                <MudLink Href="@($"/employee/edit/{stat.EmployeeID}")">@(string.IsNullOrWhiteSpace(stat.EmployeeName) ? $"Employee #{stat.EmployeeID}" : stat.EmployeeName)</MudLink>
                            }
                            else
                            {
                                @("-" )
                            }
                        </MudTd>
                        <MudTd DataLabel="Employee Status">@(string.IsNullOrWhiteSpace(stat.EmployeeStatus) ? "-" : stat.EmployeeStatus)</MudTd>
                        <MudTd DataLabel="Program">@(string.IsNullOrWhiteSpace(stat.Program) ? "-" : stat.Program)</MudTd>
                        <MudTd DataLabel="Unit">@(string.IsNullOrWhiteSpace(stat.Unit) ? "-" : stat.Unit)</MudTd>
                        <MudTd DataLabel="Range Date">@(stat.RangeDate.HasValue ? stat.RangeDate.Value.ToString("MM/dd/yyyy") : "-")</MudTd>
                        <MudTd DataLabel="Pass/Fail">
                            @if (string.Equals(stat.PassFail, "Pass", StringComparison.OrdinalIgnoreCase) || string.Equals(stat.PassFail, "P", StringComparison.OrdinalIgnoreCase))
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Pass</MudChip>
                            }
                            else if (string.Equals(stat.PassFail, "Fail", StringComparison.OrdinalIgnoreCase) || string.Equals(stat.PassFail, "F", StringComparison.OrdinalIgnoreCase))
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Fail</MudChip>
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(stat.PassFail) ? "-" : stat.PassFail)
                            }
                        </MudTd>
                        <MudTd DataLabel="Serial Number">@(string.IsNullOrWhiteSpace(stat.SerialNumber) ? "-" : stat.SerialNumber)</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudTooltip Text="View Employee Details">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ViewEmployee(stat.EmployeeID))" />
                            </MudTooltip>
                            @if (stat.RangeID > 0)
                            {
                                <MudTooltip Text="Delete Record">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteRangeStatAsync(stat.RangeID))" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                    </PagerContent>
                    <NoRecordsContent>
                        @if (!hasRangeStatsSearched)
                        {
                            <MudText Class="pa-4 text-center">Select search criteria and click Search to view range statistics records.</MudText>
                        }
                        else
                        {
                            <MudText Class="pa-4 text-center">No range statistics records found.</MudText>
                        }
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        }
    </MudTabPanel>

    @* Tab 2: Range Courses *@
    <MudTabPanel Text="Range Courses" Icon="@Icons.Material.Filled.SportsScore">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudTextField @bind-Value="searchRangeCourse" Placeholder="Search courses..." Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width: 400px;" />
                <MudCheckBox T="bool" @bind-Value="rangeCourseActiveOnly" Label="Active Only" Color="Color.Primary" Dense="true" />
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateRangeCourseDialog">
                Add Range Course
            </MudButton>
        </MudStack>
        <MudTable Items="FilteredRangeCourses" Hover="true" Striped="true" Loading="@isLoading">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<RangeCourseDTO, object>(x => x.CourseCode ?? string.Empty)">Course Code</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<RangeCourseDTO, object>(x => x.SortOrder ?? int.MaxValue)">Sort Order</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<RangeCourseDTO, object>(x => x.CourseName)">Course Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<RangeCourseDTO, object>(x => x.Notes ?? string.Empty)">Notes</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<RangeCourseDTO, object>(x => x.IsActive)">Active</MudTableSortLabel></MudTh>
                <MudTh Style="width: 120px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Course Code"><b>@(item.CourseCode ?? "-")</b></MudTd>
                <MudTd DataLabel="Sort Order">@(item.SortOrder?.ToString() ?? "-")</MudTd>
                <MudTd DataLabel="Course Name">@item.CourseName</MudTd>
                <MudTd DataLabel="Notes">@(item.Notes ?? "-")</MudTd>
                <MudTd DataLabel="Active">
                    <MudSwitch T="bool"
                               Value="@item.IsActive"
                               ValueChanged="@((bool val) => ToggleRangeCourseActiveAsync(item, val))"
                               Color="Color.Success"
                               UncheckedColor="Color.Default"
                               Size="Size.Small"
                               Label="@(item.IsActive ? "Active" : "Inactive")" />
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditRangeCourseDialog(item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick='() => OpenDeleteCodeTableDialog("RangeCourse", item.CourseID, item.CourseName)' />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4 text-center">No range course records found.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" /></PagerContent>
        </MudTable>
    </MudTabPanel>

    @* Tab 3: Range Officers *@
    <MudTabPanel Text="Range Officers" Icon="@Icons.Material.Filled.Badge">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudTextField @bind-Value="searchRangeOfficer" Placeholder="Search range officers..." Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width: 400px;" />
                <MudCheckBox T="bool" @bind-Value="rangeOfficerActiveOnly" Label="Active Only" Color="Color.Primary" Dense="true" />
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateRangeOfficerDialog">
                Add Range Officer
            </MudButton>
        </MudStack>
        <MudTable Items="FilteredRangeOfficers" Hover="true" Striped="true" Loading="@isLoading">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<RangeOfficerDTO, object>(x => x.OfficerName)">Officer Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<RangeOfficerDTO, object>(x => x.IsActive)">Active</MudTableSortLabel></MudTh>
                <MudTh Style="width: 120px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Officer Name"><b>@item.OfficerName</b></MudTd>
                <MudTd DataLabel="Active">
                    <MudSwitch T="bool"
                               Value="@item.IsActive"
                               ValueChanged="@((bool val) => ToggleRangeOfficerActiveAsync(item, val))"
                               Color="Color.Success"
                               UncheckedColor="Color.Default"
                               Size="Size.Small"
                               Label="@(item.IsActive ? "Active" : "Inactive")" />
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditRangeOfficerDialog(item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick='() => OpenDeleteCodeTableDialog("RangeOfficer", item.RangeOfficerID, item.OfficerName)' />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4 text-center">No range officer records found.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" /></PagerContent>
        </MudTable>
    </MudTabPanel>

    @* Tab 4: Range Skills *@
    <MudTabPanel Text="Range Skills" Icon="@Icons.Material.Filled.Star">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="searchRangeSkill" Placeholder="Search range skills..." Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width: 400px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateRangeSkillDialog">
                Add Range Skill
            </MudButton>
        </MudStack>
        <MudTable Items="FilteredRangeSkills" Hover="true" Striped="true" Loading="@isLoading">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<RangeSkillDTO, object>(x => x.SkillName)">Skill Name</MudTableSortLabel></MudTh>
                <MudTh Style="width: 120px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Skill Name"><b>@item.SkillName</b></MudTd>
                <MudTd DataLabel="Actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditRangeSkillDialog(item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick='() => OpenDeleteCodeTableDialog("RangeSkill", item.RangeSkillID, item.SkillName)' />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4 text-center">No range skill records found.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" /></PagerContent>
        </MudTable>
    </MudTabPanel>

    @* Tab 5: Firearm Search *@
    <MudTabPanel Text="Firearm Search" Icon="@Icons.Material.Filled.Search">
        <MudPaper Class="pa-4 mb-4" Elevation="3">
            <MudGrid>
                @* Make *@
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?" @bind-Value="selectedFirearmMakeId" Label="Make" Variant="Variant.Outlined" Clearable="true" Dense="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Makes</MudSelectItem>
                        @foreach (var m in availableMakes)
                        {
                            <MudSelectItem T="int?" Value="@((int?)m.MakeID)">@m.MakeName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Employee Status *@
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?" @bind-Value="selectedFirearmEmployeeStatusId" Label="Employee Status" Variant="Variant.Outlined" Clearable="true" Dense="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Statuses</MudSelectItem>
                        @foreach (var st in availableStatuses)
                        {
                            <MudSelectItem T="int?" Value="@((int?)st.StatusID)">@(st.StatusDescription ?? st.StatusCode)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* Model *@
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="searchModelNumber"
                                  Label="Model"
                                  Placeholder="Search by Model..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Immediate="true" />
                </MudItem>

                @* Serial Number *@
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="searchSerialNumber"
                                  Label="Serial Number"
                                  Placeholder="Search by Serial Number..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Immediate="true" />
                </MudItem>

                @* Search & Reset Filters *@
                <MudItem xs="12" Class="d-flex align-center gap-2 mt-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="PerformFirearmSearch">
                        Search
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ResetFirearmFilters">
                        Reset Filters
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (isFirearmsLoading)
        {
            <MudPaper Class="pa-6 d-flex justify-center align-center" Style="min-height: 200px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Class="ml-4">Loading firearm search data...</MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="3">
                <MudTable Items="FilteredFirearmSearchResults" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.SerialNumber ?? string.Empty)">Serial Number</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.MakeName ?? string.Empty)">Make</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.ModelNumber ?? string.Empty)">Model</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.Caliber ?? string.Empty)">Caliber</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.Optic)">Optic</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<FirearmsDto, object>(x => x.EmployeeName ?? string.Empty)">Employee Name</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="gun">
                        <MudTd DataLabel="Serial Number"><b>@(string.IsNullOrWhiteSpace(gun.SerialNumber) ? "-" : gun.SerialNumber)</b></MudTd>
                        <MudTd DataLabel="Make">@(string.IsNullOrWhiteSpace(gun.MakeName) ? "-" : gun.MakeName)</MudTd>
                        <MudTd DataLabel="Model">@(string.IsNullOrWhiteSpace(gun.ModelNumber) ? "-" : gun.ModelNumber)</MudTd>
                        <MudTd DataLabel="Caliber">@(string.IsNullOrWhiteSpace(gun.Caliber) ? "-" : gun.Caliber)</MudTd>
                        <MudTd DataLabel="Optic">@(gun.Optic ? "Yes" : "No")</MudTd>
                        <MudTd DataLabel="Employee Name">
                            @if (gun.EmployeeID > 0)
                            {
                                <MudLink Href="@($"/employee/edit/{gun.EmployeeID}")">@(string.IsNullOrWhiteSpace(gun.EmployeeName) ? $"Employee #{gun.EmployeeID}" : gun.EmployeeName)</MudLink>
                            }
                            else
                            {
                                @("-" )
                            }
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                    </PagerContent>
                    <NoRecordsContent>
                        @if (!hasFirearmSearched)
                        {
                            <MudText Class="pa-4 text-center">Select search criteria and click Search to view firearm records.</MudText>
                        }
                        else
                        {
                            <MudText Class="pa-4 text-center">No firearm records found.</MudText>
                        }
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

@* Add / Edit Dialog for Range Code Tables *@
<MudDialog @bind-Visible="isDialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(isEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(isEditMode ? $"Edit {activeTableTitle}" : $"Add {activeTableTitle}")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="dialogFormModel" OnValidSubmit="SaveCodeTableItemAsync">
            <DataAnnotationsValidator />

            @if (activeTable == "RangeCourse")
            {
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="editingRangeCourse.CourseCode" For="@(() => editingRangeCourse.CourseCode)" Label="Course Code" Variant="Variant.Outlined" Required="true" RequiredError="Course code is required" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int?" @bind-Value="editingRangeCourse.SortOrder" For="@(() => editingRangeCourse.SortOrder)" Label="Sort Order" Variant="Variant.Outlined" Required="true" RequiredError="Sort order is required" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="editingRangeCourse.CourseName" For="@(() => editingRangeCourse.CourseName)" Label="Course Name" Variant="Variant.Outlined" Required="true" RequiredError="Course name is required" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="editingRangeCourse.Notes" Label="Notes" Variant="Variant.Outlined" Lines="3" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox T="bool" @bind-Value="editingRangeCourse.IsActive" Label="Active Course" Color="Color.Success" />
                    </MudItem>
                </MudGrid>
            }
            else if (activeTable == "RangeOfficer")
            {
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="editingRangeOfficer.OfficerName" For="@(() => editingRangeOfficer.OfficerName)" Label="Officer Name" Variant="Variant.Outlined" Required="true" RequiredError="Officer name is required" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox T="bool" @bind-Value="editingRangeOfficer.IsActive" Label="Active Range Officer" Color="Color.Success" />
                    </MudItem>
                </MudGrid>
            }
            else if (activeTable == "RangeSkill")
            {
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="editingRangeSkill.SkillName" For="@(() => editingRangeSkill.SkillName)" Label="Skill Name" Variant="Variant.Outlined" Required="true" RequiredError="Skill name is required" />
                    </MudItem>
                </MudGrid>
            }
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCodeTableItemAsync" Disabled="@isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* Delete Confirmation Dialog for Range Code Tables *@
<MudDialog @bind-Visible="isDeleteDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">Confirm Delete</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete @deleteTableTitle <b>@deleteItemDisplay</b>?</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
            Note: If this record is referenced by existing personnel, inventory, range, or training records, deletion will be prevented.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => isDeleteDialogVisible = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteCodeTableItemAsync" Disabled="@isDeleting">
            @if (isDeleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Deleting...</span>
            }
            else
            {
                <span>Delete</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool isLoading = true;
    private string? errorMessage;

    // Range Statistics tab state
    private List<RangeStatisticDTO> rangeStats = new();
    private int? selectedCourseId;
    private int? selectedEmployeeStatusId;
    private int? selectedProgramId;
    private IReadOnlyCollection<int> selectedUnitIds = new List<int>();
    private DateTime? startDate;
    private DateTime? endDate;
    private string? selectedPassFailFilter;
    private bool isMissingChecked = false;
    private bool hasRangeStatsSearched = false;
    private bool isRangeStatsLoading = false;

    private void OnUnitSelectionChanged(IEnumerable<int> values)
    {
        selectedUnitIds = values != null ? values.ToList() : new List<int>();
    }

    private string GetUnitSelectionSummary(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any())
        {
            return "All Units";
        }
        if (selectedValues.Count == 1)
        {
            return selectedValues[0];
        }
        return $"{selectedValues.Count} Units Selected";
    }

    // Available lookup lists for filters
    private List<StatusesDto> availableStatuses = new();
    private List<ProgramsDto> availablePrograms = new();
    private List<UnitsDto> availableUnits = new();
    private List<MakesDto> availableMakes = new();

    // Code table collections for Range tabs
    private List<RangeCourseDTO> rangeCourses = new();
    private List<RangeOfficerDTO> rangeOfficers = new();
    private List<RangeSkillDTO> rangeSkills = new();

    // Firearm Search tab state
    private List<FirearmsDto> firearms = new();
    private int? selectedFirearmMakeId;
    private int? selectedFirearmEmployeeStatusId;
    private string searchModelNumber = string.Empty;
    private string searchSerialNumber = string.Empty;
    private bool hasFirearmSearched = false;
    private bool isFirearmsLoading = false;

    // Code table search strings
    private string searchRangeCourse = string.Empty;
    private bool rangeCourseActiveOnly = true;
    private string searchRangeOfficer = string.Empty;
    private bool rangeOfficerActiveOnly = true;
    private string searchRangeSkill = string.Empty;

    // Filtered collections
    private IEnumerable<RangeStatisticDTO> FilteredRangeStats =>
        !hasRangeStatsSearched
            ? Enumerable.Empty<RangeStatisticDTO>()
            : (isMissingChecked
                ? rangeStats
                : rangeStats.Where(stat =>
                {
                    if (selectedCourseId.HasValue && selectedCourseId.Value > 0)
                    {
                        var targetCourse = rangeCourses.FirstOrDefault(c => c.CourseID == selectedCourseId.Value);
                        if (!IsCourseMatch(stat, selectedCourseId.Value, targetCourse)) return false;
                    }

                    if (selectedEmployeeStatusId.HasValue && selectedEmployeeStatusId.Value > 0)
                    {
                        var targetStatus = availableStatuses.FirstOrDefault(s => s.StatusID == selectedEmployeeStatusId.Value);
                        bool matchesId = stat.EmployeeStatusID == selectedEmployeeStatusId.Value;
                        bool matchesText = targetStatus != null && !string.IsNullOrEmpty(stat.EmployeeStatus) &&
                                           (stat.EmployeeStatus.Equals(targetStatus.StatusDescription, StringComparison.OrdinalIgnoreCase) ||
                                            stat.EmployeeStatus.Equals(targetStatus.StatusCode, StringComparison.OrdinalIgnoreCase));
                        if (!matchesId && !matchesText) return false;
                    }

                    if (selectedProgramId.HasValue && selectedProgramId.Value > 0)
                    {
                        var targetProg = availablePrograms.FirstOrDefault(p => p.ProgramID == selectedProgramId.Value);
                        bool matchesId = stat.ProgramID == selectedProgramId.Value;
                        bool matchesText = targetProg != null && !string.IsNullOrEmpty(stat.Program) &&
                                           stat.Program.Equals(targetProg.ProgramName, StringComparison.OrdinalIgnoreCase);
                        if (!matchesId && !matchesText) return false;
                    }

                    if (selectedUnitIds != null && selectedUnitIds.Any())
                    {
                        var targetUnits = availableUnits.Where(u => selectedUnitIds != null && selectedUnitIds.Contains(u.UnitID)).ToList();
                        bool matchesId = stat.UnitID.HasValue && selectedUnitIds.Contains(stat.UnitID.Value);
                        bool matchesText = targetUnits.Any(u => !string.IsNullOrEmpty(stat.Unit) &&
                                                                stat.Unit.Equals(u.UnitName, StringComparison.OrdinalIgnoreCase));
                        if (!matchesId && !matchesText) return false;
                    }

                    if (startDate.HasValue)
                    {
                        var start = DateOnly.FromDateTime(startDate.Value);
                        if (!stat.RangeDate.HasValue || stat.RangeDate.Value < start) return false;
                    }

                    if (endDate.HasValue)
                    {
                        var end = DateOnly.FromDateTime(endDate.Value);
                        if (!stat.RangeDate.HasValue || stat.RangeDate.Value > end) return false;
                    }

                    if (!string.IsNullOrEmpty(selectedPassFailFilter))
                    {
                        bool isPassFilter = string.Equals(selectedPassFailFilter, "Pass", StringComparison.OrdinalIgnoreCase) || string.Equals(selectedPassFailFilter, "P", StringComparison.OrdinalIgnoreCase);
                        bool isFailFilter = string.Equals(selectedPassFailFilter, "Fail", StringComparison.OrdinalIgnoreCase) || string.Equals(selectedPassFailFilter, "F", StringComparison.OrdinalIgnoreCase);

                        if (isPassFilter)
                        {
                            if (!string.Equals(stat.PassFail, "Pass", StringComparison.OrdinalIgnoreCase) && !string.Equals(stat.PassFail, "P", StringComparison.OrdinalIgnoreCase)) return false;
                        }
                        else if (isFailFilter)
                        {
                            if (!string.Equals(stat.PassFail, "Fail", StringComparison.OrdinalIgnoreCase) && !string.Equals(stat.PassFail, "F", StringComparison.OrdinalIgnoreCase)) return false;
                        }
                        else if (!string.Equals(stat.PassFail, selectedPassFailFilter, StringComparison.OrdinalIgnoreCase)) return false;
                    }

                    return true;
                }).DistinctBy(x => x.RangeID));

    private async Task PerformRangeStatsSearch()
    {
        errorMessage = null;

        if (isMissingChecked)
        {
            bool hasStatus = selectedEmployeeStatusId.HasValue && selectedEmployeeStatusId.Value > 0;
            bool hasUnit = selectedUnitIds != null && selectedUnitIds.Any();
            bool hasCourse = selectedCourseId.HasValue && selectedCourseId.Value > 0;

            if (!hasStatus || !hasUnit || !hasCourse)
            {
                Snackbar.Add("Employee Status, Unit, and Course must be selected when 'Missing?' is checked.", Severity.Warning);
                return;
            }
        }

        isRangeStatsLoading = true;
        try
        {
            if (isMissingChecked)
            {
                var employees = (await service.SearchEmployeesAsync(new EmployeeSearchRequestDto()))
                    .DistinctBy(e => e.EmployeeID)
                    .ToList();
                var allStats = (await service.GetAllRangeStatisticsAsync()).ToList();

                var targetStatus = selectedEmployeeStatusId.HasValue ? availableStatuses.FirstOrDefault(s => s.StatusID == selectedEmployeeStatusId.Value) : null;
                var targetProgram = selectedProgramId.HasValue && selectedProgramId.Value > 0
                    ? availablePrograms.FirstOrDefault(p => p.ProgramID == selectedProgramId.Value)
                    : null;
                var targetUnits = availableUnits.Where(u => selectedUnitIds != null && selectedUnitIds.Contains(u.UnitID)).ToList();
                var targetCourse = selectedCourseId.HasValue ? rangeCourses.FirstOrDefault(c => c.CourseID == selectedCourseId.Value) : null;

                var missingStatsList = new List<RangeStatisticDTO>();

                foreach (var emp in employees)
                {
                    if (targetStatus != null)
                    {
                        bool statusMatches = !string.IsNullOrWhiteSpace(emp.Status) &&
                            (string.Equals(emp.Status, targetStatus.StatusDescription, StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(emp.Status, targetStatus.StatusCode, StringComparison.OrdinalIgnoreCase));

                        if (!statusMatches) continue;
                    }

                    if (targetProgram != null)
                    {
                        bool programMatches = !string.IsNullOrWhiteSpace(emp.Program) &&
                            (string.Equals(emp.Program, targetProgram.ProgramName, StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(emp.Program, targetProgram.DisplayName, StringComparison.OrdinalIgnoreCase));
                        if (!programMatches) continue;
                    }

                    if (targetUnits.Any())
                    {
                        bool unitMatches = targetUnits.Any(u => !string.IsNullOrWhiteSpace(emp.Unit) &&
                            string.Equals(emp.Unit, u.UnitName, StringComparison.OrdinalIgnoreCase));

                        if (!unitMatches) continue;
                    }

                    bool hasRecord = allStats.Any(stat =>
                    {
                        if (stat.EmployeeID != emp.EmployeeID) return false;
                        if (selectedCourseId.HasValue && selectedCourseId.Value > 0)
                        {
                            if (!IsCourseMatch(stat, selectedCourseId.Value, targetCourse)) return false;
                        }

                        if (startDate.HasValue)
                        {
                            var start = DateOnly.FromDateTime(startDate.Value);
                            if (!stat.RangeDate.HasValue || stat.RangeDate.Value < start) return false;
                        }

                        if (endDate.HasValue)
                        {
                            var end = DateOnly.FromDateTime(endDate.Value);
                            if (!stat.RangeDate.HasValue || stat.RangeDate.Value > end) return false;
                        }

                        if (!string.IsNullOrEmpty(selectedPassFailFilter))
                        {
                            bool isPassFilter = string.Equals(selectedPassFailFilter, "Pass", StringComparison.OrdinalIgnoreCase) || string.Equals(selectedPassFailFilter, "P", StringComparison.OrdinalIgnoreCase);
                            bool isFailFilter = string.Equals(selectedPassFailFilter, "Fail", StringComparison.OrdinalIgnoreCase) || string.Equals(selectedPassFailFilter, "F", StringComparison.OrdinalIgnoreCase);

                            if (isPassFilter)
                            {
                                if (!string.Equals(stat.PassFail, "Pass", StringComparison.OrdinalIgnoreCase) && !string.Equals(stat.PassFail, "P", StringComparison.OrdinalIgnoreCase)) return false;
                            }
                            else if (isFailFilter)
                            {
                                if (!string.Equals(stat.PassFail, "Fail", StringComparison.OrdinalIgnoreCase) && !string.Equals(stat.PassFail, "F", StringComparison.OrdinalIgnoreCase)) return false;
                            }
                            else if (!string.Equals(stat.PassFail, selectedPassFailFilter, StringComparison.OrdinalIgnoreCase)) return false;
                        }

                        return true;
                    });

                    if (!hasRecord)
                    {
                        missingStatsList.Add(new RangeStatisticDTO
                        {
                            RangeID = 0,
                            EmployeeID = emp.EmployeeID,
                            EmployeeName = emp.FormattedName,
                            EmployeeStatus = emp.Status,
                            Program = emp.Program,
                            Unit = emp.Unit,
                            CourseID = selectedCourseId ?? 0,
                            CourseCode = targetCourse?.CourseCode,
                            CourseName = targetCourse?.CourseName,
                            RangeDate = null,
                            PassFail = null,
                            SerialNumber = null
                        });
                    }
                }

                rangeStats = missingStatsList;
                hasRangeStatsSearched = true;
            }
            else
            {
                rangeStats = (await service.GetAllRangeStatisticsAsync()).ToList();
                hasRangeStatsSearched = true;
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error searching range statistics.");
            errorMessage = "Failed to load range statistics.";
        }
        finally
        {
            isRangeStatsLoading = false;
        }
    }

    private void ResetFilters()
    {
        selectedCourseId = null;
        selectedEmployeeStatusId = null;
        selectedProgramId = null;
        selectedUnitIds = new List<int>();
        startDate = null;
        endDate = null;
        selectedPassFailFilter = null;
        isMissingChecked = false;
        hasRangeStatsSearched = false;
        rangeStats.Clear();
    }

    private async Task OnMissingCheckedChanged(bool value)
    {
        isMissingChecked = value;
        if (hasRangeStatsSearched)
        {
            await PerformRangeStatsSearch();
        }
        else
        {
            rangeStats.Clear();
        }
    }

    private bool IsCourseMatch(RangeStatisticDTO stat, int selectedCourseId, RangeCourseDTO? targetCourse)
    {
        if (stat.CourseID == selectedCourseId) return true;

        if (targetCourse != null)
        {
            if (!string.IsNullOrWhiteSpace(targetCourse.CourseCode))
            {
                if (string.Equals(stat.CourseCode, targetCourse.CourseCode, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(stat.CourseName, targetCourse.CourseCode, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
            if (!string.IsNullOrWhiteSpace(targetCourse.CourseName))
            {
                if (string.Equals(stat.CourseCode, targetCourse.CourseName, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(stat.CourseName, targetCourse.CourseName, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
        }

        return false;
    }

    private async Task OpenPrintWindow()
    {
        if (!hasRangeStatsSearched || isRangeStatsLoading) return;

        var queryParams = new List<string>();

        if (selectedCourseId.HasValue && selectedCourseId.Value > 0)
            queryParams.Add($"courseId={selectedCourseId.Value}");

        if (selectedEmployeeStatusId.HasValue && selectedEmployeeStatusId.Value > 0)
            queryParams.Add($"employeeStatusId={selectedEmployeeStatusId.Value}");

        if (selectedProgramId.HasValue && selectedProgramId.Value > 0)
            queryParams.Add($"programId={selectedProgramId.Value}");

        if (selectedUnitIds != null && selectedUnitIds.Any())
            queryParams.Add($"unitIds={string.Join(",", selectedUnitIds)}");

        if (startDate.HasValue)
            queryParams.Add($"startDate={startDate.Value:yyyy-MM-dd}");

        if (endDate.HasValue)
            queryParams.Add($"endDate={endDate.Value:yyyy-MM-dd}");

        if (!string.IsNullOrWhiteSpace(selectedPassFailFilter))
            queryParams.Add($"passFail={Uri.EscapeDataString(selectedPassFailFilter)}");

        if (isMissingChecked)
            queryParams.Add("isMissing=true");

        var queryString = queryParams.Any() ? "?" + string.Join("&", queryParams) : "";
        var printUrl = $"/print/range-statistics{queryString}";

        try
        {
            await JSRuntime.InvokeVoidAsync("open", printUrl, "_blank");
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to open range statistics print window.");
            Snackbar.Add("Could not open print window. Please check browser popup settings.", Severity.Error);
        }
    }

    private IEnumerable<RangeCourseDTO> FilteredRangeCourses =>
        rangeCourses.Where(x => (!rangeCourseActiveOnly || x.IsActive) &&
            (string.IsNullOrWhiteSpace(searchRangeCourse) ||
             (x.CourseCode?.Contains(searchRangeCourse, StringComparison.OrdinalIgnoreCase) ?? false) ||
             x.CourseName.Contains(searchRangeCourse, StringComparison.OrdinalIgnoreCase) ||
             (x.Notes?.Contains(searchRangeCourse, StringComparison.OrdinalIgnoreCase) ?? false)));

    private IEnumerable<RangeOfficerDTO> FilteredRangeOfficers =>
        rangeOfficers.Where(x => (!rangeOfficerActiveOnly || x.IsActive) &&
            (string.IsNullOrWhiteSpace(searchRangeOfficer) ||
             x.OfficerName.Contains(searchRangeOfficer, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<RangeSkillDTO> FilteredRangeSkills =>
        string.IsNullOrWhiteSpace(searchRangeSkill) ? rangeSkills : rangeSkills.Where(x => x.SkillName.Contains(searchRangeSkill, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<FirearmsDto> FilteredFirearmSearchResults =>
        !hasFirearmSearched
            ? Enumerable.Empty<FirearmsDto>()
            : firearms.Where(f =>
            {
                if (selectedFirearmMakeId.HasValue && selectedFirearmMakeId.Value > 0)
                {
                    var targetMake = availableMakes.FirstOrDefault(m => m.MakeID == selectedFirearmMakeId.Value);
                    bool matchesId = f.MakeID == selectedFirearmMakeId.Value;
                    bool matchesText = targetMake != null && !string.IsNullOrEmpty(f.MakeName) &&
                                       f.MakeName.Equals(targetMake.MakeName, StringComparison.OrdinalIgnoreCase);
                    if (!matchesId && !matchesText) return false;
                }

                if (selectedFirearmEmployeeStatusId.HasValue && selectedFirearmEmployeeStatusId.Value > 0)
                {
                    var targetStatus = availableStatuses.FirstOrDefault(s => s.StatusID == selectedFirearmEmployeeStatusId.Value);
                    bool matchesId = f.EmployeeStatusID == selectedFirearmEmployeeStatusId.Value;
                    bool matchesText = targetStatus != null && !string.IsNullOrEmpty(f.EmployeeStatus) &&
                                       (f.EmployeeStatus.Equals(targetStatus.StatusDescription, StringComparison.OrdinalIgnoreCase) ||
                                        f.EmployeeStatus.Equals(targetStatus.StatusCode, StringComparison.OrdinalIgnoreCase));
                    if (!matchesId && !matchesText) return false;
                }

                if (!string.IsNullOrWhiteSpace(searchModelNumber))
                {
                    if (string.IsNullOrEmpty(f.ModelNumber) || !f.ModelNumber.Contains(searchModelNumber, StringComparison.OrdinalIgnoreCase))
                        return false;
                }

                if (!string.IsNullOrWhiteSpace(searchSerialNumber))
                {
                    if (string.IsNullOrEmpty(f.SerialNumber) || !f.SerialNumber.Contains(searchSerialNumber, StringComparison.OrdinalIgnoreCase))
                        return false;
                }

                return true;
            });

    private async Task PerformFirearmSearch()
    {
        isFirearmsLoading = true;
        try
        {
            firearms = (await service.GetAllFirearmsAsync()).ToList();
            hasFirearmSearched = true;
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error searching firearms.");
            errorMessage = "Failed to load firearm search data.";
        }
        finally
        {
            isFirearmsLoading = false;
        }
    }

    private void ResetFirearmFilters()
    {
        selectedFirearmMakeId = null;
        selectedFirearmEmployeeStatusId = null;
        searchModelNumber = string.Empty;
        searchSerialNumber = string.Empty;
        hasFirearmSearched = false;
    }

    // Dialog state for code tables
    private bool isDialogVisible = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private string activeTable = "";
    private string activeTableTitle = "";
    private object dialogFormModel = new();
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    // Form Models
    private RangeCourseDTO editingRangeCourse = new();
    private RangeOfficerDTO editingRangeOfficer = new();
    private RangeSkillDTO editingRangeSkill = new();

    // Delete dialog state for code tables
    private bool isDeleteDialogVisible = false;
    private bool isDeleting = false;
    private string deleteTable = "";
    private string deleteTableTitle = "";
    private int deleteItemId = 0;
    private string deleteItemDisplay = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var taskRangeCourses = CodeTableService.GetRangeCoursesAsync();
            var taskRangeOfficers = CodeTableService.GetRangeOfficersAsync();
            var taskRangeSkills = CodeTableService.GetRangeSkillsAsync();
            var taskStatuses = CodeTableService.GetStatusesAsync();
            var taskPrograms = CodeTableService.GetProgramsAsync();
            var taskUnits = CodeTableService.GetUnitsAsync();
            var taskMakes = CodeTableService.GetMakesAsync();

            Task<IEnumerable<RangeStatisticDTO>>? taskRangeStats = hasRangeStatsSearched ? service.GetAllRangeStatisticsAsync() : null;
            Task<IEnumerable<FirearmsDto>>? taskFirearms = hasFirearmSearched ? service.GetAllFirearmsAsync() : null;

            try { rangeCourses = (await taskRangeCourses).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading range courses."); }
            try { rangeOfficers = (await taskRangeOfficers).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading range officers."); }
            try { rangeSkills = (await taskRangeSkills).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading range skills."); }
            try { availableStatuses = (await taskStatuses).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading statuses."); }
            try { availablePrograms = (await taskPrograms).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading programs."); }
            try { availableUnits = (await taskUnits).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading units."); }
            try { availableMakes = (await taskMakes).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading makes."); }

            if (taskRangeStats != null)
            {
                try { rangeStats = (await taskRangeStats).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading range statistics."); errorMessage = "Failed to load range statistics."; }
            }
            if (taskFirearms != null)
            {
                try { firearms = (await taskFirearms).ToList(); } catch (Exception ex) { logger.LogError(ex, "Error loading firearms."); }
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to load range data.");
            errorMessage = "Failed to load data. Please try refreshing or check system logs.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewEmployee(int employeeId)
    {
        if (employeeId > 0)
        {
            Navigation.NavigateTo($"/employee/edit/{employeeId}");
        }
    }

    private async Task DeleteRangeStatAsync(int rangeId)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            "Are you sure you want to delete this range statistic record?",
            yesText: "Delete", cancelText: "Cancel");

        if (confirm != true) return;

        try
        {
            var success = await service.DeleteRangeStatisticAsync(rangeId);
            if (success)
            {
                Snackbar.Add("Range statistic deleted successfully!", Severity.Success);
                await LoadAllDataAsync();
            }
            else
            {
                Snackbar.Add("Failed to delete range statistic record.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error deleting range statistic record.");
            Snackbar.Add($"Error deleting range statistic: {ex.Message}", Severity.Error);
        }
    }

