<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["SheriffPersonnel.Web.styles.css"]" />
    <style>
        .skip-link {
            position: absolute;
            top: -100px;
            left: 10px;
            background: #110e2d;
            color: #ffffff;
            padding: 8px 16px;
            z-index: 9999;
            transition: top 0.2s ease;
            font-weight: bold;
            border: 2px solid #ffffff;
            border-radius: 4px;
        }

        .skip-link:focus {
            top: 10px;
        }

        .mud-table-head th,
        .mud-table-head .mud-table-cell {
            background-color: var(--mud-palette-primary) !important;
            color: var(--mud-palette-primary-text, #ffffff) !important;
            font-weight: 700 !important;
            font-size: 0.875rem !important;
            line-height: 1.5 !important;
            vertical-align: middle !important;
        }

        .mud-table-head .mud-button-root,
        .mud-table-head .mud-table-sort-label,
        .mud-table-head .mud-table-sort-label .mud-button-root,
        .mud-table-head .mud-table-sort-label .mud-button-label,
        .mud-table-head .mud-icon-root,
        .mud-table-head .mud-svg-icon {
            color: var(--mud-palette-primary-text, #ffffff) !important;
            font-weight: 700 !important;
            font-size: 0.875rem !important;
            line-height: 1.5 !important;
            fill: var(--mud-palette-primary-text, #ffffff) !important;
        }

        .mud-table-head .mud-table-sort-label:hover,
        .mud-table-head .mud-button-root:hover {
            color: var(--mud-palette-primary-text, #ffffff) !important;
            background-color: transparent !important;
        }

        .mud-table-root tr, .mud-input-control {
            scroll-margin-bottom: 120px;
            scroll-margin-top: 80px;
        }
    </style>
    <ImportMap />
    <link rel="icon" type="image/ico" href="favicon.ico" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script>
        window.downloadFileFromByteArray = (fileName, base64String, contentType) => {
            const link = document.createElement('a');
            link.download = fileName;
            link.href = `data:${contentType};base64,${base64String}`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        // Scroll focused elements into view above sticky bottom action bar
        document.addEventListener('focusin', function (e) {
            var elem = e.target;
            if (elem && typeof elem.getBoundingClientRect === 'function') {
                setTimeout(function () {
                    var rect = elem.getBoundingClientRect();
                    var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
                    // If bottom of focused element is within 120px of bottom of viewport
                    if (rect.bottom > (viewportHeight - 120)) {
                        elem.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'smooth' });
                    }
                }, 50);
            }
        }, true);

        // Global hotkey 'Alt+N' for setting date picker fields to the current date (excluding birth date fields)
        document.addEventListener('keydown', function (e) {
            if (e.altKey && (e.key === 'n' || e.key === 'N') && !e.ctrlKey && !e.metaKey) {
                var target = e.target;
                if (!target || target.tagName !== 'INPUT') return;

                // Verify this input is strictly a date picker field
                var isMudPicker = target.closest('.mud-picker, .mud-picker-input-text, .mud-picker-input, .mud-picker-inline, .mud-date-picker') !== null;
                var inputTypeDate = target.getAttribute('type') === 'date' || target.getAttribute('type') === 'datetime-local';
                var hasExplicitDateAttr = target.hasAttribute('data-is-date') || (target.parentElement && target.parentElement.hasAttribute('data-is-date'));

                if (!isMudPicker && !inputTypeDate && !hasExplicitDateAttr) return;

                // Find associated container for label checking
                var pickerContainer = target.closest('.mud-picker, .mud-picker-input-text, .mud-picker-input, .mud-picker-inline, .mud-date-picker, .mud-input-control') || target.parentElement;

                // Check if this date field is Date of Birth / DOB (EXCLUDED)
                var label = pickerContainer ? pickerContainer.querySelector('label, .mud-input-label') : null;
                var labelText = (label ? label.innerText : '').toLowerCase();
                var placeholderText = (target.getAttribute('placeholder') || '').toLowerCase();
                var ariaLabel = (target.getAttribute('aria-label') || '').toLowerCase();

                var isBirthDate = labelText.includes('birth') || labelText.includes('dob') ||
                                    placeholderText.includes('birth') || placeholderText.includes('dob') ||
                                    ariaLabel.includes('birth') || ariaLabel.includes('dob') ||
                                    target.hasAttribute('data-no-today-hotkey') ||
                                    (pickerContainer && pickerContainer.hasAttribute('data-no-today-hotkey'));

                if (isBirthDate) return;

                // Prevent typing 'n' / 'N' into the input box
                e.preventDefault();

                // Format current local date as MM/dd/yyyy
                var today = new Date();
                var month = String(today.getMonth() + 1).padStart(2, '0');
                var day = String(today.getDate()).padStart(2, '0');
                var year = today.getFullYear();
                var formattedDate = month + '/' + day + '/' + year;

                // Set value via native setter so framework binding detects changes
                var nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
                if (nativeSetter) {
                    nativeSetter.call(target, formattedDate);
                } else {
                    target.value = formattedDate;
                }

                // Dispatch DOM events so MudBlazor updates the bound C# property
                target.dispatchEvent(new Event('input', { bubbles: true }));
                target.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }, true);

        // Prevent Enter key in date picker fields from opening the calendar popover dialog
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === 'NumpadEnter') {
                var target = e.target;
                if (!target || target.tagName !== 'INPUT') return;

                var isMudPicker = target.closest('.mud-picker, .mud-picker-input-text, .mud-picker-input, .mud-picker-inline, .mud-date-picker') !== null;
                var inputTypeDate = target.getAttribute('type') === 'date' || target.getAttribute('type') === 'datetime-local';
                var hasExplicitDateAttr = target.hasAttribute('data-is-date') || (target.parentElement && target.parentElement.hasAttribute('data-is-date'));

                if (isMudPicker || inputTypeDate || hasExplicitDateAttr) {
                    // Commit any typed date text to ensure binding
                    target.dispatchEvent(new Event('change', { bubbles: true }));
                    target.blur();

                    // Close any calendar popover that might be toggled
                    setTimeout(function () {
                        var openPopovers = document.querySelectorAll('.mud-popover.mud-popover-open, .mud-picker-popover');
                        openPopovers.forEach(function (pop) {
                            if (pop.querySelector('.mud-picker-calendar, .mud-picker-container, .mud-date-picker')) {
                                pop.classList.remove('mud-popover-open');
                            }
                        });
                    }, 50);
                }
            }
        }, true);
    </script>
</body>

</html>
